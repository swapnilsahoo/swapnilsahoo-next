# Learning Lab configuration. Never place secrets in NEXT_PUBLIC_* variables.
# LOCAL PREVIEW ONLY: production must use a persistent remote database and HTTPS.
LAB_LOCAL_MODE=true
LAB_BASE_URL=http://localhost:3110
LAB_DATABASE_URL=file:.data/learning-lab.db
# For a managed libSQL database, use libsql://... and its server-side token.
LAB_DATABASE_AUTH_TOKEN=
# Set a random secret of at least 32 characters for deployment; local mode generates one.
LAB_AUTH_SECRET=

# Explicit public-launch gate. Leave false until operator details and drafts are approved.
LAB_LAUNCH_APPROVED=false
LAB_BUSINESS_EMAIL=swapnil.s@greatlakes.edu.in
LAB_BUSINESS_ADDRESS=
LAB_OPERATOR_NAME=
# Hosted payments, external email and analytics require separate configuration.

# One-time admin provisioning, supplied privately; do not commit actual values.
LAB_ADMIN_EMAIL=
LAB_ADMIN_NAME=Learning Lab administrator
LAB_ADMIN_PASSWORD=
# Synthetic demo setup, local only. Choose a strong password privately.
LAB_DEMO_PASSWORD=

# Optional real-time AI video guide. Leave disabled until the owner approves the
# provider account, completed Face, reviewed PAL, likeness/voice use and spending.
# All settings below stay server-side. Rebuild after changing readiness settings.
DIGITAL_AVATAR_ENABLED=false
# Section's Superhuman-style provider. Supply your OWN provider-issued public
# embed/share URL, never another website's deployment or a private API key.
DIGITAL_AVATAR_PROVIDER=1mind
ONEMIND_EMBED_URL=
# True only after your own avatar, knowledge, light theme, privacy/retention,
# allowed domains and provider-side spending/session limits have been tested.
ONEMIND_DEPLOYMENT_APPROVED=false
# Alternative provider below: select DIGITAL_AVATAR_PROVIDER=tavus to use it.
DIGITAL_AVATAR_BASE_URL=https://www.swapnilsahoo.com
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_PAL_ID=
# Independent random secret, at least 32 characters; never reuse a public token.
DIGITAL_AVATAR_SESSION_SECRET=
# Required explicit budget gate, 1–100 creation attempts per UTC day. No default.
# Each accepted attempt may consume up to five minutes. Provider billing applies.
DIGITAL_AVATAR_DAILY_SESSION_LIMIT=
# Production also requires the persistent remote LAB_DATABASE_URL and its token.
# Explicit LAB_LOCAL_MODE=true + file: storage is supported only off Vercel.
