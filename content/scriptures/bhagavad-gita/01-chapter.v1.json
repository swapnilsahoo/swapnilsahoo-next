{
  "schemaVersion": 1,
  "corpusVersion": "1.0.0",
  "work": "Śrīmadbhagavadgītā",
  "chapter": {
    "number": 1,
    "titleEnglish": "Arjuna's Despondency",
    "sourcePage": "भगवद्गीता/अर्जुनविषादयोगः"
  },
  "source": {
    "project": "Sanskrit Wikisource",
    "pageid": 164,
    "revid": 343151,
    "parentid": 343150,
    "timestamp": "2022-08-10T14:13:52Z",
    "sha1": "d8b9072efcaa652161ddea78bc5160cd958c89d7",
    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%AD%E0%A4%97%E0%A4%B5%E0%A4%A6%E0%A5%8D%E0%A4%97%E0%A5%80%E0%A4%A4%E0%A4%BE%2F%E0%A4%85%E0%A4%B0%E0%A5%8D%E0%A4%9C%E0%A5%81%E0%A4%A8%E0%A4%B5%E0%A4%BF%E0%A4%B7%E0%A4%BE%E0%A4%A6%E0%A4%AF%E0%A5%8B%E0%A4%97%E0%A4%83&oldid=343151",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "gita-1-1",
      "sequence": 1,
      "chapter": 1,
      "verse": 1,
      "sourceVerse": 1,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.1",
      "original": "प्रथमोऽध्यायः\nधर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः ।\nमामकाः पाण्डवाश्चैव किमकुर्वत संजय",
      "speaker": "धृतराष्ट्र उवाच"
    },
    {
      "id": "gita-1-2",
      "sequence": 2,
      "chapter": 1,
      "verse": 2,
      "sourceVerse": 2,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.2",
      "original": "दृष्ट्वा तु पाण्डवानीकं व्यूढं दुर्योधनस्तदा ।\nआचार्यमुपसंगम्य राजा वचनमब्रवीत्",
      "speaker": "सञ्जय उवाच"
    },
    {
      "id": "gita-1-3",
      "sequence": 3,
      "chapter": 1,
      "verse": 3,
      "sourceVerse": 3,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.3",
      "original": "पश्यैतां पाण्डुपुत्राणामाचार्य महतीं चमूम् ।\nव्यूढां द्रुपदपुत्रेण तव शिष्येण धीमता"
    },
    {
      "id": "gita-1-4",
      "sequence": 4,
      "chapter": 1,
      "verse": 4,
      "sourceVerse": 4,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.4",
      "original": "अत्र शूरा महेष्वासा भीमार्जुनसमा युधि ।\nयुयुधानो विराटश्च द्रुपदश्च महारथः"
    },
    {
      "id": "gita-1-5",
      "sequence": 5,
      "chapter": 1,
      "verse": 5,
      "sourceVerse": 5,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.5",
      "original": "धृष्टकेतुश्चेकितानः काशिराजश्च वीर्यवान् ।\nपुरुजित्कुन्तिभोजश्च शैब्यश्च नरपुङ्गवः"
    },
    {
      "id": "gita-1-6",
      "sequence": 6,
      "chapter": 1,
      "verse": 6,
      "sourceVerse": 6,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.6",
      "original": "युधामन्युश्च विक्रान्त उत्तमौजाश्च वीर्यवान् ।\nसौभद्रो द्रौपदेयाश्च सर्व एव महारथाः"
    },
    {
      "id": "gita-1-7",
      "sequence": 7,
      "chapter": 1,
      "verse": 7,
      "sourceVerse": 7,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.7",
      "original": "अस्माकं तु विशिष्टा ये तान्निबोध द्विजोत्तम ।\nनायका मम सैन्यस्य संज्ञार्थं तान्ब्रवीमि ते"
    },
    {
      "id": "gita-1-8",
      "sequence": 8,
      "chapter": 1,
      "verse": 8,
      "sourceVerse": 8,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.8",
      "original": "भवान्भीष्मश्च कर्णश्च कृपश्च समितिंजयः ।\nअश्वत्थामा विकर्णश्च सौमदत्तिस्तथैव च"
    },
    {
      "id": "gita-1-9",
      "sequence": 9,
      "chapter": 1,
      "verse": 9,
      "sourceVerse": 9,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.9",
      "original": "अन्ये च बहवः शूरा मदर्थे त्यक्तजीविताः ।\nनानाशस्त्रप्रहरणाः सर्वे युद्धविशारदाः"
    },
    {
      "id": "gita-1-10",
      "sequence": 10,
      "chapter": 1,
      "verse": 10,
      "sourceVerse": 10,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.10",
      "original": "अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम् ।\nपर्याप्तं त्विदमेतेषां बलं भीमाभिरक्षितम्"
    },
    {
      "id": "gita-1-11",
      "sequence": 11,
      "chapter": 1,
      "verse": 11,
      "sourceVerse": 11,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.11",
      "original": "अयनेषु च सर्वेषु यथाभागमवस्थिताः ।\nभीष्ममेवाभिरक्षन्तु भवन्तः सर्व एव हि"
    },
    {
      "id": "gita-1-12",
      "sequence": 12,
      "chapter": 1,
      "verse": 12,
      "sourceVerse": 12,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.12",
      "original": "तस्य संजनयन्हर्षं कुरुवृद्धः पितामहः ।\nसिंहनादं विनद्योच्चैः शङ्खं दध्मौ प्रतापवान्"
    },
    {
      "id": "gita-1-13",
      "sequence": 13,
      "chapter": 1,
      "verse": 13,
      "sourceVerse": 13,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.13",
      "original": "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः ।\nसहसैवाभ्यहन्यन्त स शब्दस्तुमुलोऽभवत्"
    },
    {
      "id": "gita-1-14",
      "sequence": 14,
      "chapter": 1,
      "verse": 14,
      "sourceVerse": 14,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.14",
      "original": "ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ ।\nमाधवः पाण्डवश्चैव दिव्यौ शङ्खौ प्रदध्मतुः"
    },
    {
      "id": "gita-1-15",
      "sequence": 15,
      "chapter": 1,
      "verse": 15,
      "sourceVerse": 15,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.15",
      "original": "पाञ्चजन्यं हृषीकेशो देवदत्तं धनञ्जयः ।\nपौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः"
    },
    {
      "id": "gita-1-16",
      "sequence": 16,
      "chapter": 1,
      "verse": 16,
      "sourceVerse": 16,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.16",
      "original": "अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः ।\nनकुलः सहदेवश्च सुघोषमणिपुष्पकौ"
    },
    {
      "id": "gita-1-17",
      "sequence": 17,
      "chapter": 1,
      "verse": 17,
      "sourceVerse": 17,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.17",
      "original": "काश्यश्च परमेष्वासः शिखण्डी च महारथः ।\nधृष्टद्युम्नो विराटश्च सात्यकिश्चापराजितः"
    },
    {
      "id": "gita-1-18",
      "sequence": 18,
      "chapter": 1,
      "verse": 18,
      "sourceVerse": 18,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.18",
      "original": "द्रुपदो द्रौपदेयाश्च सर्वशः पृथिवीपते ।\nसौभद्रश्च महाबाहुः शङ्खान्दध्मुः पृथक्पृथक्"
    },
    {
      "id": "gita-1-19",
      "sequence": 19,
      "chapter": 1,
      "verse": 19,
      "sourceVerse": 19,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.19",
      "original": "स घोषो धार्तराष्ट्राणां हृदयानि व्यदारयत् ।\nनभश्च पृथिवीं चैव तुमुलो व्यनुनादयन्"
    },
    {
      "id": "gita-1-20",
      "sequence": 20,
      "chapter": 1,
      "verse": 20,
      "sourceVerse": 20,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.20",
      "original": "अथ व्यवस्थितान्दृष्ट्वा धार्तराष्ट्रान्कपिध्वजः ।\nप्रवृत्ते शस्त्रसंपाते धनुरुद्यम्य पाण्डवः"
    },
    {
      "id": "gita-1-21",
      "sequence": 21,
      "chapter": 1,
      "verse": 21,
      "sourceVerse": 21,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.21",
      "original": "हृषीकेशं तदा वाक्यमिदमाह महीपते ।\nसेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-1-22",
      "sequence": 22,
      "chapter": 1,
      "verse": 22,
      "sourceVerse": 22,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.22",
      "original": "यावदेतान्निरिक्षेऽहं योद्‌धुकामानवस्थितान् ।\nकैर्मया सह योद्धव्यमस्मिन् रणसमुद्यमे"
    },
    {
      "id": "gita-1-23",
      "sequence": 23,
      "chapter": 1,
      "verse": 23,
      "sourceVerse": 23,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.23",
      "original": "योत्स्यमानानवेक्षेऽहं य एतेऽत्र समागताः ।\nधार्तराष्ट्रस्य दुर्बुद्धेर्युद्धे प्रियचिकीर्षवः"
    },
    {
      "id": "gita-1-24",
      "sequence": 24,
      "chapter": 1,
      "verse": 24,
      "sourceVerse": 24,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.24",
      "original": "एवमुक्तो हृषीकेशो गुडाकेशेन भारत ।\nसेनयोरुभयोर्मध्ये स्थापयित्वा रथोत्तमम्",
      "speaker": "सञ्जय उवाच"
    },
    {
      "id": "gita-1-25",
      "sequence": 25,
      "chapter": 1,
      "verse": 25,
      "sourceVerse": 25,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.25",
      "original": "भीष्मद्रोणप्रमुखतः सर्वेषां च महीक्षिताम् ।\nउवाच पार्थ पश्यैतान्समवेतान्कुरूनिति"
    },
    {
      "id": "gita-1-26",
      "sequence": 26,
      "chapter": 1,
      "verse": 26,
      "sourceVerse": 26,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.26",
      "original": "तत्रापश्यत्स्थितान्पार्थः पितॄनथ पितामहान् ।\nआचार्यान्मातुलान्भ्रातॄन्पुत्रान्पौत्रान्सखींस्तथा"
    },
    {
      "id": "gita-1-27",
      "sequence": 27,
      "chapter": 1,
      "verse": 27,
      "sourceVerse": 27,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.27",
      "original": "श्वशुरान्सुहृदश्चैव सेनयोरुभयोरपि ।\nतान्समीक्ष्य स कौन्तेयः सर्वान्बन्धूनवस्थितान्"
    },
    {
      "id": "gita-1-28",
      "sequence": 28,
      "chapter": 1,
      "verse": 28,
      "sourceVerse": 28,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.28",
      "original": "कृपया परयाविष्टो विषीदन्निदमब्रवीत् ।\nदृष्ट्वेमं स्वजनं कृष्ण युयुत्सुं समुपस्थितम्",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-1-29",
      "sequence": 29,
      "chapter": 1,
      "verse": 29,
      "sourceVerse": 29,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.29",
      "original": "सीदन्ति मम गात्राणि मुखं च परिशुष्यति ।\nवेपथुश्च शरीरे मे रोमहर्षश्च जायते"
    },
    {
      "id": "gita-1-30",
      "sequence": 30,
      "chapter": 1,
      "verse": 30,
      "sourceVerse": 30,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.30",
      "original": "गाण्डीवं स्रंसते हस्तात्त्वक्चैव परिदह्यते ।\nन च शक्नोम्यवस्थातुं भ्रमतीव च मे मनः"
    },
    {
      "id": "gita-1-31",
      "sequence": 31,
      "chapter": 1,
      "verse": 31,
      "sourceVerse": 31,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.31",
      "original": "निमित्तानि च पश्यामि विपरीतानि केशव ।\nन च श्रेयोऽनुपश्यामि हत्वा स्वजनमाहवे"
    },
    {
      "id": "gita-1-32",
      "sequence": 32,
      "chapter": 1,
      "verse": 32,
      "sourceVerse": 32,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.32",
      "original": "न काङ्क्षे विजयं कृष्ण न च राज्यं सुखानि च ।\nकिं नो राज्येन गोविन्द किं भोगैर्जीवितेन वा"
    },
    {
      "id": "gita-1-33",
      "sequence": 33,
      "chapter": 1,
      "verse": 33,
      "sourceVerse": 33,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.33",
      "original": "येषामर्थे काङ्क्षितं नो राज्यं भोगाः सुखानि च ।\nत इमेऽवस्थिता युद्धे प्राणांस्त्यक्त्वा धनानि च"
    },
    {
      "id": "gita-1-34",
      "sequence": 34,
      "chapter": 1,
      "verse": 34,
      "sourceVerse": 34,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.34",
      "original": "आचार्याः पितरः पुत्रास्तथैव च पितामहाः ।\nमातुलाः श्वशुराः पौत्राः श्यालाः संबन्धिनस्तथा"
    },
    {
      "id": "gita-1-35",
      "sequence": 35,
      "chapter": 1,
      "verse": 35,
      "sourceVerse": 35,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.35",
      "original": "एतान्न हन्तुमिच्छामि घ्नतोऽपि मधुसूदन ।\nअपि त्रैलोक्यराज्यस्य हेतोः किं नु महीकृते"
    },
    {
      "id": "gita-1-36",
      "sequence": 36,
      "chapter": 1,
      "verse": 36,
      "sourceVerse": 36,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.36",
      "original": "निहत्य धार्तराष्ट्रान्नः का प्रीतिः स्याज्जनार्दन ।\nपापमेवाश्रयेदस्मान्हत्वैतानाततायिनः"
    },
    {
      "id": "gita-1-37",
      "sequence": 37,
      "chapter": 1,
      "verse": 37,
      "sourceVerse": 37,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.37",
      "original": "तस्मान्नार्हा वयं हन्तुं धार्तराष्ट्रान्स्वबान्धवान् ।\nस्वजनं हि कथं हत्वा सुखिनः स्याम माधव"
    },
    {
      "id": "gita-1-38",
      "sequence": 38,
      "chapter": 1,
      "verse": 38,
      "sourceVerse": 38,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.38",
      "original": "यद्यप्येते न पश्यन्ति लोभोपहतचेतसः ।\nकुलक्षयकृतं दोषं मित्रद्रोहे च पातकम्"
    },
    {
      "id": "gita-1-39",
      "sequence": 39,
      "chapter": 1,
      "verse": 39,
      "sourceVerse": 39,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.39",
      "original": "कथं न ज्ञेयमस्माभिः पापादस्मान्निवर्तितुम् ।\nकुलक्षयकृतं दोषं प्रपश्यद्भिर्जनार्दन"
    },
    {
      "id": "gita-1-40",
      "sequence": 40,
      "chapter": 1,
      "verse": 40,
      "sourceVerse": 40,
      "section": "Chapter 01 · Arjuna's Despondency",
      "label": "1.40",
      "original": "कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः ।\nधर्मे नष्टे कुलं कृत्स्नमधर्मोऽभिभवत्युत"
    },
    {
      "id": "gita-1-41",
      "sequence": 41,
      "chapter": 1,
      "verse": 41,
      "sourceVerse": 41,
