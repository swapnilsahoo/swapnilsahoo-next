    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%AD%E0%A4%97%E0%A4%B5%E0%A4%A6%E0%A5%8D%E0%A4%97%E0%A5%80%E0%A4%A4%E0%A4%BE%2F%E0%A4%95%E0%A4%B0%E0%A5%8D%E0%A4%AE%E0%A4%AF%E0%A5%8B%E0%A4%97%E0%A4%83&oldid=216838",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "gita-3-1",
      "sequence": 120,
      "chapter": 3,
      "verse": 1,
      "sourceVerse": 1,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.1",
      "original": "ज्यायसी चेत्कर्मणस्ते मता बुद्धिर्जनार्दन ।\nतत्किं कर्मणि घोरे मां नियोजयसि केशव",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-3-2",
      "sequence": 121,
      "chapter": 3,
      "verse": 2,
      "sourceVerse": 2,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.2",
      "original": "व्यामिश्रेणेव वाक्येन बुद्धिं मोहयसीव मे ।\nतदेकं वद निश्चित्य येन श्रेयोऽहमाप्नुयाम्"
    },
    {
      "id": "gita-3-3",
      "sequence": 122,
      "chapter": 3,
      "verse": 3,
      "sourceVerse": 3,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.3",
      "original": "लोकेऽस्मिन्द्विविधा निष्ठा पुरा प्रोक्ता मयानघ ।\nज्ञानयोगेन सांख्यानां कर्मयोगेन योगिनाम्",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-3-4",
      "sequence": 123,
      "chapter": 3,
      "verse": 4,
      "sourceVerse": 4,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.4",
      "original": "न कर्मणामनारम्भान्नैष्कर्म्यं पुरुषोऽश्नुते ।\nन च संन्यसनादेव सिद्धिं समधिगच्छति"
    },
    {
      "id": "gita-3-5",
      "sequence": 124,
      "chapter": 3,
      "verse": 5,
      "sourceVerse": 5,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.5",
      "original": "न हि कश्चित्क्षणमपि जातु तिष्ठत्यकर्मकृत् ।\nकार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः"
    },
    {
      "id": "gita-3-6",
      "sequence": 125,
      "chapter": 3,
      "verse": 6,
      "sourceVerse": 6,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.6",
      "original": "कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन् ।\nइन्द्रियार्थान्विमूढात्मा मिथ्याचारः स उच्यते"
    },
    {
      "id": "gita-3-7",
      "sequence": 126,
      "chapter": 3,
      "verse": 7,
      "sourceVerse": 7,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.7",
      "original": "यस्त्विन्द्रियाणि मनसा नियम्यारभतेऽर्जुन ।\nकर्मेन्द्रियैः कर्मयोगमसक्तः स विशिष्यते"
    },
    {
      "id": "gita-3-8",
      "sequence": 127,
      "chapter": 3,
      "verse": 8,
      "sourceVerse": 8,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.8",
      "original": "नियतं कुरु कर्म त्वं कर्म ज्यायो ह्यकर्मणः ।\nशरीरयात्रापि च ते न प्रसिद्ध्येदकर्मणः"
    },
    {
      "id": "gita-3-9",
      "sequence": 128,
      "chapter": 3,
      "verse": 9,
      "sourceVerse": 9,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.9",
      "original": "यज्ञार्थात्कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः ।\nतदर्थं कर्म कौन्तेय मुक्तसङ्गः समाचर"
    },
    {
      "id": "gita-3-10",
      "sequence": 129,
      "chapter": 3,
      "verse": 10,
      "sourceVerse": 10,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.10",
      "original": "सहयज्ञाः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः ।\nअनेन प्रसविष्यध्वमेष वोऽस्त्विष्टकामधुक्"
    },
    {
      "id": "gita-3-11",
      "sequence": 130,
      "chapter": 3,
      "verse": 11,
      "sourceVerse": 11,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.11",
      "original": "देवान्भावयतानेन ते देवा भावयन्तु वः ।\nपरस्परं भावयन्तः श्रेयः परमवाप्स्यथ"
    },
    {
      "id": "gita-3-12",
      "sequence": 131,
      "chapter": 3,
      "verse": 12,
      "sourceVerse": 12,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.12",
      "original": "इष्टान्भोगान्हि वो देवा दास्यन्ते यज्ञभाविताः ।\nतैर्दत्तानप्रदायैभ्यो यो भुङ्क्ते स्तेन एव सः"
    },
    {
      "id": "gita-3-13",
      "sequence": 132,
      "chapter": 3,
      "verse": 13,
      "sourceVerse": 13,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.13",
      "original": "यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः ।\nभुञ्जते ते त्वघं पापा ये पचन्त्यात्मकारणात्"
    },
    {
      "id": "gita-3-14",
      "sequence": 133,
      "chapter": 3,
      "verse": 14,
      "sourceVerse": 14,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.14",
      "original": "अन्नाद्भवन्ति भूतानि पर्जन्यादन्नसम्भवः ।\nयज्ञाद्भवति पर्जन्यो यज्ञः कर्मसमुद्भवः"
    },
    {
      "id": "gita-3-15",
      "sequence": 134,
      "chapter": 3,
      "verse": 15,
      "sourceVerse": 15,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.15",
      "original": "कर्म ब्रह्मोद्भवं विद्धि ब्रह्माक्षरसमुद्भवम् ।\nतस्मात्सर्वगतं ब्रह्म नित्यं यज्ञे प्रतिष्ठितम्"
    },
    {
      "id": "gita-3-16",
      "sequence": 135,
      "chapter": 3,
      "verse": 16,
      "sourceVerse": 16,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.16",
      "original": "एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः ।\nअघायुरिन्द्रियारामो मोघं पार्थ स जीवति"
    },
    {
      "id": "gita-3-17",
      "sequence": 136,
      "chapter": 3,
      "verse": 17,
      "sourceVerse": 17,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.17",
      "original": "यस्त्वात्मरतिरेव स्यादात्मतृप्तश्च मानवः ।\nआत्मन्येव च सन्तुष्टस्तस्य कार्यं न विद्यते"
    },
    {
      "id": "gita-3-18",
      "sequence": 137,
      "chapter": 3,
      "verse": 18,
      "sourceVerse": 18,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.18",
      "original": "नैव तस्य कृतेनार्थो नाकृतेनेह कश्चन ।\nन चास्य सर्वभूतेषु कश्चिदर्थव्यपाश्रयः"
    },
    {
      "id": "gita-3-19",
      "sequence": 138,
      "chapter": 3,
      "verse": 19,
      "sourceVerse": 19,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.19",
      "original": "तस्मादसक्तः सततं कार्यं कर्म समाचर ।\nअसक्तो ह्याचरन्कर्म परमाप्नोति पूरुषः"
    },
    {
      "id": "gita-3-20",
      "sequence": 139,
      "chapter": 3,
      "verse": 20,
      "sourceVerse": 20,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.20",
      "original": "कर्मणैव हि संसिद्धिमास्थिता जनकादयः ।\nलोकसंग्रहमेवापि संपश्यन्कर्तुमर्हसि"
    },
    {
      "id": "gita-3-21",
      "sequence": 140,
      "chapter": 3,
      "verse": 21,
      "sourceVerse": 21,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.21",
      "original": "यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।\nस यत्प्रमाणं कुरुते लोकस्तदनुवर्तते"
    },
    {
      "id": "gita-3-22",
      "sequence": 141,
      "chapter": 3,
      "verse": 22,
      "sourceVerse": 22,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.22",
      "original": "न मे पार्थास्ति कर्तव्यं त्रिषु लोकेषु किंचन ।\nनानवाप्तमवाप्तव्यं वर्त एव च कर्मणि"
    },
    {
      "id": "gita-3-23",
      "sequence": 142,
      "chapter": 3,
      "verse": 23,
      "sourceVerse": 23,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.23",
      "original": "यदि ह्यहं न वर्तेयं जातु कर्मण्यतन्द्रितः ।\nमम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः"
    },
    {
      "id": "gita-3-24",
      "sequence": 143,
      "chapter": 3,
      "verse": 24,
      "sourceVerse": 24,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.24",
      "original": "उत्सीदेयुरिमे लोका न कुर्यां कर्म चेदहम् ।\nसंकरस्य च कर्ता स्यामुपहन्यामिमाः प्रजाः"
    },
    {
      "id": "gita-3-25",
      "sequence": 144,
      "chapter": 3,
      "verse": 25,
      "sourceVerse": 25,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.25",
      "original": "सक्ताः कर्मण्यविद्वांसो यथा कुर्वन्ति भारत ।\nकुर्याद्विद्वांस्तथासक्तश्चिकीर्षुर्लोकसंग्रहम्"
    },
    {
      "id": "gita-3-26",
      "sequence": 145,
      "chapter": 3,
      "verse": 26,
      "sourceVerse": 26,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.26",
      "original": "न बुद्धिभेदं जनयेदज्ञानां कर्मसङ्गिनाम् ।\nजोषयेत्सर्वकर्माणि विद्वान्युक्तः समाचरन्"
    },
    {
      "id": "gita-3-27",
      "sequence": 146,
      "chapter": 3,
      "verse": 27,
      "sourceVerse": 27,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.27",
      "original": "प्रकृतेः क्रियमाणानि गुणैः कर्माणि सर्वशः ।\nअहंकारविमूढात्मा कर्ताहमिति मन्यते"
    },
    {
      "id": "gita-3-28",
      "sequence": 147,
      "chapter": 3,
      "verse": 28,
      "sourceVerse": 28,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.28",
      "original": "तत्त्ववित्तु महाबाहो गुणकर्मविभागयोः ।\nगुणा गुणेषु वर्तन्त इति मत्वा न सज्जते"
    },
    {
      "id": "gita-3-29",
      "sequence": 148,
      "chapter": 3,
      "verse": 29,
      "sourceVerse": 29,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.29",
      "original": "प्रकृतेर्गुणसंमूढाः सज्जन्ते गुणकर्मसु ।\nतानकृत्स्नविदो मन्दान्कृत्स्नविन्न विचालयेत्"
    },
    {
      "id": "gita-3-30",
      "sequence": 149,
      "chapter": 3,
      "verse": 30,
      "sourceVerse": 30,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.30",
      "original": "मयि सर्वाणि कर्माणि संन्यस्याध्यात्मचेतसा ।\nनिराशीर्निर्ममो भूत्वा युध्यस्व विगतज्वरः"
    },
    {
      "id": "gita-3-31",
      "sequence": 150,
      "chapter": 3,
      "verse": 31,
      "sourceVerse": 31,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.31",
      "original": "ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः ।\nश्रद्धावन्तोऽनसूयन्तो मुच्यन्ते तेऽपि कर्मभिः"
    },
    {
      "id": "gita-3-32",
      "sequence": 151,
      "chapter": 3,
      "verse": 32,
      "sourceVerse": 32,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.32",
      "original": "ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम् ।\nसर्वज्ञानविमूढांस्तान्विद्धि नष्टानचेतसः"
    },
    {
      "id": "gita-3-33",
      "sequence": 152,
      "chapter": 3,
      "verse": 33,
      "sourceVerse": 33,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.33",
      "original": "सदृशं चेष्टते स्वस्याः प्रकृतेर्ज्ञानवानपि ।\nप्रकृतिं यान्ति भूतानि निग्रहः किं करिष्यति"
    },
    {
      "id": "gita-3-34",
      "sequence": 153,
      "chapter": 3,
      "verse": 34,
      "sourceVerse": 34,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.34",
      "original": "इन्द्रियस्येन्द्रियस्यार्थे रागद्वेषौ व्यवस्थितौ ।\nतयोर्न वशमागच्छेत्तौ ह्यस्य परिपन्थिनौ"
    },
    {
      "id": "gita-3-35",
      "sequence": 154,
      "chapter": 3,
      "verse": 35,
      "sourceVerse": 35,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.35",
      "original": "श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात् ।\nस्वधर्मे निधनं श्रेयः परधर्मो भयावहः"
    },
    {
      "id": "gita-3-36",
      "sequence": 155,
      "chapter": 3,
      "verse": 36,
      "sourceVerse": 36,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.36",
      "original": "अथ केन प्रयुक्तोऽयं पापं चरति पूरुषः ।\nअनिच्छन्नपि वार्ष्णेय बलादिव नियोजितः",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-3-37",
      "sequence": 156,
      "chapter": 3,
      "verse": 37,
      "sourceVerse": 37,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.37",
      "original": "काम एष क्रोध एष रजोगुणसमुद्भवः ।\nमहाशनो महापाप्मा विद्ध्येनमिह वैरिणम्",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-3-38",
      "sequence": 157,
      "chapter": 3,
      "verse": 38,
      "sourceVerse": 38,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.38",
      "original": "धूमेनाव्रियते वह्निर्यथादर्शो मलेन च ।\nयथोल्बेनावृतो गर्भस्तथा तेनेदमावृतम्"
    },
    {
      "id": "gita-3-39",
      "sequence": 158,
      "chapter": 3,
      "verse": 39,
      "sourceVerse": 39,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.39",
      "original": "आवृतं ज्ञानमेतेन ज्ञानिनो नित्यवैरिणा ।\nकामरूपेण कौन्तेय दुष्पूरेणानलेन च"
    },
    {
      "id": "gita-3-40",
      "sequence": 159,
      "chapter": 3,
      "verse": 40,
      "sourceVerse": 40,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.40",
      "original": "इन्द्रियाणि मनो बुद्धिरस्याधिष्ठानमुच्यते ।\nएतैर्विमोहयत्येष ज्ञानमावृत्य देहिनम्"
    },
    {
      "id": "gita-3-41",
      "sequence": 160,
      "chapter": 3,
      "verse": 41,
      "sourceVerse": 41,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.41",
      "original": "तस्मात्त्वमिन्द्रियाण्यादौ नियम्य भरतर्षभ ।\nपाप्मानं प्रजहि ह्येनं ज्ञानविज्ञाननाशनम्"
    },
    {
      "id": "gita-3-42",
      "sequence": 161,
      "chapter": 3,
      "verse": 42,
      "sourceVerse": 42,
      "section": "Chapter 03 · The Yoga of Action",
      "label": "3.42",
      "original": "इन्द्रियाणि पराण्याहुरिन्द्रियेभ्यः परं मनः ।\nमनसस्तु परा बुद्धिर्यो बुद्धेः परतस्तु सः"
    },
    {
      "id": "gita-3-43",
      "sequence": 162,
      "chapter": 3,
      "verse": 43,
      "sourceVerse": 43,
