    "sha1": "e9a33a6e778580fcb142c75cdfc15d07d6c6f0a5",
    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%AD%E0%A4%97%E0%A4%B5%E0%A4%A6%E0%A5%8D%E0%A4%97%E0%A5%80%E0%A4%A4%E0%A4%BE%2F%E0%A4%B8%E0%A4%BE%E0%A4%99%E0%A5%8D%E0%A4%96%E0%A5%8D%E0%A4%AF%E0%A4%AF%E0%A5%8B%E0%A4%97%E0%A4%83&oldid=408369",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "gita-2-1",
      "sequence": 48,
      "chapter": 2,
      "verse": 1,
      "sourceVerse": 1,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.1",
      "original": "अथ द्वितीयोऽध्यायः\nतं तथा कृपयाविष्टमश्रुपूर्णाकुलेक्षणम् ।\nविषीदन्तमिदं वाक्यमुवाच मधुसूदनः",
      "speaker": "सञ्जय उवाच"
    },
    {
      "id": "gita-2-2",
      "sequence": 49,
      "chapter": 2,
      "verse": 2,
      "sourceVerse": 2,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.2",
      "original": "कुतस्त्वा कश्मलमिदं विषमे समुपस्थितम् ।\nअनार्यजुष्टमस्वर्ग्यमकीर्तिकरमर्जुन",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-2-3",
      "sequence": 50,
      "chapter": 2,
      "verse": 3,
      "sourceVerse": 3,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.3",
      "original": "क्लैब्यं मा स्म गमः पार्थ नैतत्त्वय्युपपद्यते ।\nक्षुद्रं हृदयदौर्बल्यं त्यक्त्वोत्तिष्ठ परन्तप"
    },
    {
      "id": "gita-2-4",
      "sequence": 51,
      "chapter": 2,
      "verse": 4,
      "sourceVerse": 4,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.4",
      "original": "कथं भीष्ममहं संख्ये द्रोणं च मधुसूदन ।\nइषुभिः प्रति योत्स्यामि पूजार्हावरिसूदन",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-2-5",
      "sequence": 52,
      "chapter": 2,
      "verse": 5,
      "sourceVerse": 5,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.5",
      "original": "गुरूनहत्वा हि महानुभावान् श्रेयो भोक्तुं भैक्ष्यमपीह लोके ।\nहत्वार्थकामांस्तु गुरूनिहैव भुञ्जीय भोगान् रुधिरप्रदिग्धान्"
    },
    {
      "id": "gita-2-6",
      "sequence": 53,
      "chapter": 2,
      "verse": 6,
      "sourceVerse": 6,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.6",
      "original": "न चैतद्विद्मः कतरन्नो गरीयो यद्वा जयेम यदि वा नो जयेयुः ।\nयानेव हत्वा न जिजीविषाम- स्तेऽवस्थिताः प्रमुखे धार्तराष्ट्राः"
    },
    {
      "id": "gita-2-7",
      "sequence": 54,
      "chapter": 2,
      "verse": 7,
      "sourceVerse": 7,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.7",
      "original": "कार्पण्यदोषोपहतस्वभावः पृच्छामि त्वां धर्मसम्मूढचेताः ।\nयच्छ्रेयः स्यान्निश्चितं ब्रूहि तन्मे शिष्यस्तेऽहं शाधि मां त्वां प्रपन्नम्"
    },
    {
      "id": "gita-2-8",
      "sequence": 55,
      "chapter": 2,
      "verse": 8,
      "sourceVerse": 8,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.8",
      "original": "न हि प्रपश्यामि ममापनुद्याद् यच्छोकमुच्छोषणमिन्द्रियाणाम् ।\nअवाप्य भूमावसपत्नमृद्धं राज्यं सुराणामपि चाधिपत्यम्"
    },
    {
      "id": "gita-2-9",
      "sequence": 56,
      "chapter": 2,
      "verse": 9,
      "sourceVerse": 9,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.9",
      "original": "एवमुक्त्वा हृषीकेशं गुडाकेशः परन्तप ।\nन योत्स्य इति गोविन्दमुक्त्वा तूष्णीं बभूव ह",
      "speaker": "सञ्जय उवाच"
    },
    {
      "id": "gita-2-10",
      "sequence": 57,
      "chapter": 2,
      "verse": 10,
      "sourceVerse": 10,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.10",
      "original": "तमुवाच हृषीकेशः प्रहसन्निव भारत ।\nसेनयोरुभयोर्मध्ये विषीदन्तमिदं वचः"
    },
    {
      "id": "gita-2-11",
      "sequence": 58,
      "chapter": 2,
      "verse": 11,
      "sourceVerse": 11,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.11",
      "original": "अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे ।\nगतासूनगतासूंश्च नानुशोचन्ति पण्डिताः",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-2-12",
      "sequence": 59,
      "chapter": 2,
      "verse": 12,
      "sourceVerse": 12,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.12",
      "original": "न त्वेवाहं जातु नासं न त्वं नेमे जनाधिपाः ।\nन चैव न भविष्यामः सर्वे वयमतः परम्"
    },
    {
      "id": "gita-2-13",
      "sequence": 60,
      "chapter": 2,
      "verse": 13,
      "sourceVerse": 13,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.13",
      "original": "देहिनोऽस्मिन्यथा देहे कौमारं यौवनं जरा ।\nतथा देहान्तरप्राप्तिर्धीरस्तत्र न मुह्यति"
    },
    {
      "id": "gita-2-14",
      "sequence": 61,
      "chapter": 2,
      "verse": 14,
      "sourceVerse": 14,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.14",
      "original": "मात्रास्पर्शास्तु कौन्तेय शीतोष्णसुखदुःखदाः ।\nआगमापायिनोऽनित्यास्तांस्तितिक्षस्व भारत"
    },
    {
      "id": "gita-2-15",
      "sequence": 62,
      "chapter": 2,
      "verse": 15,
      "sourceVerse": 15,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.15",
      "original": "यं हि न व्यथयन्त्येते पुरुषं पुरुषर्षभ ।\nसमदुःखसुखं धीरं सोऽमृतत्वाय कल्पते"
    },
    {
      "id": "gita-2-16",
      "sequence": 63,
      "chapter": 2,
      "verse": 16,
      "sourceVerse": 16,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.16",
      "original": "नासतो विद्यते भावो नाभावो विद्यते सतः ।\nउभयोरपि दृष्टोऽन्तस्त्वनयोस्तत्त्वदर्शिभिः"
    },
    {
      "id": "gita-2-17",
      "sequence": 64,
      "chapter": 2,
      "verse": 17,
      "sourceVerse": 17,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.17",
      "original": "अविनाशि तु तद्विद्धि येन सर्वमिदं ततम् ।\nविनाशमव्ययस्यास्य न कश्चित्कर्तुमर्हति"
    },
    {
      "id": "gita-2-18",
      "sequence": 65,
      "chapter": 2,
      "verse": 18,
      "sourceVerse": 18,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.18",
      "original": "अन्तवन्त इमे देहा नित्यस्योक्ताः शरीरिणः ।\nअनाशिनोऽप्रमेयस्य तस्माद्युध्यस्व भारत"
    },
    {
      "id": "gita-2-19",
      "sequence": 66,
      "chapter": 2,
      "verse": 19,
      "sourceVerse": 19,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.19",
      "original": "य एनं वेत्ति हन्तारं यश्चैनं मन्यते हतम् ।\nउभौ तौ न विजानीतो नायं हन्ति न हन्यते"
    },
    {
      "id": "gita-2-20",
      "sequence": 67,
      "chapter": 2,
      "verse": 20,
      "sourceVerse": 20,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.20",
      "original": "न जायते म्रियते वा कदाचिन्नायं भूत्वा भविता वा न भूयः ।\nअजो नित्यः शाश्वतोऽयं पुराणो न हन्यते हन्यमाने शरीरे"
    },
    {
      "id": "gita-2-21",
      "sequence": 68,
      "chapter": 2,
      "verse": 21,
      "sourceVerse": 21,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.21",
      "original": "वेदाविनाशिनं नित्यं य एनमजमव्ययम् ।\nकथं स पुरुषः पार्थ कं घातयति हन्ति कम्"
    },
    {
      "id": "gita-2-22",
      "sequence": 69,
      "chapter": 2,
      "verse": 22,
      "sourceVerse": 22,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.22",
      "original": "वासांसि जीर्णानि यथा विहाय नवानि गृह्णाति नरोऽपराणि ।\nतथा शरीराणि विहाय जीर्णान्यन्यानि संयाति नवानि देही"
    },
    {
      "id": "gita-2-23",
      "sequence": 70,
      "chapter": 2,
      "verse": 23,
      "sourceVerse": 23,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.23",
      "original": "नैनं छिन्दन्ति शस्त्राणि नैनं दहति पावकः ।\nन चैनं क्लेदयन्त्यापो न शोषयति मारुतः"
    },
    {
      "id": "gita-2-24",
      "sequence": 71,
      "chapter": 2,
      "verse": 24,
      "sourceVerse": 24,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.24",
      "original": "अच्छेद्योऽयमदाह्योऽयमक्लेद्योऽशोष्य एव च ।\nनित्यः सर्वगतः स्थाणुरचलोऽयं सनातनः"
    },
    {
      "id": "gita-2-25",
      "sequence": 72,
      "chapter": 2,
      "verse": 25,
      "sourceVerse": 25,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.25",
      "original": "अव्यक्तोऽयमचिन्त्योऽयमविकार्योऽयमुच्यते ।\nतस्मादेवं विदित्वैनं नानुशोचितुमर्हसि"
    },
    {
      "id": "gita-2-26",
      "sequence": 73,
      "chapter": 2,
      "verse": 26,
      "sourceVerse": 26,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.26",
      "original": "अथ चैनं नित्यजातं नित्यं वा मन्यसे मृतम् ।\nतथापि त्वं महाबाहो नैवं शोचितुमर्हसि"
    },
    {
      "id": "gita-2-27",
      "sequence": 74,
      "chapter": 2,
      "verse": 27,
      "sourceVerse": 27,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.27",
      "original": "जातस्य हि ध्रुवो मृत्युर्ध्रुवं जन्म मृतस्य च ।\nतस्मादपरिहार्येऽर्थे न त्वं शोचितुमर्हसि"
    },
    {
      "id": "gita-2-28",
      "sequence": 75,
      "chapter": 2,
      "verse": 28,
      "sourceVerse": 28,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.28",
      "original": "अव्यक्तादीनि भूतानि व्यक्तमध्यानि भारत ।\nअव्यक्तनिधनान्येव तत्र का परिदेवना"
    },
    {
      "id": "gita-2-29",
      "sequence": 76,
      "chapter": 2,
      "verse": 29,
      "sourceVerse": 29,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.29",
      "original": "आश्चर्यवत्पश्यति कश्चिदेनमाश्चर्यवद्वदति तथैव चान्यः ।\nआश्चर्यवच्चैनमन्यः शृणोति श्रुत्वाप्येनं वेद न चैव कश्चित्"
    },
    {
      "id": "gita-2-30",
      "sequence": 77,
      "chapter": 2,
      "verse": 30,
      "sourceVerse": 30,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.30",
      "original": "देही नित्यमवध्योऽयं देहे सर्वस्य भारत ।\nतस्मात्सर्वाणि भूतानि न त्वं शोचितुमर्हसि"
    },
    {
      "id": "gita-2-31",
      "sequence": 78,
      "chapter": 2,
      "verse": 31,
      "sourceVerse": 31,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.31",
      "original": "स्वधर्ममपि चावेक्ष्य न विकम्पितुमर्हसि ।\nधर्म्याद्धि युद्धाच्छ्रेयोऽन्यत्क्षत्रियस्य न विद्यते"
    },
    {
      "id": "gita-2-32",
      "sequence": 79,
      "chapter": 2,
      "verse": 32,
      "sourceVerse": 32,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.32",
      "original": "यदृच्छया चोपपन्नं स्वर्गद्वारमपावृतम् ।\nसुखिनः क्षत्रियाः पार्थ लभन्ते युद्धमीदृशम्"
    },
    {
      "id": "gita-2-33",
      "sequence": 80,
      "chapter": 2,
      "verse": 33,
      "sourceVerse": 33,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.33",
      "original": "अथ चेत्त्वमिमं धर्म्यं संग्रामं न करिष्यसि ।\nततः स्वधर्मं कीर्तिं च हित्वा पापमवाप्स्यसि"
    },
    {
      "id": "gita-2-34",
      "sequence": 81,
      "chapter": 2,
      "verse": 34,
      "sourceVerse": 34,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.34",
      "original": "अकीर्तिं चापि भूतानि कथयिष्यन्ति तेऽव्ययाम् ।\nसम्भावितस्य चाकीर्तिर्मरणादतिरिच्यते"
    },
    {
      "id": "gita-2-35",
      "sequence": 82,
      "chapter": 2,
      "verse": 35,
      "sourceVerse": 35,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.35",
      "original": "भयाद्रणादुपरतं मंस्यन्ते त्वां महारथाः ।\nयेषां च त्वं बहुमतो भूत्वा यास्यसि लाघवम्"
    },
    {
      "id": "gita-2-36",
      "sequence": 83,
      "chapter": 2,
      "verse": 36,
      "sourceVerse": 36,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.36",
      "original": "अवाच्यवादांश्च बहून्वदिष्यन्ति तवाहिताः ।\nनिन्दन्तस्तव सामर्थ्यं ततो दुःखतरं नु किम्"
    },
    {
      "id": "gita-2-37",
      "sequence": 84,
      "chapter": 2,
      "verse": 37,
      "sourceVerse": 37,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.37",
      "original": "हतो वा प्राप्स्यसि स्वर्गं जित्वा वा भोक्ष्यसे महीम् ।\nतस्मादुत्तिष्ठ कौन्तेय युद्धाय कृतनिश्चयः"
    },
    {
      "id": "gita-2-38",
      "sequence": 85,
      "chapter": 2,
      "verse": 38,
      "sourceVerse": 38,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.38",
      "original": "सुखदुःखे समे कृत्वा लाभालाभौ जयाजयौ ।\nततो युद्धाय युज्यस्व नैवं पापमवाप्स्यसि"
    },
    {
      "id": "gita-2-39",
      "sequence": 86,
      "chapter": 2,
      "verse": 39,
      "sourceVerse": 39,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.39",
      "original": "एषा तेऽभिहिता सांख्ये बुद्धिर्योगे त्विमां शृणु ।\nबुद्ध्या युक्तो यया पार्थ कर्मबन्धं प्रहास्यसि"
    },
    {
      "id": "gita-2-40",
      "sequence": 87,
      "chapter": 2,
      "verse": 40,
      "sourceVerse": 40,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.40",
      "original": "नेहाभिक्रमनाशोऽस्ति प्रत्यवायो न विद्यते ।\nस्वल्पमप्यस्य धर्मस्य त्रायते महतो भयात्"
    },
    {
      "id": "gita-2-41",
      "sequence": 88,
      "chapter": 2,
      "verse": 41,
      "sourceVerse": 41,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.41",
      "original": "व्यवसायात्मिका बुद्धिरेकेह कुरुनन्दन ।\nबहुशाखा ह्यनन्ताश्च बुद्धयोऽव्यवसायिनाम्"
    },
    {
      "id": "gita-2-42",
      "sequence": 89,
      "chapter": 2,
      "verse": 42,
      "sourceVerse": 42,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.42",
      "original": "यामिमां पुष्पितां वाचं प्रवदन्त्यविपश्चितः ।\nवेदवादरताः पार्थ नान्यदस्तीति वादिनः"
    },
    {
      "id": "gita-2-43",
      "sequence": 90,
      "chapter": 2,
      "verse": 43,
      "sourceVerse": 43,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.43",
      "original": "कामात्मानः स्वर्गपरा जन्मकर्मफलप्रदाम् ।\nक्रियाविशेषबहुलां भोगैश्वर्यगतिं प्रति"
    },
    {
      "id": "gita-2-44",
      "sequence": 91,
      "chapter": 2,
      "verse": 44,
      "sourceVerse": 44,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.44",
      "original": "भोगैश्वर्यप्रसक्तानां तयापहृतचेतसाम् ।\nव्यवसायात्मिका बुद्धिः समाधौ न विधीयते"
    },
    {
      "id": "gita-2-45",
      "sequence": 92,
      "chapter": 2,
      "verse": 45,
      "sourceVerse": 45,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.45",
      "original": "त्रैगुण्यविषया वेदा निस्त्रैगुण्यो भवार्जुन ।\nनिर्द्वन्द्वो नित्यसत्त्वस्थो निर्योगक्षेम आत्मवान्"
    },
    {
      "id": "gita-2-46",
      "sequence": 93,
      "chapter": 2,
      "verse": 46,
      "sourceVerse": 46,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.46",
      "original": "यावानर्थ उदपाने सर्वतः संप्लुतोदके ।\nतावान्सर्वेषु वेदेषु ब्राह्मणस्य विजानतः"
    },
    {
      "id": "gita-2-47",
      "sequence": 94,
      "chapter": 2,
      "verse": 47,
      "sourceVerse": 47,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.47",
      "original": "कर्मण्येवाधिकारस्ते मा फलेषु कदाचन ।\nमा कर्मफलहेतुर्भूर्मा ते सङ्गोऽस्त्वकर्मणि"
    },
    {
      "id": "gita-2-48",
      "sequence": 95,
      "chapter": 2,
      "verse": 48,
      "sourceVerse": 48,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.48",
      "original": "योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनंजय ।\nसिद्ध्यसिद्ध्योः समो भूत्वा समत्वं योग उच्यते"
    },
    {
      "id": "gita-2-49",
      "sequence": 96,
      "chapter": 2,
      "verse": 49,
      "sourceVerse": 49,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.49",
      "original": "दूरेण ह्यवरं कर्म बुद्धियोगाद्धनंजय ।\nबुद्धौ शरणमन्विच्छ कृपणाः फलहेतवः"
    },
    {
      "id": "gita-2-50",
      "sequence": 97,
      "chapter": 2,
      "verse": 50,
      "sourceVerse": 50,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.50",
      "original": "बुद्धियुक्तो जहातीह उभे सुकृतदुष्कृते ।\nतस्माद्योगाय युज्यस्व योगः कर्मसु कौशलम्"
    },
    {
      "id": "gita-2-51",
      "sequence": 98,
      "chapter": 2,
      "verse": 51,
      "sourceVerse": 51,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.51",
      "original": "कर्मजं बुद्धियुक्ता हि फलं त्यक्त्वा मनीषिणः ।\nजन्मबन्धविनिर्मुक्ताः पदं गच्छन्त्यनामयम्"
    },
    {
      "id": "gita-2-52",
      "sequence": 99,
      "chapter": 2,
      "verse": 52,
      "sourceVerse": 52,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.52",
      "original": "यदा ते मोहकलिलं बुद्धिर्व्यतितरिष्यति ।\nतदा गन्तासि निर्वेदं श्रोतव्यस्य श्रुतस्य च"
    },
    {
      "id": "gita-2-53",
      "sequence": 100,
      "chapter": 2,
      "verse": 53,
      "sourceVerse": 53,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.53",
      "original": "श्रुतिविप्रतिपन्ना ते यदा स्थास्यति निश्चला ।\nसमाधावचला बुद्धिस्तदा योगमवाप्स्यसि"
    },
    {
      "id": "gita-2-54",
      "sequence": 101,
      "chapter": 2,
      "verse": 54,
      "sourceVerse": 54,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.54",
      "original": "स्थितप्रज्ञस्य का भाषा समाधिस्थस्य केशव ।\nस्थितधीः किं प्रभाषेत किमासीत व्रजेत किम्",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-2-55",
      "sequence": 102,
      "chapter": 2,
      "verse": 55,
      "sourceVerse": 55,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.55",
      "original": "प्रजहाति यदा कामान्सर्वान्पार्थ मनोगतान् ।\nआत्मन्येवात्मना तुष्टः स्थितप्रज्ञस्तदोच्यते",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-2-56",
      "sequence": 103,
      "chapter": 2,
      "verse": 56,
      "sourceVerse": 56,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.56",
      "original": "दुःखेष्वनुद्विग्नमनाः सुखेषु विगतस्पृहः ।\nवीतरागभयक्रोधः स्थितधीर्मुनिरुच्यते"
    },
    {
      "id": "gita-2-57",
      "sequence": 104,
      "chapter": 2,
      "verse": 57,
      "sourceVerse": 57,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.57",
      "original": "यः सर्वत्रानभिस्नेहस्तत्तत्प्राप्य शुभाशुभम् ।\nनाभिनन्दति न द्वेष्टि तस्य प्रज्ञा प्रतिष्ठिता"
    },
    {
      "id": "gita-2-58",
      "sequence": 105,
      "chapter": 2,
      "verse": 58,
      "sourceVerse": 58,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.58",
      "original": "यदा संहरते चायं कूर्मोऽङ्गानीव सर्वशः ।\nइन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता"
    },
    {
      "id": "gita-2-59",
      "sequence": 106,
      "chapter": 2,
      "verse": 59,
      "sourceVerse": 59,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.59",
      "original": "विषया विनिवर्तन्ते निराहारस्य देहिनः ।\nरसवर्जं रसोऽप्यस्य परं दृष्ट्वा निवर्तते"
    },
    {
      "id": "gita-2-60",
      "sequence": 107,
      "chapter": 2,
      "verse": 60,
      "sourceVerse": 60,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.60",
      "original": "यततो ह्यपि कौन्तेय पुरुषस्य विपश्चितः ।\nइन्द्रियाणि प्रमाथीनि हरन्ति प्रसभं मनः"
    },
    {
      "id": "gita-2-61",
      "sequence": 108,
      "chapter": 2,
      "verse": 61,
      "sourceVerse": 61,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.61",
      "original": "तानि सर्वाणि संयम्य युक्त आसीत मत्परः ।\nवशे हि यस्येन्द्रियाणि तस्य प्रज्ञा प्रतिष्ठिता"
    },
    {
      "id": "gita-2-62",
      "sequence": 109,
      "chapter": 2,
      "verse": 62,
      "sourceVerse": 62,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.62",
      "original": "ध्यायतो विषयान्पुंसः सङ्गस्तेषूपजायते ।\nसङ्गात्संजायते कामः कामात्क्रोधोऽभिजायते"
    },
    {
      "id": "gita-2-63",
      "sequence": 110,
      "chapter": 2,
      "verse": 63,
      "sourceVerse": 63,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.63",
      "original": "क्रोधाद्भवति संमोहः संमोहात्स्मृतिविभ्रमः ।\nस्मृतिभ्रंशाद्बुद्धिनाशो बुद्धिनाशात्प्रणश्यति"
    },
    {
      "id": "gita-2-64",
      "sequence": 111,
      "chapter": 2,
      "verse": 64,
      "sourceVerse": 64,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.64",
      "original": "रागद्वेषवियुक्तैस्तु विषयानिन्द्रियैश्चरन् ।\nआत्मवश्यैर्विधेयात्मा प्रसादमधिगच्छति"
    },
    {
      "id": "gita-2-65",
      "sequence": 112,
      "chapter": 2,
      "verse": 65,
      "sourceVerse": 65,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.65",
      "original": "प्रसादे सर्वदुःखानां हानिरस्योपजायते ।\nप्रसन्नचेतसो ह्याशु बुद्धिः पर्यवतिष्ठते"
    },
    {
      "id": "gita-2-66",
      "sequence": 113,
      "chapter": 2,
      "verse": 66,
      "sourceVerse": 66,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.66",
      "original": "नास्ति बुद्धिरयुक्तस्य न चायुक्तस्य भावना ।\nन चाभावयतः शान्तिरशान्तस्य कुतः सुखम्"
    },
    {
      "id": "gita-2-67",
      "sequence": 114,
      "chapter": 2,
      "verse": 67,
      "sourceVerse": 67,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.67",
      "original": "इन्द्रियाणां हि चरतां यन्मनोऽनु विधीयते ।\nतदस्य हरति प्रज्ञां वायुर्नावमिवाम्भसि"
    },
    {
      "id": "gita-2-68",
      "sequence": 115,
      "chapter": 2,
      "verse": 68,
      "sourceVerse": 68,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.68",
      "original": "तस्माद्यस्य महाबाहो निगृहीतानि सर्वशः ।\nइन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता"
    },
    {
      "id": "gita-2-69",
      "sequence": 116,
      "chapter": 2,
      "verse": 69,
      "sourceVerse": 69,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.69",
      "original": "या निशा सर्वभूतानां तस्यां जागर्ति संयमी ।\nयस्यां जाग्रति भूतानि सा निशा पश्यतो मुनेः"
    },
    {
      "id": "gita-2-70",
      "sequence": 117,
      "chapter": 2,
      "verse": 70,
      "sourceVerse": 70,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.70",
      "original": "आपूर्यमाणमचलप्रतिष्ठं समुद्रमापः प्रविशन्ति यद्वत् ।\nतद्वत्कामा यं प्रविशन्ति सर्वे स शान्तिमाप्नोति न कामकामी"
    },
    {
      "id": "gita-2-71",
      "sequence": 118,
      "chapter": 2,
      "verse": 71,
      "sourceVerse": 71,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.71",
      "original": "विहाय कामान्यः सर्वान् पुमांश्चरति निःस्पृहः ।\nनिर्ममो निरहंकारः स शान्तिमधिगच्छति"
    },
    {
      "id": "gita-2-72",
      "sequence": 119,
      "chapter": 2,
      "verse": 72,
      "sourceVerse": 72,
      "section": "Chapter 02 · The Yoga of Knowledge",
      "label": "2.72",
      "original": "एषा ब्राह्मी स्थितिः पार्थ नैनां प्राप्य विमुह्यति ।\nस्थित्वास्यामन्तकालेऽपि ब्रह्मनिर्वाणमृच्छति"
    }
  ]
}
