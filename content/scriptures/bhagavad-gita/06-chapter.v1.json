    "sha1": "68c2904d50635af48f0d5344fdfa428fd5fbe827",
    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%AD%E0%A4%97%E0%A4%B5%E0%A4%A6%E0%A5%8D%E0%A4%97%E0%A5%80%E0%A4%A4%E0%A4%BE%2F%E0%A4%86%E0%A4%A4%E0%A5%8D%E0%A4%AE%E0%A4%B8%E0%A4%82%E0%A4%AF%E0%A4%AE%E0%A4%AF%E0%A5%8B%E0%A4%97%E0%A4%83&oldid=216842",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "gita-6-1",
      "sequence": 234,
      "chapter": 6,
      "verse": 1,
      "sourceVerse": 1,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.1",
      "original": "अनाश्रितः कर्मफलं कार्यं कर्म करोति यः ।\nस संन्यासी च योगी च न निरग्निर्न चाक्रियः",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-6-2",
      "sequence": 235,
      "chapter": 6,
      "verse": 2,
      "sourceVerse": 2,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.2",
      "original": "यं संन्यासमिति प्राहुर्योगं तं विद्धि पाण्डव ।\nन ह्यसंन्यस्तसंकल्पो योगी भवति कश्चन"
    },
    {
      "id": "gita-6-3",
      "sequence": 236,
      "chapter": 6,
      "verse": 3,
      "sourceVerse": 3,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.3",
      "original": "आरुरुक्षोर्मुनेर्योगं कर्म कारणमुच्यते ।\nयोगारूढस्य तस्यैव शमः कारणमुच्यते"
    },
    {
      "id": "gita-6-4",
      "sequence": 237,
      "chapter": 6,
      "verse": 4,
      "sourceVerse": 4,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.4",
      "original": "यदा हि नेन्द्रियार्थेषु न कर्मस्वनुषज्जते ।\nसर्वसंकल्पसंन्यासी योगारूढस्तदोच्यते"
    },
    {
      "id": "gita-6-5",
      "sequence": 238,
      "chapter": 6,
      "verse": 5,
      "sourceVerse": 5,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.5",
      "original": "उद्धरेदात्मनात्मानं नात्मानमवसादयेत् ।\nआत्मैव ह्यात्मनो बन्धुरात्मैव रिपुरात्मनः"
    },
    {
      "id": "gita-6-6",
      "sequence": 239,
      "chapter": 6,
      "verse": 6,
      "sourceVerse": 6,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.6",
      "original": "बन्धुरात्मात्मनस्तस्य येनात्मैवात्मना जितः ।\nअनात्मनस्तु शत्रुत्वे वर्तेतात्मैव शत्रुवत्"
    },
    {
      "id": "gita-6-7",
      "sequence": 240,
      "chapter": 6,
      "verse": 7,
      "sourceVerse": 7,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.7",
      "original": "जितात्मनः प्रशान्तस्य परमात्मा समाहितः ।\nशीतोष्णसुखदुःखेषु तथा मानापमानयोः"
    },
    {
      "id": "gita-6-8",
      "sequence": 241,
      "chapter": 6,
      "verse": 8,
      "sourceVerse": 8,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.8",
      "original": "ज्ञानविज्ञानतृप्तात्मा कूटस्थो विजितेन्द्रियः ।\nयुक्त इत्युच्यते योगी समलोष्टाश्मकाञ्चनः"
    },
    {
      "id": "gita-6-9",
      "sequence": 242,
      "chapter": 6,
      "verse": 9,
      "sourceVerse": 9,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.9",
      "original": "सुहृन्मित्रार्युदासीनमध्यस्थद्वेष्यबन्धुषु ।\nसाधुष्वपि च पापेषु समबुद्धिर्विशिष्यते"
    },
    {
      "id": "gita-6-10",
      "sequence": 243,
      "chapter": 6,
      "verse": 10,
      "sourceVerse": 10,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.10",
      "original": "योगी युञ्जीत सततमात्मानं रहसि स्थितः ।\nएकाकी यतचित्तात्मा निराशीरपरिग्रहः"
    },
    {
      "id": "gita-6-11",
      "sequence": 244,
      "chapter": 6,
      "verse": 11,
      "sourceVerse": 11,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.11",
      "original": "शुचौ देशे प्रतिष्ठाप्य स्थिरमासनमात्मनः ।\nनात्युच्छ्रितं नातिनीचं चैलाजिनकुशोत्तरम्"
    },
    {
      "id": "gita-6-12",
      "sequence": 245,
      "chapter": 6,
      "verse": 12,
      "sourceVerse": 12,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.12",
      "original": "तत्रैकाग्रं मनः कृत्वा यतचित्तेन्द्रियक्रियः ।\nउपविश्यासने युञ्ज्याद्योगमात्मविशुद्धये"
    },
    {
      "id": "gita-6-13",
      "sequence": 246,
      "chapter": 6,
      "verse": 13,
      "sourceVerse": 13,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.13",
      "original": "समं कायशिरोग्रीवं धारयन्नचलं स्थिरः ।\nसम्प्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन्"
    },
    {
      "id": "gita-6-14",
      "sequence": 247,
      "chapter": 6,
      "verse": 14,
      "sourceVerse": 14,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.14",
      "original": "प्रशान्तात्मा विगतभीर्ब्रह्मचारिव्रते स्थितः ।\nमनः संयम्य मच्चित्तो युक्त आसीत मत्परः"
    },
    {
      "id": "gita-6-15",
      "sequence": 248,
      "chapter": 6,
      "verse": 15,
      "sourceVerse": 15,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.15",
      "original": "युञ्जन्नेवं सदात्मानं योगी नियतमानसः ।\nशान्तिं निर्वाणपरमां मत्संस्थामधिगच्छति"
    },
    {
      "id": "gita-6-16",
      "sequence": 249,
      "chapter": 6,
      "verse": 16,
      "sourceVerse": 16,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.16",
      "original": "नात्यश्नतस्तु योगोऽस्ति न चैकान्तमनश्नतः ।\nन चाति स्वप्नशीलस्य जाग्रतो नैव चार्जुन"
    },
    {
      "id": "gita-6-17",
      "sequence": 250,
      "chapter": 6,
      "verse": 17,
      "sourceVerse": 17,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.17",
      "original": "युक्ताहारविहारस्य  युक्तचेष्टस्य कर्मसु ।\nयुक्तस्वप्नावबोधस्य योगो भवति दुःखहा"
    },
    {
      "id": "gita-6-18",
      "sequence": 251,
      "chapter": 6,
      "verse": 18,
      "sourceVerse": 18,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.18",
      "original": "यदा विनियतं चित्तमात्मन्येवावतिष्ठते ।\nनिःस्पृहः सर्वकामेभ्यो युक्त इत्युच्यते तदा"
    },
    {
      "id": "gita-6-19",
      "sequence": 252,
      "chapter": 6,
      "verse": 19,
      "sourceVerse": 19,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.19",
      "original": "यथा दीपो निवातस्थो नेङ्गते सोपमा स्मृता ।\nयोगिनो यतचित्तस्य युञ्जतो योगमात्मनः"
    },
    {
      "id": "gita-6-20",
      "sequence": 253,
      "chapter": 6,
      "verse": 20,
      "sourceVerse": 20,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.20",
      "original": "यत्रोपरमते चित्तं निरुद्धं योगसेवया ।\nयत्र चैवात्मनात्मानं पश्यन्नात्मनि तुष्यति"
    },
    {
      "id": "gita-6-21",
      "sequence": 254,
      "chapter": 6,
      "verse": 21,
      "sourceVerse": 21,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.21",
      "original": "सुखमात्यन्तिकं यत्तद् बुद्धिग्राह्यमतीन्द्रियम् ।\nवेत्ति यत्र न चैवायं स्थितश्चलति तत्त्वतः"
    },
    {
      "id": "gita-6-22",
      "sequence": 255,
      "chapter": 6,
      "verse": 22,
      "sourceVerse": 22,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.22",
      "original": "यं लब्ध्वा चापरं लाभं मन्यते नाधिकं ततः ।\nयस्मिन्स्थितो न दुःखेन गुरुणापि विचाल्यते"
    },
    {
      "id": "gita-6-23",
      "sequence": 256,
      "chapter": 6,
      "verse": 23,
      "sourceVerse": 23,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.23",
      "original": "तं विद्याद्‌दुःखसंयोगवियोगं योगसंज्ञितम् ।\nस निश्चयेन योक्तव्यो योगोऽनिर्विण्णचेतसा"
    },
    {
      "id": "gita-6-24",
      "sequence": 257,
      "chapter": 6,
      "verse": 24,
      "sourceVerse": 24,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.24",
      "original": "संकल्पप्रभवान्कामांस्त्यक्त्वा सर्वानशेषतः ।\nमनसैवेन्द्रियग्रामं विनियम्य समन्ततः"
    },
    {
      "id": "gita-6-25",
      "sequence": 258,
      "chapter": 6,
      "verse": 25,
      "sourceVerse": 25,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.25",
      "original": "शनैः शनैरुपरमेद्‌बुद्ध्या धृतिगृहीतया ।\nआत्मसंस्थं मनः कृत्वा न किंचिदपि चिन्तयेत्"
    },
    {
      "id": "gita-6-26",
      "sequence": 259,
      "chapter": 6,
      "verse": 26,
      "sourceVerse": 26,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.26",
      "original": "यतो यतो निश्चरति मनश्चञ्चलमस्थिरम् ।\nततस्ततो नियम्यैतदात्मन्येव वशं नयेत्"
    },
    {
      "id": "gita-6-27",
      "sequence": 260,
      "chapter": 6,
      "verse": 27,
      "sourceVerse": 27,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.27",
      "original": "प्रशान्तमनसं ह्येनं योगिनं सुखमुत्तमम् ।\nउपैति शान्तरजसं ब्रह्मभूतमकल्मषम्"
    },
    {
      "id": "gita-6-28",
      "sequence": 261,
      "chapter": 6,
      "verse": 28,
      "sourceVerse": 28,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.28",
      "original": "युञ्जन्नेवं सदात्मानं योगी विगतकल्मषः ।\nसुखेन ब्रह्मसंस्पर्शमत्यन्तं सुखमश्नुते"
    },
    {
      "id": "gita-6-29",
      "sequence": 262,
      "chapter": 6,
      "verse": 29,
      "sourceVerse": 29,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.29",
      "original": "सर्वभूतस्थमात्मानं सर्वभूतानि चात्मनि ।\nईक्षते योगयुक्तात्मा सर्वत्र समदर्शनः"
    },
    {
      "id": "gita-6-30",
      "sequence": 263,
      "chapter": 6,
      "verse": 30,
      "sourceVerse": 30,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.30",
      "original": "यो मां पश्यति सर्वत्र सर्वं च मयि पश्यति ।\nतस्याहं न प्रणश्यामि स च मे न प्रणश्यति"
    },
    {
      "id": "gita-6-31",
      "sequence": 264,
      "chapter": 6,
      "verse": 31,
      "sourceVerse": 31,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.31",
      "original": "सर्वभूतस्थितं यो मां भजत्येकत्वमास्थितः ।\nसर्वथा वर्तमानोऽपि स योगी मयि वर्तते"
    },
    {
      "id": "gita-6-32",
      "sequence": 265,
      "chapter": 6,
      "verse": 32,
      "sourceVerse": 32,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.32",
      "original": "आत्मौपम्येन सर्वत्र समं पश्यति योऽर्जुन ।\nसुखं वा यदि वा दुःखं स योगी परमो मतः"
    },
    {
      "id": "gita-6-33",
      "sequence": 266,
      "chapter": 6,
      "verse": 33,
      "sourceVerse": 33,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.33",
      "original": "योऽयं योगस्त्वया प्रोक्तः साम्येन मधुसूदन ।\nएतस्याहं न पश्यामि चञ्चलत्वात्स्थितिं स्थिराम्",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-6-34",
      "sequence": 267,
      "chapter": 6,
      "verse": 34,
      "sourceVerse": 34,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.34",
      "original": "चञ्चलं हि मनः कृष्ण प्रमाथि बलवद्‌दृढम् ।\nतस्याहं निग्रहं मन्ये वायोरिव सुदुष्करम्"
    },
    {
      "id": "gita-6-35",
      "sequence": 268,
      "chapter": 6,
      "verse": 35,
      "sourceVerse": 35,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.35",
      "original": "असंशयं महाबाहो मनो दुर्निग्रहं चलम् ।\nअभ्यासेन तु कौन्तेय वैराग्येण च गृह्यते",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-6-36",
      "sequence": 269,
      "chapter": 6,
      "verse": 36,
      "sourceVerse": 36,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.36",
      "original": "असंयतात्मना योगो दुष्प्राप इति मे मतिः ।\nवश्यात्मना तु यतता शक्योऽवाप्तुमुपायतः"
    },
    {
      "id": "gita-6-37",
      "sequence": 270,
      "chapter": 6,
      "verse": 37,
      "sourceVerse": 37,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.37",
      "original": "अयतिः श्रद्धयोपेतो योगाच्चलितमानसः ।\nअप्राप्य योगसंसिद्धिं कां गतिं कृष्ण गच्छति",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-6-38",
      "sequence": 271,
      "chapter": 6,
      "verse": 38,
      "sourceVerse": 38,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.38",
      "original": "कच्चिन्नोभयविभ्रष्टश्छिन्नाभ्रमिव नश्यति ।\nअप्रतिष्ठो महाबाहो विमूढो ब्रह्मणः पथि"
    },
    {
      "id": "gita-6-39",
      "sequence": 272,
      "chapter": 6,
      "verse": 39,
      "sourceVerse": 39,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.39",
      "original": "एतन्मे संशयं कृष्ण छेत्तुमर्हस्यशेषतः ।\nत्वदन्यः संशयस्यास्य छेत्ता न ह्युपपद्यते"
    },
    {
      "id": "gita-6-40",
      "sequence": 273,
      "chapter": 6,
      "verse": 40,
      "sourceVerse": 40,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.40",
      "original": "पार्थ नैवेह नामुत्र विनाशस्तस्य विद्यते ।\nन हि कल्याणकृत्कश्चिद्‌दुर्गतिं तात गच्छति",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-6-41",
      "sequence": 274,
      "chapter": 6,
      "verse": 41,
      "sourceVerse": 41,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.41",
      "original": "प्राप्य पुण्यकृतां लोकानुषित्वा शाश्वतीः समाः ।\nशुचीनां श्रीमतां गेहे योगभ्रष्टोऽभिजायते"
    },
    {
      "id": "gita-6-42",
      "sequence": 275,
      "chapter": 6,
      "verse": 42,
      "sourceVerse": 42,
      "section": "Chapter 06 · The Yoga of Meditation",
      "label": "6.42",
      "original": "अथवा योगिनामेव कुले भवति धीमताम् ।\nएतद्धि दुर्लभतरं लोके जन्म यदीदृशम्"
    },
    {
      "id": "gita-6-43",
      "sequence": 276,
