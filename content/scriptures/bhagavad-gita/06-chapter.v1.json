  "chapter": {
    "number": 6,
    "titleEnglish": "The Yoga of Meditation",
    "sourcePage": "भगवद्गीता/आत्मसंयमयोगः"
  },
  "source": {
    "project": "Sanskrit Wikisource",
    "pageid": 169,
