    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%AD%E0%A4%97%E0%A4%B5%E0%A4%A6%E0%A5%8D%E0%A4%97%E0%A5%80%E0%A4%A4%E0%A4%BE%2F%E0%A4%AD%E0%A4%95%E0%A5%8D%E0%A4%A4%E0%A4%BF%E0%A4%AF%E0%A5%8B%E0%A4%97%E0%A4%83&oldid=333675",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "gita-12-1",
      "sequence": 470,
      "chapter": 12,
      "verse": 1,
      "sourceVerse": 1,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.1",
      "original": "एवं सततयुक्ता ये भक्तास्त्वां पर्युपासते ।\nये चाप्यक्षरमव्यक्तं तेषां के योगवित्तमाः",
      "speaker": "अर्जुन उवाच"
    },
    {
      "id": "gita-12-2",
      "sequence": 471,
      "chapter": 12,
      "verse": 2,
      "sourceVerse": 2,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.2",
      "original": "मय्यावेश्य मनो ये मां नित्ययुक्ता उपासते ।\nश्रद्धया परयोपेतास्ते मे युक्ततमा मताः",
      "speaker": "श्रीभगवानुवाच"
    },
    {
      "id": "gita-12-3",
      "sequence": 472,
      "chapter": 12,
      "verse": 3,
      "sourceVerse": 3,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.3",
      "original": "ये त्वक्षरमनिर्देश्यमव्यक्तं पर्युपासते ।\nसर्वत्रगमचिन्त्यं च कूटस्थमचलं ध्रुवम्"
    },
    {
      "id": "gita-12-4",
      "sequence": 473,
      "chapter": 12,
      "verse": 4,
      "sourceVerse": 4,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.4",
      "original": "संनियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः ।\nते प्राप्नुवन्ति मामेव सर्वभूतहिते रताः"
    },
    {
      "id": "gita-12-5",
      "sequence": 474,
      "chapter": 12,
      "verse": 5,
      "sourceVerse": 5,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.5",
      "original": "क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम् ।\nअव्यक्ता हि गतिर्दुःखं देहवद्भिरवाप्यते"
    },
    {
      "id": "gita-12-6",
      "sequence": 475,
      "chapter": 12,
      "verse": 6,
      "sourceVerse": 6,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.6",
      "original": "ये तु सर्वाणि कर्माणि मयि संन्यस्य मत्पराः ।\nअनन्येनैव योगेन मां ध्यायन्त उपासते"
    },
    {
      "id": "gita-12-7",
      "sequence": 476,
      "chapter": 12,
      "verse": 7,
      "sourceVerse": 7,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.7",
      "original": "तेषामहं समुद्धर्ता मृत्युसंसारसागरात् ।\nभवामि नचिरात्पार्थ मय्यावेशितचेतसाम्"
    },
    {
      "id": "gita-12-8",
      "sequence": 477,
      "chapter": 12,
      "verse": 8,
      "sourceVerse": 8,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.8",
      "original": "मय्येव मन आधत्स्व मयि बुद्धिं निवेशय ।\nनिवसिष्यसि मय्येव अत ऊर्ध्वं न संशयः"
    },
    {
      "id": "gita-12-9",
      "sequence": 478,
      "chapter": 12,
      "verse": 9,
      "sourceVerse": 9,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.9",
      "original": "अथ चित्तं समाधातुं न शक्नोषि मयि स्थिरम् ।\nअभ्यासयोगेन ततो मामिच्छाप्तुं धनंजय"
    },
    {
      "id": "gita-12-10",
      "sequence": 479,
      "chapter": 12,
      "verse": 10,
      "sourceVerse": 10,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.10",
      "original": "अभ्यासेऽप्यसमर्थोऽसि मत्कर्मपरमो भव ।\nमदर्थमपि कर्माणि कुर्वन्सिद्धिमवाप्स्यसि"
    },
    {
      "id": "gita-12-11",
      "sequence": 480,
      "chapter": 12,
      "verse": 11,
      "sourceVerse": 11,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.11",
      "original": "अथैतदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः ।\nसर्वकर्मफलत्यागं ततः कुरु यतात्मवान्"
    },
    {
      "id": "gita-12-12",
      "sequence": 481,
      "chapter": 12,
      "verse": 12,
      "sourceVerse": 12,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.12",
      "original": "श्रेयो हि ज्ञानमभ्यासाज्ज्ञानाद्ध्यानं विशिष्यते ।\nध्यानात्कर्मफलत्यागस्त्यागाच्छान्तिरनन्तरम्"
    },
    {
      "id": "gita-12-13",
      "sequence": 482,
      "chapter": 12,
      "verse": 13,
      "sourceVerse": 13,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.13",
      "original": "अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च ।\nनिर्ममो निरहंकारः समदुःखसुखः क्षमी"
    },
    {
      "id": "gita-12-14",
      "sequence": 483,
      "chapter": 12,
      "verse": 14,
      "sourceVerse": 14,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.14",
      "original": "संतुष्टः सततं योगी यतात्मा दृढनिश्चयः ।\nमय्यर्पितमनोबुद्धिर्यो मद्भक्तः स मे प्रियः"
    },
    {
      "id": "gita-12-15",
      "sequence": 484,
      "chapter": 12,
      "verse": 15,
      "sourceVerse": 15,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.15",
      "original": "यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः ।\nहर्षामर्षभयोद्वेगैर्मुक्तो यः स च मे प्रियः"
    },
    {
      "id": "gita-12-16",
      "sequence": 485,
      "chapter": 12,
      "verse": 16,
      "sourceVerse": 16,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.16",
      "original": "अनपेक्षः शुचिर्दक्ष उदासीनो गतव्यथः ।\nसर्वारम्भपरित्यागी यो मद्भक्तः स मे प्रियः"
    },
    {
      "id": "gita-12-17",
      "sequence": 486,
      "chapter": 12,
      "verse": 17,
      "sourceVerse": 17,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.17",
      "original": "यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति ।\nशुभाशुभपरित्यागी भक्तिमान्यः स मे प्रियः"
    },
    {
      "id": "gita-12-18",
      "sequence": 487,
      "chapter": 12,
      "verse": 18,
      "sourceVerse": 18,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.18",
      "original": "समः शत्रौ च मित्रे च तथा मानापमानयोः ।\nशीतोष्णसुखदुःखेषु समः सङ्गविवर्जितः"
    },
    {
      "id": "gita-12-19",
      "sequence": 488,
      "chapter": 12,
      "verse": 19,
      "sourceVerse": 19,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.19",
      "original": "तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येन केनचित् ।\nअनिकेतः स्थिरमतिर्भक्तिमान्मे प्रियो नरः"
    },
    {
      "id": "gita-12-20",
      "sequence": 489,
      "chapter": 12,
      "verse": 20,
      "sourceVerse": 20,
      "section": "Chapter 12 · The Yoga of Devotion",
      "label": "12.20",
      "original": "ये तु धर्म्यामृतमिदं यथोक्तं पर्युपासते ।\nश्रद्दधाना मत्परमा भक्तास्तेऽतीव मे प्रियाः"
    }
  ]
}
