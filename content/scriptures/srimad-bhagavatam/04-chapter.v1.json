    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%AA&oldid=110175",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-4-1",
      "sequence": 101,
      "chapter": 4,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.1",
      "original": "व्यास उवाच ।\nइति ब्रुवाणं संस्तूय मुनीनां दीर्घसत्रिणाम् ।\nवृद्धः कुलपतिः सूतं बह्‌वृचः शौनकोऽब्रवीत्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-4-2",
      "sequence": 102,
      "chapter": 4,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.2",
      "original": "शौनक उवाच ।\nसूत सूत महाभाग वद नो वदतां वर ।\nकथां भागवतीं पुण्यां यदाह भगवान् शुकः"
    },
    {
      "id": "bhagavatam-1-4-3",
      "sequence": 103,
      "chapter": 4,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.3",
      "original": "कस्मिन् युगे प्रवृत्तेयं स्थाने वा केन हेतुना ।\nकुतः सञ्चोदितः कृष्णः कृतवान् संहितां मुनिः"
    },
    {
      "id": "bhagavatam-1-4-4",
      "sequence": 104,
      "chapter": 4,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.4",
      "original": "तस्य पुत्रो महायोगी समदृङ् निर्विकल्पकः ।\nएकान्तमतिः उन्निद्रो गूढो मूढ इवेयते"
    },
    {
      "id": "bhagavatam-1-4-5",
      "sequence": 105,
      "chapter": 4,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.5",
      "original": "दृष्ट्वानुयान्तमृषिमात्मजमप्यनग्नं\nदेव्यो ह्रिया परिदधुर्न सुतस्य चित्रम् ।\nतद्‌वीक्ष्य पृच्छति मुनौ जगदुस्तवास्ति\nस्त्रीपुम्भिदा न तु सुतस्य विविक्तदृष्टेः",
      "meter": "वसंततिलका"
    },
    {
      "id": "bhagavatam-1-4-6",
      "sequence": 106,
      "chapter": 4,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.6",
      "original": "कथमालक्षितः पौरैः संप्राप्तः कुरुजाङ्गलान् ।\nउन्मत्तमूकजडवद् विचरन् गजसाह्वये",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-4-7",
      "sequence": 107,
      "chapter": 4,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.7",
      "original": "कथं वा पाण्डवेयस्य राजर्षेर्मुनिना सह ।\nसंवादः समभूत् तात यत्रैषा सात्वती श्रुतिः"
    },
    {
      "id": "bhagavatam-1-4-8",
      "sequence": 108,
      "chapter": 4,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.8",
      "original": "स गोदोहनमात्रं हि गृहेषु गृहमेधिनाम् ।\nअवेक्षते महाभागः तीर्थीकुर्वन् तदाश्रमम्"
    },
    {
      "id": "bhagavatam-1-4-9",
      "sequence": 109,
      "chapter": 4,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.9",
      "original": "अभिमन्युसुतं सूत प्राहुर्भागवतोत्तमम् ।\nतस्य जन्म महाश्चर्यं कर्माणि च गृणीहि नः"
    },
    {
      "id": "bhagavatam-1-4-10",
      "sequence": 110,
      "chapter": 4,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.10",
      "original": "स सम्राट् कस्य वा हेतोः पाण्डूनां मानवर्धनः ।\nप्रायोपविष्टो गङ्गायां अनादृत्य अधिराट् श्रियम्"
    },
    {
      "id": "bhagavatam-1-4-11",
      "sequence": 111,
      "chapter": 4,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.11",
      "original": "नमन्ति यत्पादनिकेतमात्मनः\nशिवाय हानीय धनानि शत्रवः ।\nकथं स वीरः श्रियमङ्ग दुस्त्यजां\nयुवैषतोत् स्रष्टुमहो सहासुभिः",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-4-12",
      "sequence": 112,
      "chapter": 4,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.12",
      "original": "शिवाय लोकस्य भवाय भूतये\nय उत्तमश्लोकपरायणा जनाः ।\nजीवन्ति नात्मार्थमसौ पराश्रयं\nमुमोच निर्विद्य कुतः कलेवरम्"
    },
    {
      "id": "bhagavatam-1-4-13",
      "sequence": 113,
      "chapter": 4,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.13",
      "original": "तत्सर्वं नः समाचक्ष्व पृष्टो यदिह किञ्चन ।\nमन्ये त्वां विषये वाचां स्नातमन्यत्र छान्दसात्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-4-14",
      "sequence": 114,
      "chapter": 4,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.14",
      "original": "सूत उवाच\nद्वापरे समनुप्राप्ते तृतीये युगपर्यये ।\nजातः पराशराद् योगी वासव्यां कलया हरेः"
    },
    {
      "id": "bhagavatam-1-4-15",
      "sequence": 115,
      "chapter": 4,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.15",
      "original": "स कदाचित् सरस्वत्या उपस्पृश्य जलं शुचिः ।\nविविक्तदेश आसीन उदिते रविमण्डले"
    },
    {
      "id": "bhagavatam-1-4-16",
      "sequence": 116,
      "chapter": 4,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.16",
      "original": "परावरज्ञः स ऋषिः कालेनाव्यक्तरंहसा ।\nयुगधर्मव्यतिकरं प्राप्तं भुवि युगे युगे"
    },
    {
      "id": "bhagavatam-1-4-17",
      "sequence": 117,
      "chapter": 4,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.17",
      "original": "भौतिकानां च भावानां शक्तिह्रासं च तत्कृतम् ।\nअश्रद्दधानान्निःसत्त्वान् दुर्मेधान् ह्रसितायुषः"
    },
    {
      "id": "bhagavatam-1-4-18",
      "sequence": 118,
      "chapter": 4,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.18",
      "original": "दुर्भगांश्च जनान् वीक्ष्य मुनिर्दिव्येन चक्षुषा ।\nसर्ववर्णाश्रमाणां यद् दध्यौ हितममोघदृक्"
    },
    {
      "id": "bhagavatam-1-4-19",
      "sequence": 119,
      "chapter": 4,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.19",
      "original": "चातुर्होत्रं कर्म शुद्धं प्रजानां वीक्ष्य वैदिकम् ।\nव्यदधाद् यज्ञसन्तत्यै वेदमेकं चतुर्विधम्"
    },
    {
      "id": "bhagavatam-1-4-20",
      "sequence": 120,
      "chapter": 4,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.20",
      "original": "ऋग्यजुःसामाथर्वाख्या वेदाश्चत्वार उद्धृताः ।\nइतिहासपुराणं च पञ्चमो वेद उच्यते"
    },
    {
      "id": "bhagavatam-1-4-21",
      "sequence": 121,
      "chapter": 4,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.21",
      "original": "तत्रर्ग्वेदधरः पैलः सामगो जैमिनिः कविः ।\nवैशंपायन एवैको निष्णातो यजुषामुत"
    },
    {
      "id": "bhagavatam-1-4-22",
      "sequence": 122,
      "chapter": 4,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.22",
      "original": "अथर्वाङ्‌गिरसामासीत् सुमन्तुर्दारुणो मुनिः ।\nइतिहासपुराणानां पिता मे रोमहर्षणः"
    },
    {
      "id": "bhagavatam-1-4-23",
      "sequence": 123,
      "chapter": 4,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.23",
      "original": "त एत ऋषयो वेदं स्वं स्वं व्यस्यन्ननेकधा ।\nशिष्यैः प्रशिष्यैः तत् शिष्यैः वेदास्ते शाखिनोऽभवन्"
    },
    {
      "id": "bhagavatam-1-4-24",
      "sequence": 124,
      "chapter": 4,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.24",
      "original": "त एव वेदा दुर्मेधैः धार्यन्ते पुरुषैर्यथा ।\nएवं चकार भगवान् व्यासः कृपणवत्सलः"
    },
    {
      "id": "bhagavatam-1-4-25",
      "sequence": 125,
      "chapter": 4,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.25",
      "original": "स्त्रीशूद्रद्विजबंधूनां त्रयी न श्रुतिगोचरा ।\nकर्मश्रेयसि मूढानां श्रेय एवं भवेदिह ।\nइति भारतमाख्यानं कृपया मुनिना कृतम्"
    },
    {
      "id": "bhagavatam-1-4-26",
      "sequence": 126,
      "chapter": 4,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.26",
      "original": "एवं प्रवृत्तस्य सदा भूतानां श्रेयसि द्विजाः ।\nसर्वात्मकेनापि यदा नातुष्यत् हृदयं ततः"
    },
    {
      "id": "bhagavatam-1-4-27",
      "sequence": 127,
      "chapter": 4,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.27",
      "original": "नातिप्रसीदद् हृदयः सरस्वत्यास्तटे शुचौ ।\nवितर्कयन् विविक्तस्थ इदं प्रोवाच धर्मवित्"
    },
    {
      "id": "bhagavatam-1-4-28",
      "sequence": 128,
      "chapter": 4,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.28",
      "original": "धृतव्रतेन हि मया छन्दांसि गुरवोऽग्नयः ।\nमानिता निर्व्यलीकेन गृहीतं चानुशासनम्"
    },
    {
      "id": "bhagavatam-1-4-29",
      "sequence": 129,
      "chapter": 4,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.29",
      "original": "भारतव्यपदेशेन ह्याम्नायार्थश्च दर्शितः ।\nदृश्यते यत्र धर्मादि स्त्रीशूद्रादिभिरप्युत"
    },
    {
      "id": "bhagavatam-1-4-30",
      "sequence": 130,
      "chapter": 4,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.30",
      "original": "तथापि बत मे दैह्यो ह्यात्मा चैवात्मना विभुः ।\nअसंपम्पन्न इवाभाति ब्रह्मवर्चस्य सत्तमः"
    },
    {
      "id": "bhagavatam-1-4-31",
      "sequence": 131,
      "chapter": 4,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.31",
      "original": "किं वा भागवता धर्मा न प्रायेण निरूपिताः ।\nप्रियाः परमहंसानां त एव ह्यच्युतप्रियाः"
    },
    {
      "id": "bhagavatam-1-4-32",
      "sequence": 132,
      "chapter": 4,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.32",
      "original": "तस्यैवं खिलमात्मानं मन्यमानस्य खिद्यतः ।\nकृष्णस्य नारदोऽभ्यागाद् आश्रमं प्रागुदाहृतम्"
    },
    {
      "id": "bhagavatam-1-4-33",
      "sequence": 133,
      "chapter": 4,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 04",
      "label": "1.4.33",
      "original": "तमभिज्ञाय सहसा प्रत्युत्थायागतं मुनिः ।\nपूजयामास विधिवत् नारदं सुरपूजितम्"
    }
  ]
}
