  "entries": [
    {
      "id": "bhagavatam-1-17-1",
      "sequence": 673,
      "chapter": 17,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.1",
      "original": "सूत उवाच\nतत्र गोमिथुनं राजा हन्यमानमनाथवत् ।\nदण्डहस्तं च वृषलं ददृशे नृपलाञ्छनम्"
    },
    {
      "id": "bhagavatam-1-17-2",
      "sequence": 674,
      "chapter": 17,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.2",
      "original": "वृषं मृणालधवलं मेहन्तमिव बिभ्यतम्  ।\nवेपमानं पदैकेन सीदन्तं शूद्रताडितम्"
    },
    {
      "id": "bhagavatam-1-17-3",
      "sequence": 675,
      "chapter": 17,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.3",
      "original": "गां च घर्मदुघां दीनां भृशं शूद्रपदाहताम्  ।\nविवत्सामाश्रुवदनां क्षामां यवसमिच्छतीम्"
    },
    {
      "id": "bhagavatam-1-17-4",
      "sequence": 676,
      "chapter": 17,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.4",
      "original": "पप्रच्छ रथमारूढः कार्तस्वरपरिच्छदम्  ।\nमेघगम्भीरया वाचा समारोपितकार्मुकः"
    },
    {
      "id": "bhagavatam-1-17-5",
      "sequence": 677,
      "chapter": 17,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.5",
      "original": "कस्त्वं मच्छरणे लोके बलाद्धंस्यबलान् बली  ।\nनरदेवोऽसि वेषेण नटवत्कर्मणाद्विजः"
    },
    {
      "id": "bhagavatam-1-17-6",
      "sequence": 678,
      "chapter": 17,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.6",
      "original": "यस्त्वं कृष्णे गते दूरं सहगाण्डीवधन्वना  ।\nशोच्योऽस्यशोच्यान् रहसि प्रहरन् वधमर्हसि"
    },
    {
      "id": "bhagavatam-1-17-7",
      "sequence": 679,
      "chapter": 17,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.7",
      "original": "त्वं वा मृणालधवलः पादैर्न्यूनः पदा चरन्  ।\nवृषरूपेण किं कश्चिद्देवो नः परिखेदयन्"
    },
    {
      "id": "bhagavatam-1-17-8",
      "sequence": 680,
      "chapter": 17,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.8",
      "original": "न जातु कौरवेन्द्राणां दोर्दण्डपरिरम्भिते  ।\nभूतलेऽनुपतन्त्यस्मिन् विना ते प्राणिनां शुचः"
    },
    {
      "id": "bhagavatam-1-17-9",
      "sequence": 681,
      "chapter": 17,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.9",
      "original": "मा सौरभेयात्र शुचो व्येतु ते वृषलाद्भयम्  ।\nमा रोदीरम्ब भद्रं ते खलानां मयि शास्तरि"
    },
    {
      "id": "bhagavatam-1-17-10",
      "sequence": 682,
      "chapter": 17,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.10",
      "original": "यस्य राष्ट्रे प्रजाः सर्वास्त्रस्यन्ते साध्व्यसाधुभिः  ।\nतस्य मत्तस्य नश्यन्ति कीर्तिरायुर्भगो गतिः"
    },
    {
      "id": "bhagavatam-1-17-11",
      "sequence": 683,
      "chapter": 17,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.11",
      "original": "एष राज्ञां परो धर्मो ह्यार्तानामार्तिनिग्रहः  ।\nअत एनं वधिष्यामि भूतद्रुहमसत्तमम्"
    },
    {
      "id": "bhagavatam-1-17-12",
      "sequence": 684,
      "chapter": 17,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.12",
      "original": "कोऽवृश्चत्तव पादांस्त्रीन् सौरभेय चतुष्पद  ।\nमा भूवंस्त्वादृशा राष्ट्रे राज्ञां कृष्णानुवर्तिनाम्"
    },
    {
      "id": "bhagavatam-1-17-13",
      "sequence": 685,
      "chapter": 17,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.13",
      "original": "आख्याहि वृष भद्रं वः साधूनामकृतागसाम्  ।\nआत्मवैरूप्यकर्तारं पार्थानां कीर्तिदूषणम्"
    },
    {
      "id": "bhagavatam-1-17-14",
      "sequence": 686,
      "chapter": 17,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.14",
      "original": "जनेऽनागस्यघं युञ्जन् सर्वतोऽस्य च मद्भयम्  ।\nसाधूनां भद्रमेव स्यादसाधुदमने कृते"
    },
    {
      "id": "bhagavatam-1-17-15",
      "sequence": 687,
      "chapter": 17,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.15",
      "original": "अनागःस्विह भूतेषु य आगस्कृन्निरङ्कुशः  ।\nआहर्तास्मि भुजं साक्षादमर्त्यस्यापि साङ्गदम्"
    },
    {
      "id": "bhagavatam-1-17-16",
      "sequence": 688,
      "chapter": 17,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.16",
      "original": "राज्ञो हि परमो धर्मः स्वधर्मस्थानुपालनम्  ।\nशासतोऽन्यान् यथाशास्त्रमनापद्युत्पथानिह"
    },
    {
      "id": "bhagavatam-1-17-17",
      "sequence": 689,
      "chapter": 17,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.17",
      "original": "धर्म उवाच\nएतद्वः पाण्डवेयानां युक्तमार्ताभयं वचः  ।\nयेषां गुणगणैः कृष्णो दौत्यादौ भगवान् कृतः"
    },
    {
      "id": "bhagavatam-1-17-18",
      "sequence": 690,
      "chapter": 17,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.18",
      "original": "न वयं क्लेशबीजानि यतः स्युः पुरुषर्षभ  ।\nपुरुषं तं विजानीमो वाक्यभेदविमोहिताः"
    },
    {
      "id": "bhagavatam-1-17-19",
      "sequence": 691,
      "chapter": 17,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.19",
      "original": "केचिद्विकल्पवसना आहुरात्मानमात्मनः  ।\nदैवमन्येऽपरे कर्म स्वभावमपरे प्रभुम्"
    },
    {
      "id": "bhagavatam-1-17-20",
      "sequence": 692,
      "chapter": 17,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.20",
      "original": "अप्रतर्क्यादनिर्देश्यादिति केष्वपि निश्चयः  ।\nअत्रानुरूपं राजर्षे विमृश स्वमनीषया"
    },
    {
      "id": "bhagavatam-1-17-21",
      "sequence": 693,
      "chapter": 17,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.21",
      "original": "सूत उवाच\nएवं धर्मे प्रवदति स सम्राड्द्विजसत्तमाः  ।\nसमाहितेन मनसा विखेदः पर्यचष्ट तम्"
    },
    {
      "id": "bhagavatam-1-17-22",
      "sequence": 694,
      "chapter": 17,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.22",
      "original": "राजोवाच\nधर्मं ब्रवीषि धर्मज्ञ धर्मोऽसि वृषरूपधृक् ।\nयदधर्मकृतः स्थानं सूचकस्यापि तद्भवेत्"
    },
    {
      "id": "bhagavatam-1-17-23",
      "sequence": 695,
      "chapter": 17,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.23",
      "original": "अथवा देवमायाया नूनं गतिरगोचरा  ।\nचेतसो वचसश्चापि भूतानामिति निश्चयः"
    },
    {
      "id": "bhagavatam-1-17-24",
      "sequence": 696,
      "chapter": 17,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.24",
      "original": "तपः शौचं दया सत्यमिति पादाः कृते कृताः  ।\nअधर्मांशैस्त्रयो भग्नाः स्मयसङ्गमदैस्तव"
    },
    {
      "id": "bhagavatam-1-17-25",
      "sequence": 697,
      "chapter": 17,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.25",
      "original": "इदानीं धर्म पादस्ते सत्यं निर्वर्तयेद्यतः  ।\nतं जिघृक्षत्यधर्मोऽयमनृतेनैधितः कलिः"
    },
    {
      "id": "bhagavatam-1-17-26",
      "sequence": 698,
      "chapter": 17,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.26",
      "original": "इयं च भूमिर्भगवता न्यासितोरुभरा सती  ।\nश्रीमद्भिस्तत्पदन्यासैः सर्वतः कृतकौतुका"
    },
    {
      "id": "bhagavatam-1-17-27",
      "sequence": 699,
      "chapter": 17,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.27",
      "original": "शोचत्यश्रुकला साध्वी दुर्भगेवोज्झिता सती  ।\nअब्रह्मण्या नृपव्याजाः शूद्रा भोक्ष्यन्ति मामिति"
    },
    {
      "id": "bhagavatam-1-17-28",
      "sequence": 700,
      "chapter": 17,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.28",
      "original": "इति धर्मं महीं चैव सान्त्वयित्वा महारथः  ।\nनिशातमाददे खड्गं कलयेऽधर्महेतवे"
    },
    {
      "id": "bhagavatam-1-17-29",
      "sequence": 701,
      "chapter": 17,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.29",
      "original": "तं जिघांसुमभिप्रेत्य विहाय नृपलाञ्छनम्  ।\nतत्पादमूलं शिरसा समगाद्भयविह्वलः"
    },
    {
      "id": "bhagavatam-1-17-30",
      "sequence": 702,
      "chapter": 17,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.30",
      "original": "पतितं पादयोर्वीरः कृपया दीनवत्सलः  ।\nशरण्यो नावधीच्छ्लोक्य आह चेदं हसन्निव"
    },
    {
      "id": "bhagavatam-1-17-31",
      "sequence": 703,
      "chapter": 17,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.31",
      "original": "राजोवाच\nन ते गुडाकेशयशोधराणां बद्धाञ्जलेर्वै भयमस्ति किञ्चित् ।\nन वर्तितव्यं भवता कथञ्चन क्षेत्रे मदीये त्वमधर्मबन्धुः"
    },
    {
      "id": "bhagavatam-1-17-32",
      "sequence": 704,
      "chapter": 17,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.32",
      "original": "त्वां वर्तमानं नरदेवदेहेष्वनुप्रवृत्तोऽयमधर्मपूगः  ।\nलोभोऽनृतं चौर्यमनार्यमंहो ज्येष्ठा च माया कलहश्च दम्भः"
    },
    {
      "id": "bhagavatam-1-17-33",
      "sequence": 705,
      "chapter": 17,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.33",
      "original": "न वर्तितव्यं तदधर्मबन्धो धर्मेण सत्येन च वर्तितव्ये  ।\nब्रह्मावर्ते यत्र यजन्ति यज्ञैर्यज्ञेश्वरं यज्ञवितानविज्ञाः"
    },
    {
      "id": "bhagavatam-1-17-34",
      "sequence": 706,
      "chapter": 17,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.34",
      "original": "यस्मिन् हरिर्भगवानिज्यमान इज्यात्ममूर्तिर्यजतां शं तनोति  ।\nकामानमोघान् स्थिरजङ्गमानामन्तर्बहिर्वायुरिवैष आत्मा"
    },
    {
      "id": "bhagavatam-1-17-35",
      "sequence": 707,
      "chapter": 17,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.35",
      "original": "सूत उवाच\nपरीक्षितैवमादिष्टः स कलिर्जातवेपथुः  ।\nतमुद्यतासिमाहेदं दण्डपाणिमिवोद्यतम्"
    },
    {
      "id": "bhagavatam-1-17-36",
      "sequence": 708,
      "chapter": 17,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.36",
      "original": "कलिरुवाच\nयत्र क्व वाथ वत्स्यामि सार्वभौम तवाज्ञया  ।\nलक्षये तत्र तत्रापि त्वामात्तेषुशरासनम्"
    },
    {
      "id": "bhagavatam-1-17-37",
      "sequence": 709,
      "chapter": 17,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.37",
      "original": "तन्मे धर्मभृतां श्रेष्ठ स्थानं निर्देष्टुमर्हसि  ।\nयत्रैव नियतो वत्स्य आतिष्ठंस्तेऽनुशासनम्"
    },
    {
      "id": "bhagavatam-1-17-38",
      "sequence": 710,
      "chapter": 17,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.38",
      "original": "सूत उवाच\nअभ्यर्थितस्तदा तस्मै स्थानानि कलये ददौ  ।\nद्यूतं पानं स्त्रियः सूना यत्राधर्मश्चतुर्विधः"
    },
    {
      "id": "bhagavatam-1-17-39",
      "sequence": 711,
      "chapter": 17,
      "sourceIndex": 39,
      "verse": 39,
      "section": "Skandha 1, Chapter 17",
      "label": "1.17.39",
      "original": "पुनश्च याचमानाय जातरूपमदात्प्रभुः  ।\nततोऽनृतं मदं कामं रजो वैरं च पञ्चमम्"
    },
    {
      "id": "bhagavatam-1-17-40",
      "sequence": 712,
      "chapter": 17,
      "sourceIndex": 40,
      "verse": 40,
