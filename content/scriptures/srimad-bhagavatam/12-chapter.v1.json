    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-12-1",
      "sequence": 446,
      "chapter": 12,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.1",
      "original": "शौनक उवाच ।\nअश्वत्थाम्नोपसृष्टेन ब्रह्मशीर्ष्णोरुतेजसा ।\nउत्तराया हतो गर्भ ईशेनाजीवितः पुनः"
    },
    {
      "id": "bhagavatam-1-12-2",
      "sequence": 447,
      "chapter": 12,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.2",
      "original": "तस्य जन्म महाबुद्धेः कर्माणि च महात्मनः ।\nनिधनं च यथैवासीत् स प्रेत्य गतवान् यथा"
    },
    {
      "id": "bhagavatam-1-12-3",
      "sequence": 448,
      "chapter": 12,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.3",
      "original": "तदिदं श्रोतुमिच्छामो गदितुं यदि मन्यसे ।\nब्रूहि नः श्रद्दधानानां यस्य ज्ञानमदाच्छुकः"
    },
    {
      "id": "bhagavatam-1-12-4",
      "sequence": 449,
      "chapter": 12,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.4",
      "original": "सूत उवाच ।\nअपीपलद्धर्मराजः पितृवद् रञ्जयन् प्रजाः ।\nनिःस्पृहः सर्वकामेभ्यः कृष्णपादानुसेवया"
    },
    {
      "id": "bhagavatam-1-12-5",
      "sequence": 450,
      "chapter": 12,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.5",
      "original": "सम्पदः क्रतवो लोका महिषी भ्रातरो मही ।\nजम्बूद्वीपाधिपत्यं च यशश्च त्रिदिवं गतम्"
    },
    {
      "id": "bhagavatam-1-12-6",
      "sequence": 451,
      "chapter": 12,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.6",
      "original": "किं ते कामाः सुरस्पार्हा मुकुन्दमनसो द्विजाः ।\nअधिजह्रुर्मुदं राज्ञः क्षुधितस्य यथेतरे"
    },
    {
      "id": "bhagavatam-1-12-7",
      "sequence": 452,
      "chapter": 12,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.7",
      "original": "मातुर्गर्भगतो वीरः स तदा भृगुनन्दन ।\nददर्श पुरुषं कञ्चिद् दह्यमानोऽस्त्रतेजसा"
    },
    {
      "id": "bhagavatam-1-12-8",
      "sequence": 453,
      "chapter": 12,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.8",
      "original": "अङ्‌गुष्ठमात्रममलं स्फुरत् पुरट मौलिनम् ।\nअपीव्यदर्शनं श्यामं तडिद् वाससमच्युतम्"
    },
    {
      "id": "bhagavatam-1-12-9",
      "sequence": 454,
      "chapter": 12,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.9",
      "original": "श्रीमद् दीर्घचतुर्बाहुं तप्तकाञ्चन कुण्डलम् ।\nक्षतजाक्षं गदापाणिं आत्मनः सर्वतो दिशम् ।\nपरिभ्रमन्तं उल्काभां भ्रामयन्तं गदां मुहुः"
    },
    {
      "id": "bhagavatam-1-12-10",
      "sequence": 455,
      "chapter": 12,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.10",
      "original": "अस्त्रतेजः स्वगदया नीहारमिव गोपतिः ।\nविधमन्तं सन्निकर्षे पर्यैक्षत क इत्यसौ"
    },
    {
      "id": "bhagavatam-1-12-11",
      "sequence": 456,
      "chapter": 12,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.11",
      "original": "विधूय तदमेयात्मा भगवान् धर्मगुब् विभुः ।\nमिषतो दशमासस्य तत्रैवान्तर्दधे हरिः"
    },
    {
      "id": "bhagavatam-1-12-12",
      "sequence": 457,
      "chapter": 12,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.12",
      "original": "ततः सर्वगुणोदर्के सानुकूल ग्रहोदये ।\nजज्ञे वंशधरः पाण्डोः भूयः पाण्डुरिवौजसा"
    },
    {
      "id": "bhagavatam-1-12-13",
      "sequence": 458,
      "chapter": 12,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.13",
      "original": "तस्य प्रीतमना राजा विप्रैर्धौम्य कृपादिभिः ।\nजातकं कारयामास वाचयित्वा च मङ्‌गलम्"
    },
    {
      "id": "bhagavatam-1-12-14",
      "sequence": 459,
      "chapter": 12,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.14",
      "original": "हिरण्यं गां महीं ग्रामान् हस्त्यश्वान् नृपतिर्वरान् ।\nप्रादात्स्वन्नं च विप्रेभ्यः प्रजातीर्थे स तीर्थवित्"
    },
    {
      "id": "bhagavatam-1-12-15",
      "sequence": 460,
      "chapter": 12,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.15",
      "original": "तमूचुर्ब्राह्मणास्तुष्टा राजानं प्रश्रयान्वितम् ।\nएष ह्यस्मिन् प्रजातन्तौ पुरूणां पौरवर्षभ"
    },
    {
      "id": "bhagavatam-1-12-16",
      "sequence": 461,
      "chapter": 12,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.16",
      "original": "दैवेनाप्रतिघातेन शुक्ले संस्थामुपेयुषि ।\nरातो वोऽनुग्रहार्थाय विष्णुना प्रभविष्णुना"
    },
    {
      "id": "bhagavatam-1-12-17",
      "sequence": 462,
      "chapter": 12,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.17",
      "original": "तस्मान्नाम्ना विष्णुरात इति लोके बृहच्छ्रवाः ।\nभविष्यति न सन्देहो महाभागवतो महान्"
    },
    {
      "id": "bhagavatam-1-12-18",
      "sequence": 463,
      "chapter": 12,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.18",
      "original": "युधिष्ठिर उवाच ।\nअप्येष वंश्यान् राजर्षीन् पुण्यश्लोकान् महात्मनः ।\nअनुवर्तिता स्विद्यशसा साधुवादेन सत्तमाः"
    },
    {
      "id": "bhagavatam-1-12-19",
      "sequence": 464,
      "chapter": 12,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.19",
      "original": "ब्राह्मणा ऊचुः ।\nपार्थ प्रजाविता साक्षात् इक्ष्वाकुरिव मानवः ।\nब्रह्मण्यः सत्यसन्धश्च रामो दाशरथिर्यथा"
    },
    {
      "id": "bhagavatam-1-12-20",
      "sequence": 465,
      "chapter": 12,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.20",
      "original": "एष दाता शरण्यश्च यथा ह्यौशीनरः शिबिः ।\nयशो वितनिता स्वानां दौष्यन्तिरिव यज्वनाम्"
    },
    {
      "id": "bhagavatam-1-12-21",
      "sequence": 466,
      "chapter": 12,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.21",
      "original": "धन्विनामग्रणीरेष तुल्यश्चार्जुनयोर्द्वयोः ।\nहुताश इव दुर्धर्षः समुद्र इव दुस्तरः"
    },
    {
      "id": "bhagavatam-1-12-22",
      "sequence": 467,
      "chapter": 12,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.22",
      "original": "मृगेन्द्र इव विक्रान्तो निषेव्यो हिमवानिव ।\nतितिक्षुर्वसुधेवासौ सहिष्णुः पितराविव"
    },
    {
      "id": "bhagavatam-1-12-23",
      "sequence": 468,
      "chapter": 12,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.23",
      "original": "पितामहसमः साम्ये प्रसादे गिरिशोपमः ।\nआश्रयः सर्वभूतानां यथा देवो रमाश्रयः"
    },
    {
      "id": "bhagavatam-1-12-24",
      "sequence": 469,
      "chapter": 12,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.24",
      "original": "सर्वसद्‍गुणमाहात्म्ये एष कृष्णमनुव्रतः ।\nरन्तिदेव इवोदारो ययातिरिव धार्मिकः"
    },
    {
      "id": "bhagavatam-1-12-25",
      "sequence": 470,
      "chapter": 12,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.25",
      "original": "धृत्या बलिसमः कृष्णे प्रह्राद इव सद्‍ग्रहः ।\nआहर्तैषोऽश्वमेधानां वृद्धानां पर्युपासकः"
    },
    {
      "id": "bhagavatam-1-12-26",
      "sequence": 471,
      "chapter": 12,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.26",
      "original": "राजर्षीणां जनयिता शास्ता चोत्पथगामिनाम् ।\nनिग्रहीता कलेरेष भुवो धर्मस्य कारणात्"
    },
    {
      "id": "bhagavatam-1-12-27",
      "sequence": 472,
      "chapter": 12,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.27",
      "original": "तक्षकादात्मनो मृत्युं द्विजपुत्रोपसर्जितात् ।\nप्रपत्स्यत उपश्रुत्य मुक्तसङ्‌गः पदं हरेः"
    },
    {
      "id": "bhagavatam-1-12-28",
      "sequence": 473,
      "chapter": 12,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.28",
      "original": "जिज्ञासितात्म याथार्थ्यो मुनेर्व्याससुतादसौ ।\nहित्वेदं नृप गङ्‌गायां यास्यत्यद्धा अकुतोभयम्"
    },
    {
      "id": "bhagavatam-1-12-29",
      "sequence": 474,
      "chapter": 12,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.29",
      "original": "इति राज्ञ उपादिश्य विप्रा जातककोविदाः ।\nलब्धापचितयः सर्वे प्रतिजग्मुः स्वकान् गृहान्"
    },
    {
      "id": "bhagavatam-1-12-30",
      "sequence": 475,
      "chapter": 12,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.30",
      "original": "स एष लोके विख्यातः परीक्षिदिति यत्प्रभुः ।\nपूर्वं दृष्टमनुध्यायन् परीक्षेत नरेष्विह"
    },
    {
      "id": "bhagavatam-1-12-31",
      "sequence": 476,
      "chapter": 12,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.31",
      "original": "स राजपुत्रो ववृधे आशु शुक्ल इवोडुपः ।\nआपूर्यमाणः पितृभिः काष्ठाभिरिव सोऽन्वहम्"
    },
    {
      "id": "bhagavatam-1-12-32",
      "sequence": 477,
      "chapter": 12,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.32",
      "original": "यक्ष्यमाणोऽश्वमेधेन ज्ञातिद्रोहजिहासया ।\nराजा लब्धधनो दध्यौ अन्यत्र करदण्डयोः"
    },
    {
      "id": "bhagavatam-1-12-33",
      "sequence": 478,
      "chapter": 12,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.33",
      "original": "तदभिप्रेतमालक्ष्य भ्रातरोऽच्युतचोदिताः ।\nधनं प्रहीणमाजह्रुः उदीच्यां दिशि भूरिशः"
    },
    {
      "id": "bhagavatam-1-12-34",
      "sequence": 479,
      "chapter": 12,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.34",
      "original": "तेन सम्भृतसम्भारो धर्मपुत्रो युधिष्ठिरः ।\nवाजिमेधैः त्रिभिर्भीतो यज्ञैः समयजत् हरिम्"
    },
    {
      "id": "bhagavatam-1-12-35",
      "sequence": 480,
      "chapter": 12,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.35",
      "original": "आहूतो भगवान् राज्ञा याजयित्वा द्विजैर्नृपम् ।\nउवास कतिचित् मासान् सुहृदां प्रियकाम्यया"
    },
    {
      "id": "bhagavatam-1-12-36",
      "sequence": 481,
      "chapter": 12,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 12",
      "label": "1.12.36",
      "original": "ततो राज्ञाभ्यनुज्ञातः कृष्णया सहबन्धुभिः ।\nययौ द्वारवतीं ब्रह्मन् सार्जुनो यदुभिर्वृतः"
    }
  ]
}
