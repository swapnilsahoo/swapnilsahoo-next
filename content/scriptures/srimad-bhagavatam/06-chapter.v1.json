    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%AC&oldid=110177",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-6-1",
      "sequence": 174,
      "chapter": 6,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.1",
      "original": "सूत उवाच ।\nएवं निशम्य भगवान् देवर्षेर्जन्म कर्म च ।\nभूयः पप्रच्छ तं ब्रह्मन् व्यासः सत्यवतीसुतः ॥",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-6-2",
      "sequence": 175,
      "chapter": 6,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.2",
      "original": "व्यास उवाच ।\nभिक्षुभिर्विप्रवसिते विज्ञानादेष्टृभिस्तव ।\nवर्तमानो वयस्याद्ये ततः किमकरोद्‍भवान् ॥"
    },
    {
      "id": "bhagavatam-1-6-3",
      "sequence": 176,
      "chapter": 6,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.3",
      "original": "स्वायंभुव कया वृत्त्या वर्तितं ते परं वयः ।\nकथं चेदमुदस्राक्षीः काले प्राप्ते कलेवरम् ॥"
    },
    {
      "id": "bhagavatam-1-6-4",
      "sequence": 177,
      "chapter": 6,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.4",
      "original": "प्राक्कल्पविषयामेतां स्मृतिं ते सुरसत्तम ।\nन ह्येष व्यवधात्काल एष सर्वनिराकृतिः ॥"
    },
    {
      "id": "bhagavatam-1-6-5",
      "sequence": 178,
      "chapter": 6,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.5",
      "original": "नारद उवाच ।\nभिक्षुभिर्विप्रवसिते विज्ञानादेष्टृभिर्मम ।\nवर्तमानो वयस्याद्ये तत एतदकारषम् ॥"
    },
    {
      "id": "bhagavatam-1-6-6",
      "sequence": 179,
      "chapter": 6,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.6",
      "original": "एकात्मजा मे जननी योषिन्मूढा च किङ्करी ।\nमय्यात्मजेऽनन्यगतौ चक्रे स्नेहानुबंधनम् ॥"
    },
    {
      "id": "bhagavatam-1-6-7",
      "sequence": 180,
      "chapter": 6,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.7",
      "original": "सास्वतंत्रा न कल्पासीद् योगक्षेमं ममेच्छती ।\nईशस्य हि वशे लोको योषा दारुमयी यथा ॥"
    },
    {
      "id": "bhagavatam-1-6-8",
      "sequence": 181,
      "chapter": 6,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.8",
      "original": "अहं च तद्‍ब्रह्मकुले ऊषिवांस्तदपेक्षया ।\nदिग्देशकालाव्युत्पन्नो बालकः पञ्चहायनः ॥"
    },
    {
      "id": "bhagavatam-1-6-9",
      "sequence": 182,
      "chapter": 6,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.9",
      "original": "एकदा निर्गतां गेहाद् दुहन्तीं निशि गां पथि ।\nसर्पोऽदशत्पदा स्पृष्टः कृपणां कालचोदितः"
    },
    {
      "id": "bhagavatam-1-6-10",
      "sequence": 183,
      "chapter": 6,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.10",
      "original": "तदा तदहमीशस्य भक्तानां शमभीप्सतः ।\nअनुग्रहं मन्यमानः प्रातिष्ठं दिशमुत्तराम्"
    },
    {
      "id": "bhagavatam-1-6-11",
      "sequence": 184,
      "chapter": 6,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.11",
      "original": "स्फीताञ्जनपदांस्तत्र पुरग्रामव्रजाकरान् ।\nखेटखर्वटवाटीश्च वनान्युपवनानि च"
    },
    {
      "id": "bhagavatam-1-6-12",
      "sequence": 185,
      "chapter": 6,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.12",
      "original": "चित्रधातुविचित्राद्रीन् इभभग्नभुजद्रुमान् ।\nजलाशयान् शिवजलान् नलिनीः सुरसेविताः"
    },
    {
      "id": "bhagavatam-1-6-13",
      "sequence": 186,
      "chapter": 6,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.13",
      "original": "चित्रस्वनैः पत्ररथैः विभ्रमद् भ्रमरश्रियः ।\nनलवेणुशरस्तम्ब कुशकीचकगह्वरम्"
    },
    {
      "id": "bhagavatam-1-6-14",
      "sequence": 187,
      "chapter": 6,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.14",
      "original": "एक एवातियातोऽहं अद्राक्षं विपिनं महत् ।\nघोरं प्रतिभयाकारं व्यालोलूकशिवाजिरम्"
    },
    {
      "id": "bhagavatam-1-6-15",
      "sequence": 188,
      "chapter": 6,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.15",
      "original": "परिश्रान्तेन्द्रियात्माहं तृट्परीतो बुभुक्षितः ।\nस्नात्वा पीत्वा ह्रदे नद्या उपस्पृष्टो गतश्रमः"
    },
    {
      "id": "bhagavatam-1-6-16",
      "sequence": 189,
      "chapter": 6,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.16",
      "original": "तस्मिन्निर्मनुजेऽरण्ये पिप्पलोपस्थ आश्रितः ।\nआत्मनात्मानमात्मस्थं यथाश्रुतमचिन्तयम्"
    },
    {
      "id": "bhagavatam-1-6-17",
      "sequence": 190,
      "chapter": 6,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.17",
      "original": "ध्यायतश्चरणांभोजं भावनिर्जितचेतसा ।\nऔत्कण्ठ्याश्रुकलाक्षस्य हृद्यासीन्मे शनैर्हरिः"
    },
    {
      "id": "bhagavatam-1-6-18",
      "sequence": 191,
      "chapter": 6,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.18",
      "original": "प्रेमातिभरनिर्भिन्न पुलकाङ्गोऽतिनिर्वृतः ।\nआनंदसंप्लवे लीनो नापश्यमुभयं मुने"
    },
    {
      "id": "bhagavatam-1-6-19",
      "sequence": 192,
      "chapter": 6,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.19",
      "original": "रूपं भगवतो यत्तन् मनःकान्तं शुचापहम् ।\nअपश्यन् सहसोत्तस्थे वैक्लव्याद् दुर्मना इव"
    },
    {
      "id": "bhagavatam-1-6-20",
      "sequence": 193,
      "chapter": 6,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.20",
      "original": "दिदृक्षुस्तदहं भूयः प्रणिधाय मनो हृदि ।\nवीक्षमाणोऽपि नापश्यं अवितृप्त इवातुरः"
    },
    {
      "id": "bhagavatam-1-6-21",
      "sequence": 194,
      "chapter": 6,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.21",
      "original": "एवं यतन्तं विजने मामाहागोचरो गिराम् ।\nगंभीरश्लक्ष्णया वाचा शुचः प्रशमयन्निव"
    },
    {
      "id": "bhagavatam-1-6-22",
      "sequence": 195,
      "chapter": 6,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.22",
      "original": "हन्तास्मिन् जन्मनि भवान् मा मां द्रष्टुमिहार्हति ।\nअविपक्वकषायाणां दुर्दर्शोऽहं कुयोगिनाम्"
    },
    {
      "id": "bhagavatam-1-6-23",
      "sequence": 196,
      "chapter": 6,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.23",
      "original": "सकृद् यद् दर्शितं रूपं एतत्कामाय तेऽनघ ।\nमत्कामः शनकैः साधु सर्वान् मुञ्चति हृच्छयान्"
    },
    {
      "id": "bhagavatam-1-6-24",
      "sequence": 197,
      "chapter": 6,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.24",
      "original": "सत्सेवयाऽदीर्घया ते जाता मयि दृढा मतिः ।\nहित्वावद्यमिमं लोकं गन्ता मज्जनतामसि"
    },
    {
      "id": "bhagavatam-1-6-25",
      "sequence": 198,
      "chapter": 6,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.25",
      "original": "मतिर्मयि निबद्धेयं न विपद्येत कर्हिचित् ।\nप्रजासर्गनिरोधेऽपि स्मृतिश्च मदनुग्रहात्"
    },
    {
      "id": "bhagavatam-1-6-26",
      "sequence": 199,
      "chapter": 6,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.26",
      "original": "एतावदुक्त्वोपरराम तन्महद्\nभूतं नभोलिङ्गमलिङ्गमीश्वरम् ।\nअहं च तस्मै महतां महीयसे\nशीर्ष्णावनामं विदधेऽनुकंपितः",
      "meter": "इंद्रवंशा"
    },
    {
      "id": "bhagavatam-1-6-27",
      "sequence": 200,
      "chapter": 6,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.27",
      "original": "नामान्यनन्तस्य हतत्रपः पठन्\nगुह्यानि भद्राणि कृतानि च स्मरन् ।\nगां पर्यटन् तुष्टमना गतस्पृहः\nकालं प्रतीक्षन् विमदो विमत्सरः"
    },
    {
      "id": "bhagavatam-1-6-28",
      "sequence": 201,
      "chapter": 6,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.28",
      "original": "एवं कृष्णमतेर्ब्रह्मन् असक्तस्यामलात्मनः ।\nकालः प्रादुरभूत्काले तडित्सौदामनी यथा",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-6-29",
      "sequence": 202,
      "chapter": 6,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.29",
      "original": "प्रयुज्यमाने मयि तां शुद्धां भागवतीं तनुम् ।\nआरब्धकर्मनिर्वाणो न्यपतत् पांचभौतिकः"
    },
    {
      "id": "bhagavatam-1-6-30",
      "sequence": 203,
      "chapter": 6,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.30",
      "original": "कल्पान्त इदमादाय शयानेऽम्भस्युदन्वतः ।\nशिशयिषोरनुप्राणं विविशेऽन्तरहं विभोः"
    },
    {
      "id": "bhagavatam-1-6-31",
      "sequence": 204,
      "chapter": 6,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.31",
      "original": "सहस्रयुगपर्यन्ते उत्थायेदं सिसृक्षतः ।\nमरीचिमिश्रा ऋषयः प्राणेभ्योऽहं च जज्ञिरे"
    },
    {
      "id": "bhagavatam-1-6-32",
      "sequence": 205,
      "chapter": 6,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.32",
      "original": "अंतर्बहिश्च लोकान् त्रीन् पर्येम्यस्कन्दितव्रतः ।\nअनुग्रहात् महाविष्णोः अविघातगतिः क्वचित्"
    },
    {
      "id": "bhagavatam-1-6-33",
      "sequence": 206,
      "chapter": 6,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.33",
      "original": "देवदत्तामिमां वीणां स्वरब्रह्मविभूषिताम् ।\nमूर्च्छयित्वा हरिकथां गायमानश्चराम्यहम्"
    },
    {
      "id": "bhagavatam-1-6-34",
      "sequence": 207,
      "chapter": 6,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.34",
      "original": "प्रगायतः स्ववीर्याणि तीर्थपादः प्रियश्रवाः ।\nआहूत इव मे शीघ्रं दर्शनं याति चेतसि"
    },
    {
      "id": "bhagavatam-1-6-35",
      "sequence": 208,
      "chapter": 6,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.35",
      "original": "एतद्ध्यातुरचित्तानां मात्रास्पर्शेच्छया मुहुः ।\nभवसिन्धुप्लवो दृष्टो हरिचर्यानुवर्णनम्"
    },
    {
      "id": "bhagavatam-1-6-36",
      "sequence": 209,
      "chapter": 6,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.36",
      "original": "यमादिभिर्योगपथैः कामलोभहतो मुहुः ।\nमुकुंदसेवया यद्वत् तथात्माद्धा न शाम्यति"
    },
    {
      "id": "bhagavatam-1-6-37",
      "sequence": 210,
      "chapter": 6,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.37",
      "original": "सर्वं तदिदमाख्यातं यत्पृष्टोऽहं त्वयानघ ।\nजन्मकर्मरहस्यं मे भवतश्चात्मतोषणम्"
    },
    {
      "id": "bhagavatam-1-6-38",
      "sequence": 211,
      "chapter": 6,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.38",
      "original": "सूत उवाच ।\nएवं संभाष्य भगवान् नारदो वासवीसुतम् ।\nआमंत्र्य वीणां रणयन् ययौ यादृच्छिको मुनिः"
    },
    {
      "id": "bhagavatam-1-6-39",
      "sequence": 212,
      "chapter": 6,
      "sourceIndex": 39,
      "verse": 39,
      "section": "Skandha 1, Chapter 06",
      "label": "1.6.39",
      "original": "अहो देवर्षिर्धन्योऽयं यत्कीर्तिं शार्ङ्गधन्वनः ।\nगायन्माद्यन्निदं तंत्र्या रमयत्यातुरं जगत्"
    }
  ]
}
