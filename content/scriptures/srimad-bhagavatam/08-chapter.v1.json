  },
  "entries": [
    {
      "id": "bhagavatam-1-8-1",
      "sequence": 270,
      "chapter": 8,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.1",
      "original": "सूत उवाच ।\nअथ ते सम्परेतानां स्वानामुदकमिच्छताम् ।\nदातुं सकृष्णा गङ्गायां पुरस्कृत्य ययुः स्त्रियः ॥",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-8-2",
      "sequence": 271,
      "chapter": 8,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.2",
      "original": "ते निनीयोदकं सर्वे विलप्य च भृशं पुनः ।\nआप्लुता हरिपादाब्जः अजःपूतसरिज्जले ॥"
    },
    {
      "id": "bhagavatam-1-8-3",
      "sequence": 272,
      "chapter": 8,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.3",
      "original": "तत्रासीनं कुरुपतिं धृतराष्ट्रं सहानुजम् ।\nगान्धारीं पुत्रशोकार्तां पृथां कृष्णां च माधवः ॥"
    },
    {
      "id": "bhagavatam-1-8-4",
      "sequence": 273,
      "chapter": 8,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.4",
      "original": "सांत्वयामास मुनिभिः हतबंधून् शुचार्पितान् ।\nभूतेषु कालस्य गतिं दर्शयन् अप्रतिक्रियाम् ॥"
    },
    {
      "id": "bhagavatam-1-8-5",
      "sequence": 274,
      "chapter": 8,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.5",
      "original": "साधयित्वाजातशत्रोः स्वं राज्यं कितवैर्हृतम् ।\nघातयित्वासतो राज्ञः कचस्पर्शक्षतायुषः ॥"
    },
    {
      "id": "bhagavatam-1-8-6",
      "sequence": 275,
      "chapter": 8,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.6",
      "original": "याजयित्वाश्वमेधैस्तं त्रिभिरुत्तमकल्पकैः ।\nतद्यशः पावनं दिक्षु शतमन्योरिवातनोत् ॥"
    },
    {
      "id": "bhagavatam-1-8-7",
      "sequence": 276,
      "chapter": 8,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.7",
      "original": "आमंत्र्य पाण्डुपुत्रांश्च शैनेयोद्धवसंयुतः ।\nद्वैपायनादिभिर्विप्रैः पूजितैः प्रतिपूजितः ॥"
    },
    {
      "id": "bhagavatam-1-8-8",
      "sequence": 277,
      "chapter": 8,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.8",
      "original": "गन्तुं कृतमतिर्ब्रह्मन् द्वारकां रथमास्थितः ।\nउपलेभेऽभिधावन्तीं उत्तरां भयविह्वलाम् ॥"
    },
    {
      "id": "bhagavatam-1-8-9",
      "sequence": 278,
      "chapter": 8,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.9",
      "original": "उत्तरोवाच\nपाहि पाहि महायोगिन् देवदेव जगत्पते ।\nनान्यं त्वदभयं पश्ये यत्र मृत्युः परस्परम्"
    },
    {
      "id": "bhagavatam-1-8-10",
      "sequence": 279,
      "chapter": 8,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.10",
      "original": "अभिद्रवति मामीश शरस्तप्तायसो विभो ।\nकामं दहतु मां नाथ मा मे गर्भो निपात्यताम्"
    },
    {
      "id": "bhagavatam-1-8-11",
      "sequence": 280,
      "chapter": 8,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.11",
      "original": "सूत उवाच ।\nउपधार्य वचस्तस्या भगवान् भक्तवत्सलः ।\nअपाण्डवमिदं कर्तुं द्रौणेरस्त्रमबुध्यत"
    },
    {
      "id": "bhagavatam-1-8-12",
      "sequence": 281,
      "chapter": 8,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.12",
      "original": "तर्ह्येवाथ मुनिश्रेष्ठ पाण्डवाः पञ्च सायकान् ।\nआत्मनोऽभिमुखान् दीप्तान् आलक्ष्यास्त्राण्युपाददुः"
    },
    {
      "id": "bhagavatam-1-8-13",
      "sequence": 282,
      "chapter": 8,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.13",
      "original": "व्यसनं वीक्ष्य तत्तेषां अनन्यविषयात्मनाम् ।\nसुदर्शनेन स्वास्त्रेण स्वानां रक्षां व्यधाद्विभुः"
    },
    {
      "id": "bhagavatam-1-8-14",
      "sequence": 283,
      "chapter": 8,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.14",
      "original": "अन्तःस्थः सर्वभूतानां आत्मा योगेश्वरो हरिः ।\nस्वमाययाऽऽवृणोद्‍गर्भं वैराट्याः कुरुतन्तवे"
    },
    {
      "id": "bhagavatam-1-8-15",
      "sequence": 284,
      "chapter": 8,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.15",
      "original": "यद्यप्यस्त्रं ब्रह्मशिरः त्वमोघं चाप्रतिक्रियम् ।\nवैष्णवं तेज आसाद्य समशाम्यद् भृगूद्वह"
    },
    {
      "id": "bhagavatam-1-8-16",
      "sequence": 285,
      "chapter": 8,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.16",
      "original": "मा मंस्था ह्येतदाश्चर्यं सर्वाश्चर्यमयेऽच्युते ।\nय इदं मायया देव्या सृजत्यवति हन्त्यजः"
    },
    {
      "id": "bhagavatam-1-8-17",
      "sequence": 286,
      "chapter": 8,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.17",
      "original": "ब्रह्मतेजोविनिर्मुक्तैः आत्मजैः सह कृष्णया ।\nप्रयाणाभिमुखं कृष्णं इदमाह पृथा सती"
    },
    {
      "id": "bhagavatam-1-8-18",
      "sequence": 287,
      "chapter": 8,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.18",
      "original": "कुन्त्युवाच ।\nनमस्ये पुरुषं त्वाऽऽद्यं ईश्वरं प्रकृतेः परम् ।\nअलक्ष्यं सर्वभूतानां अन्तर्बहिरवस्थितम्"
    },
    {
      "id": "bhagavatam-1-8-19",
      "sequence": 288,
      "chapter": 8,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.19",
      "original": "मायाजवनिकाच्छन्नं अज्ञाधोक्षजमव्ययम् ।\nन लक्ष्यसे मूढदृशा नटो नाट्यधरो यथा"
    },
    {
      "id": "bhagavatam-1-8-20",
      "sequence": 289,
      "chapter": 8,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.20",
      "original": "तथा परमहंसानां मुनीनां अमलात्मनाम् ।\nभक्तियोगविधानार्थं कथं पश्येम हि स्त्रियः"
    },
    {
      "id": "bhagavatam-1-8-21",
      "sequence": 290,
      "chapter": 8,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.21",
      "original": "कृष्णाय वासुदेवाय देवकीनंदनाय च ।\nनंदगोपकुमाराय गोविंदाय नमो नमः"
    },
    {
      "id": "bhagavatam-1-8-22",
      "sequence": 291,
      "chapter": 8,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.22",
      "original": "नमः पङ्कजनाभाय नमः पङ्कजमालिने ।\nनमः पङ्कजनेत्राय नमस्ते पङ्कजाङ्घ्रये"
    },
    {
      "id": "bhagavatam-1-8-23",
      "sequence": 292,
      "chapter": 8,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.23",
      "original": "यथा हृषीकेश खलेन देवकी\nकंसेन रुद्धातिचिरं शुचार्पिता ।\nविमोचिताहं च सहात्मजा विभो\nत्वयैव नाथेन मुहुर्विपद्‍गणात्",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-8-24",
      "sequence": 293,
      "chapter": 8,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.24",
      "original": "विषान्महाग्नेः पुरुषाददर्शनाद्\nअसत्सभाया वनवासकृच्छ्रतः ।\nमृधे मृधेऽनेकमहारथास्त्रतो\nद्रौण्यस्त्रतश्चास्म हरेऽभिरक्षिताः"
    },
    {
      "id": "bhagavatam-1-8-25",
      "sequence": 294,
      "chapter": 8,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.25",
      "original": "विपदः सन्तु ताः शश्वत् तत्र तत्र जगद्‍गुरो ।\nभवतो दर्शनं यत्स्याद् अपुनर्भवदर्शनम्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-8-26",
      "sequence": 295,
      "chapter": 8,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.26",
      "original": "जन्मैश्वर्यश्रुतश्रीभिः एधमानमदः पुमान् ।\nनैवार्हत्यभिधातुं वै त्वां अकिञ्चनगोचरम्"
    },
    {
      "id": "bhagavatam-1-8-27",
      "sequence": 296,
      "chapter": 8,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.27",
      "original": "नमोऽकिञ्चनवित्ताय निवृत्तगुणवृत्तये ।\nआत्मारामाय शान्ताय कैवल्यपतये नमः"
    },
    {
      "id": "bhagavatam-1-8-28",
      "sequence": 297,
      "chapter": 8,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.28",
      "original": "मन्ये त्वां कालमीशानं अनादिनिधनं विभुम् ।\nसमं चरन्तं सर्वत्र भूतानां यन्मिथः कलिः"
    },
    {
      "id": "bhagavatam-1-8-29",
      "sequence": 298,
      "chapter": 8,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.29",
      "original": "न वेद कश्चिद् भगवंश्चिकीर्षितं\nतवेहमानस्य नृणां विडम्बनम् ।\nन यस्य कश्चिद् दयितोऽस्ति कर्हिचिद्\nद्वेष्यश्च यस्मिन्विषमा मतिर्नृणाम्",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-8-30",
      "sequence": 299,
      "chapter": 8,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.30",
      "original": "जन्म कर्म च विश्वात्मन् अजस्याकर्तुरात्मनः ।\nतिर्यङ् नृषिषु यादःसु तद् अत्यन्तविडम्बनम्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-8-31",
      "sequence": 300,
      "chapter": 8,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.31",
      "original": "गोप्याददे त्वयि कृतागसि दाम तावद्\nया ते दशाश्रुकलिल अञ्जन संभ्रमाक्षम् ।\nवक्त्रं निनीय भयभावनया स्थितस्य\nसा मां विमोहयति भीरपि यद्‌बिभेति",
      "meter": "वसंततिलका"
    },
    {
      "id": "bhagavatam-1-8-32",
      "sequence": 301,
      "chapter": 8,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.32",
      "original": "केचिद् आहुः अजं जातं पुण्यश्लोकस्य कीर्तये ।\nयदोः प्रियस्य अन्ववाये मलयस्येव चन्दनम्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-8-33",
      "sequence": 302,
      "chapter": 8,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.33",
      "original": "अपरे वसुदेवस्य देवक्यां याचितोऽभ्यगात् ।\nअजस्त्वमस्य क्षेमाय वधाय च सुरद्विषाम्"
    },
    {
      "id": "bhagavatam-1-8-34",
      "sequence": 303,
      "chapter": 8,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.34",
      "original": "भारावतारणायान्ये भुवो नाव इवोदधौ ।\nसीदन्त्या भूरिभारेण जातो ह्यात्मभुवार्थितः"
    },
    {
      "id": "bhagavatam-1-8-35",
      "sequence": 304,
      "chapter": 8,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.35",
      "original": "भवेऽस्मिन् क्लिश्यमानानां अविद्याकामकर्मभिः ।\nश्रवण स्मरणार्हाणि करिष्यम् इति केचन"
    },
    {
      "id": "bhagavatam-1-8-36",
      "sequence": 305,
      "chapter": 8,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.36",
      "original": "श्रृण्वन्ति गायन्ति गृणन्त्यभीक्ष्णशः\nस्मरन्ति नन्दन्ति तवेहितं जनाः ।\nत एव पश्यन्त्यचिरेण तावकं\nभवप्रवाहोपरमं पदाम्बुजम्",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-8-37",
      "sequence": 306,
      "chapter": 8,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.37",
      "original": "अप्यद्य नस्त्वं स्वकृतेहित प्रभो\nजिहाससि स्वित् सुहृदोऽनुजीविनः ।\nयेषां न चान्यत् भवतः पदाम्बुजात्\nपरायणं राजसु योजितांहसाम्"
    },
    {
      "id": "bhagavatam-1-8-38",
      "sequence": 307,
      "chapter": 8,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.38",
      "original": "के वयं नामरूपाभ्यां यदुभिः सह पाण्डवाः ।\nभवतोऽदर्शनं यर्हि हृषीकाणां इव ईशितुः",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-8-39",
      "sequence": 308,
      "chapter": 8,
      "sourceIndex": 39,
      "verse": 39,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.39",
      "original": "नेयं शोभिष्यते तत्र यथेदानीं गदाधर ।\nत्वत्पदैः अङ्‌किता भाति स्वलक्षणविलक्षितैः"
    },
    {
      "id": "bhagavatam-1-8-40",
      "sequence": 309,
      "chapter": 8,
      "sourceIndex": 40,
      "verse": 40,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.40",
      "original": "इमे जनपदाः स्वृद्धाः सुपक्वौषधिवीरुधः ।\nवनाद्रि नदी उदन्वन्तो ह्येधन्ते तव वीक्षितैः"
    },
    {
      "id": "bhagavatam-1-8-41",
      "sequence": 310,
      "chapter": 8,
      "sourceIndex": 41,
      "verse": 41,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.41",
      "original": "अथ विश्वेश विश्वात्मन् विश्वमूर्ते स्वकेषु मे ।\nस्नेहपाशं इमं छिन्धि दृढं पाण्डुषु वृष्णिषु"
    },
    {
      "id": "bhagavatam-1-8-42",
      "sequence": 311,
      "chapter": 8,
      "sourceIndex": 42,
      "verse": 42,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.42",
      "original": "त्वयि मेऽनन्यविषया मतिर्मधुपतेऽसकृत् ।\nरतिं उद्वहतात् अद्धा गङ्गेवौघं उदन्वति"
    },
    {
      "id": "bhagavatam-1-8-43",
      "sequence": 312,
      "chapter": 8,
      "sourceIndex": 43,
      "verse": 43,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.43",
      "original": "श्रीकृष्ण कृष्णसख वृष्णि ऋषभावनिध्रुग्\nराजन्यवंशदहन अनपवर्ग वीर्य ।\nगोविन्द गोद्विजसुरार्तिहरावतार\nयोगेश्वराखिलगुरो भगवन् नमस्ते",
      "meter": "वसंततिलका"
    },
    {
      "id": "bhagavatam-1-8-44",
      "sequence": 313,
      "chapter": 8,
      "sourceIndex": 44,
      "verse": 44,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.44",
      "original": "सूत उवाच ।\nपृथयेत्थं कलपदैः परिणूताखिलोदयः ।\nमन्दं जहास वैकुण्ठो मोहयन्निव मायया",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-8-45",
      "sequence": 314,
      "chapter": 8,
      "sourceIndex": 45,
      "verse": 45,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.45",
      "original": "तां बाढं इति उपामंत्र्य प्रविश्य गजसाह्वयम् ।\nस्त्रियश्च स्वपुरं यास्यन् प्रेम्णा राज्ञा निवारितः"
    },
    {
      "id": "bhagavatam-1-8-46",
      "sequence": 315,
      "chapter": 8,
      "sourceIndex": 46,
      "verse": 46,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.46",
      "original": "व्यासाद्यैरीश्वरेहा ज्ञैः कृष्णेनाद्‍भुतकर्मणा ।\nप्रबोधितोऽपि इतिहासैः नाबुध्यत शुचार्पितः"
    },
    {
      "id": "bhagavatam-1-8-47",
      "sequence": 316,
      "chapter": 8,
      "sourceIndex": 47,
      "verse": 47,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.47",
      "original": "आह राजा धर्मसुतः चिन्तयन् सुहृदां वधम् ।\nप्राकृतेनात्मना विप्राः स्नेहमोहवशं गतः"
    },
    {
      "id": "bhagavatam-1-8-48",
      "sequence": 317,
      "chapter": 8,
      "sourceIndex": 48,
      "verse": 48,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.48",
      "original": "अहो मे पश्यताज्ञानं हृदि रूढं दुरात्मनः ।\nपारक्यस्यैव देहस्य बह्व्यो मेऽक्षौहिणीर्हताः"
    },
    {
      "id": "bhagavatam-1-8-49",
      "sequence": 318,
      "chapter": 8,
      "sourceIndex": 49,
      "verse": 49,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.49",
      "original": "बालद्विजसुहृन् मित्र पितृभ्रातृगुरु द्रुहः ।\nन मे स्यात् निरयात् मोक्षो ह्यपि वर्ष अयुत आयुतैः"
    },
    {
      "id": "bhagavatam-1-8-50",
      "sequence": 319,
      "chapter": 8,
      "sourceIndex": 50,
      "verse": 50,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.50",
      "original": "नैनो राज्ञः प्रजाभर्तुः धर्मयुद्धे वधो द्विषाम् ।\nइति मे न तु बोधाय कल्पते शासनं वचः"
    },
    {
      "id": "bhagavatam-1-8-51",
      "sequence": 320,
      "chapter": 8,
      "sourceIndex": 51,
      "verse": 51,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.51",
      "original": "स्त्रीणां मत् हतबंधूनां द्रोहो योऽसौ इहोत्थितः ।\nकर्मभिः गृहमेधीयैः नाहं कल्पो व्यपोहितुम्"
    },
    {
      "id": "bhagavatam-1-8-52",
      "sequence": 321,
      "chapter": 8,
      "sourceIndex": 52,
      "verse": 52,
      "section": "Skandha 1, Chapter 08",
      "label": "1.8.52",
      "original": "यथा पङ्केन पङ्काम्भः सुरया वा सुराकृतम् ।\nभूतहत्यां तथैवैकां न यज्ञैः मार्ष्टुमर्हति"
    }
  ]
}
