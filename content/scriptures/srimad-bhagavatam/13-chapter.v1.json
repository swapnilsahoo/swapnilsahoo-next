    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%A7%E0%A5%A9&oldid=110184",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-13-1",
      "sequence": 482,
      "chapter": 13,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.1",
      "original": "सूत उवाच ।\nविदुरस्तीर्थयात्रायां मैत्रेयादात्मनो गतिम् ।\nज्ञात्वागाt हास्तिनपुरं तयावाप्तविवित्सितः"
    },
    {
      "id": "bhagavatam-1-13-2",
      "sequence": 483,
      "chapter": 13,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.2",
      "original": "यावतः कृतवान् प्रश्नान् क्षत्ता कौषारवाग्रतः ।\nजातैकभक्तिः गोविन्दे तेभ्यश्चोपरराम ह"
    },
    {
      "id": "bhagavatam-1-13-3",
      "sequence": 484,
      "chapter": 13,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.3",
      "original": "तं बन्धुमागतं दृष्ट्वा धर्मपुत्रः सहानुजः ।\nधृतराष्ट्रो युयुत्सुश्च सूतः शारद्वतः पृथा"
    },
    {
      "id": "bhagavatam-1-13-4",
      "sequence": 485,
      "chapter": 13,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.4",
      "original": "गान्धारी द्रौपदी ब्रह्मन् सुभद्रा चोत्तरा कृपी ।\nअन्याश्च जामयः पाण्डोः ज्ञातयः ससुताः स्त्रियः"
    },
    {
      "id": "bhagavatam-1-13-5",
      "sequence": 486,
      "chapter": 13,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.5",
      "original": "प्रत्युज्जग्मुः प्रहर्षेण प्राणं तन्व इवागतम् ।\nअभिसङ्‌गम्य विधिवत् परिष्वङ्‌गाभिवादनैः"
    },
    {
      "id": "bhagavatam-1-13-6",
      "sequence": 487,
      "chapter": 13,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.6",
      "original": "मुमुचुः प्रेमबाष्पौघं विरहौत्कण्ठ्य कातराः ।\nराजा तमर्हयां चक्रे कृतासन परिग्रहम्"
    },
    {
      "id": "bhagavatam-1-13-7",
      "sequence": 488,
      "chapter": 13,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.7",
      "original": "तं भुक्तवन्तं विश्रान्तं आसीनं सुखमासने ।\nप्रश्रयावनतो राजा प्राह तेषां च श्रृण्वताम्"
    },
    {
      "id": "bhagavatam-1-13-8",
      "sequence": 489,
      "chapter": 13,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.8",
      "original": "युधिष्ठिर उवाच ।\nअपि स्मरथ नो युष्मत् पक्षच्छायासमेधितान् ।\nविपद्‍गणाद् विषाग्न्यादेः मोचिता यत्समातृकाः"
    },
    {
      "id": "bhagavatam-1-13-9",
      "sequence": 490,
      "chapter": 13,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.9",
      "original": "कया वृत्त्या वर्तितं वः चरद्‌भिः क्षितिमण्डलम् ।\nतीर्थानि क्षेत्रमुख्यानि सेवितानीह भूतले"
    },
    {
      "id": "bhagavatam-1-13-10",
      "sequence": 491,
      "chapter": 13,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.10",
      "original": "भवद्विधा भागवताः तीर्थभूताः स्वयं विभो ।\nतीर्थीकुर्वन्ति तीर्थानि स्वान्तःस्थेन गदाभृता"
    },
    {
      "id": "bhagavatam-1-13-11",
      "sequence": 492,
      "chapter": 13,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.11",
      "original": "अपि नः सुहृदस्तात बान्धवाः कृष्णदेवताः ।\nदृष्टाः श्रुता वा यदवः स्वपुर्यां सुखमासते"
    },
    {
      "id": "bhagavatam-1-13-12",
      "sequence": 493,
      "chapter": 13,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.12",
      "original": "इत्युक्तो धर्मराजेन सर्वं तत् समवर्णयत् ।\nयथानुभूतं क्रमशो विना यदुकुलक्षयम्"
    },
    {
      "id": "bhagavatam-1-13-13",
      "sequence": 494,
      "chapter": 13,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.13",
      "original": "नन्वप्रियं दुर्विषहं नृणां स्वयमुपस्थितम् ।\nनावेदयत् सकरुणो दुःखितान् द्रष्टुमक्षमः"
    },
    {
      "id": "bhagavatam-1-13-14",
      "sequence": 495,
      "chapter": 13,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.14",
      "original": "कञ्चित् कालमथ अवात्सीत् सत्कृतो देववत्सुखम् ।\nभ्रातुर्ज्येष्ठस्य श्रेयस्कृत् सर्वेषां सुखमावहन्"
    },
    {
      "id": "bhagavatam-1-13-15",
      "sequence": 496,
      "chapter": 13,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.15",
      "original": "अबिभ्रदर्यमा दण्डं यथावत् अघकारिषु ।\nयावद् दधार शूद्रत्वं शापात् वर्षशतं यमः"
    },
    {
      "id": "bhagavatam-1-13-16",
      "sequence": 497,
      "chapter": 13,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.16",
      "original": "युधिष्ठिरो लब्धराज्यो दृष्ट्वा पौत्रं कुलन्धरम् ।\nभ्रातृभिर्लोकपालाभैः मुमुदे परया श्रिया"
    },
    {
      "id": "bhagavatam-1-13-17",
      "sequence": 498,
      "chapter": 13,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.17",
      "original": "एवं गृहेषु सक्तानां प्रमत्तानां तदीहया ।\nअत्यक्रामत् अविज्ञातः कालः परमदुस्तरः"
    },
    {
      "id": "bhagavatam-1-13-18",
      "sequence": 499,
      "chapter": 13,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.18",
      "original": "विदुरस्तत् अभिप्रेत्य धृतराष्ट्रं अभाषत ।\nराजन् निर्गम्यतां शीघ्रं पश्येदं भयमागतम्"
    },
    {
      "id": "bhagavatam-1-13-19",
      "sequence": 500,
      "chapter": 13,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.19",
      "original": "प्रतिक्रिया न यस्येह कुतश्चित् कर्हिचित् प्रभो ।\nस एष भगवान् कालः सर्वेषां नः समागतः"
    },
    {
      "id": "bhagavatam-1-13-20",
      "sequence": 501,
      "chapter": 13,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.20",
      "original": "येन चैवाभिपन्नोऽयं प्राणैः प्रियतमैरपि ।\nजनः सद्यो वियुज्येत किमुतान्यैः धनादिभिः"
    },
    {
      "id": "bhagavatam-1-13-21",
      "sequence": 502,
      "chapter": 13,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.21",
      "original": "पितृभ्रातृसुहृत्पुत्रा हतास्ते विगतं वयः ।\nआत्मा च जरया ग्रस्तः परगेहमुपाससे"
    },
    {
      "id": "bhagavatam-1-13-22",
      "sequence": 503,
      "chapter": 13,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.22",
      "original": "अहो महीयसी जन्तोः जीविताशा यया भवान् ।\nभीमापवर्जितं पिण्डं आदत्ते गृहपालवत्"
    },
    {
      "id": "bhagavatam-1-13-23",
      "sequence": 504,
      "chapter": 13,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.23",
      "original": "अग्निर्निसृष्टो दत्तश्च गरो दाराश्च दूषिताः ।\nहृतं क्षेत्रं धनं येषां तद्दत्तैरसुभिः कियत्"
    },
    {
      "id": "bhagavatam-1-13-24",
      "sequence": 505,
      "chapter": 13,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.24",
      "original": "तस्यापि तव देहोऽयं कृपणस्य जिजीविषोः ।\nपरैत्यनिच्छतो जीर्णो जरया वाससी इव"
    },
    {
      "id": "bhagavatam-1-13-25",
      "sequence": 506,
      "chapter": 13,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.25",
      "original": "गतस्वार्थमिमं देहं विरक्तो मुक्तबन्धनः ।\nअविज्ञातगतिः जह्यात् स वै धीर उदाहृतः"
    },
    {
      "id": "bhagavatam-1-13-26",
      "sequence": 507,
      "chapter": 13,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.26",
      "original": "यः स्वकात्परतो वेह जातनिर्वेद आत्मवान् ।\nहृदि कृत्वा हरिं गेहात् प्रव्रजेत् स नरोत्तमः"
    },
    {
      "id": "bhagavatam-1-13-27",
      "sequence": 508,
      "chapter": 13,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.27",
      "original": "अथोदीचीं दिशं यातु स्वैरज्ञात गतिर्भवान् ।\nइतोऽर्वाक् प्रायशः कालः पुंसां गुणविकर्षणः"
    },
    {
      "id": "bhagavatam-1-13-28",
      "sequence": 509,
      "chapter": 13,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.28",
      "original": "एवं राजा विदुरेणानुजेन\nप्रज्ञाचक्षुर्बोधित आजमीढः ।\nछित्त्वा स्वेषु स्नेहपाशान्द्रढिम्नो\nनिश्चक्राम भ्रातृसन्दर्शिताध्वा"
    },
    {
      "id": "bhagavatam-1-13-29",
      "sequence": 510,
      "chapter": 13,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.29",
      "original": "पतिं प्रयान्तं सुबलस्य पुत्री\nपतिव्रता चानुजगाम साध्वी ।\nहिमालयं न्यस्तदण्डप्रहर्षं\nमनस्विनामिव सत्सम्प्रहारः"
    },
    {
      "id": "bhagavatam-1-13-30",
      "sequence": 511,
      "chapter": 13,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.30",
      "original": "अजातशत्रुः कृतमैत्रो हुताग्निः\nविप्रान् नत्वा तिलगोभूमिरुक्मैः ।\nगृहं प्रविष्टो गुरुवन्दनाय\nन चापश्यत् पितरौ सौबलीं च"
    },
    {
      "id": "bhagavatam-1-13-31",
      "sequence": 512,
      "chapter": 13,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.31",
      "original": "तत्र सञ्जयमासीनं पप्रच्छोद्विग्नमानसः ।\nगावल्गणे क्व नस्तातो वृद्धो हीनश्च नेत्रयोः"
    },
    {
      "id": "bhagavatam-1-13-32",
      "sequence": 513,
      "chapter": 13,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.32",
      "original": "अम्बा च हतपुत्राऽऽर्ता पितृव्यः क्व गतः सुहृत् ।\nअपि मय्यकृतप्रज्ञे हतबन्धुः स भार्यया ।\nआशंसमानः शमलं गङ्‌गायां दुःखितोऽपतत्"
    },
    {
      "id": "bhagavatam-1-13-33",
      "sequence": 514,
      "chapter": 13,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.33",
      "original": "पितर्युपरते पाण्डौ सर्वान्नः सुहृदः शिशून् ।\nअरक्षतां व्यसनतः पितृव्यौ क्व गतावितः"
    },
    {
      "id": "bhagavatam-1-13-34",
      "sequence": 515,
      "chapter": 13,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.34",
      "original": "सूत उवाच ।\nकृपया स्नेहवैक्लव्यात् सूतो विरहकर्शितः ।\nआत्मेश्वरमचक्षाणो न प्रत्याहातिपीडितः"
    },
    {
      "id": "bhagavatam-1-13-35",
      "sequence": 516,
      "chapter": 13,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.35",
      "original": "विमृज्याश्रूणि पाणिभ्यां विष्टभ्यात्मानमात्मना ।\nअजातशत्रुं प्रत्यूचे प्रभोः पादावनुस्मरन्"
    },
    {
      "id": "bhagavatam-1-13-36",
      "sequence": 517,
      "chapter": 13,
      "sourceIndex": 36,
      "verse": 37,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.37",
      "original": "सञ्जय उवाच ।\nनाहं वेद व्यवसितं पित्रोर्वः कुलनन्दन ।\nगान्धार्या वा महाबाहो मुषितोऽस्मि महात्मभिः"
    },
    {
      "id": "bhagavatam-1-13-37",
      "sequence": 518,
      "chapter": 13,
      "sourceIndex": 37,
      "verse": 38,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.38",
      "original": "अथाजगाम भगवान् नारदः सहतुम्बुरुः ।\nप्रत्युत्थायाभिवाद्याह सानुजोऽभ्यर्चयन् मुनिम्"
    },
    {
      "id": "bhagavatam-1-13-38",
      "sequence": 519,
      "chapter": 13,
      "sourceIndex": 38,
      "verse": 39,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.39",
      "original": "युधिष्ठिर उवाच ।\nनाहं वेद गतिं पित्रोः भगवन् क्व गतावितः ।\nअम्बा वा हतपुत्रार्ता क्व गता च तपस्विनी"
    },
    {
      "id": "bhagavatam-1-13-39",
      "sequence": 520,
      "chapter": 13,
      "sourceIndex": 39,
      "verse": 40,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.40",
      "original": "कर्णधार इवापारे भगवान् पारदर्शकः ।\nअथाबभाषे भगवान् नारदो मुनिसत्तमः"
    },
    {
      "id": "bhagavatam-1-13-40",
      "sequence": 521,
      "chapter": 13,
      "sourceIndex": 40,
      "verse": 40,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.40",
      "original": "नारद उवाच ।\nमा कञ्चन शुचो राजन् यदीश्वरवशं जगत् ।\nलोकाः सपाला यस्येमे वहन्ति बलिमीशितुः ।\nस संयुनक्ति भूतानि स एव वियुनक्ति च"
    },
    {
      "id": "bhagavatam-1-13-41",
      "sequence": 522,
      "chapter": 13,
      "sourceIndex": 41,
      "verse": 41,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.41",
      "original": "यथा गावो नसि प्रोताः तन्त्यां बद्धाः स्वदामभिः ।\nवाक्तन्त्यां नामभिर्बद्धा वहन्ति बलिमीशितुः"
    },
    {
      "id": "bhagavatam-1-13-42",
      "sequence": 523,
      "chapter": 13,
      "sourceIndex": 42,
      "verse": 42,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.42",
      "original": "यथा क्रीडोपस्कराणां संयोगविगमाविह ।\nइच्छया क्रीडितुः स्यातां तथैवेशेच्छया नृणाम्"
    },
    {
      "id": "bhagavatam-1-13-43",
      "sequence": 524,
      "chapter": 13,
      "sourceIndex": 43,
      "verse": 43,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.43",
      "original": "यन्मन्यसे ध्रुवं लोकं अध्रुवं वा न चोभयम् ।\nसर्वथा न हि शोच्यास्ते स्नेहात् अन्यत्र मोहजात्"
    },
    {
      "id": "bhagavatam-1-13-44",
      "sequence": 525,
      "chapter": 13,
      "sourceIndex": 44,
      "verse": 44,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.44",
      "original": "तस्माज्जह्यङ्‌ग वैक्लव्यं अज्ञानकृतमात्मनः ।\nकथं त्वनाथाः कृपणा वर्तेरंस्ते च मां विना"
    },
    {
      "id": "bhagavatam-1-13-45",
      "sequence": 526,
      "chapter": 13,
      "sourceIndex": 45,
      "verse": 45,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.45",
      "original": "कालकर्म गुणाधीनो देहोऽयं पाञ्चभौतिकः ।\nकथमन्यांस्तु गोपायेत् सर्पग्रस्तो यथा परम्"
    },
    {
      "id": "bhagavatam-1-13-46",
      "sequence": 527,
      "chapter": 13,
      "sourceIndex": 46,
      "verse": 46,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.46",
      "original": "अहस्तानि सहस्तानां अपदानि चतुष्पदाम् ।\nफल्गूनि तत्र महतां जीवो जीवस्य जीवनम्"
    },
    {
      "id": "bhagavatam-1-13-47",
      "sequence": 528,
      "chapter": 13,
      "sourceIndex": 47,
      "verse": 47,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.47",
      "original": "तदिदं भगवान् राजन् एक आत्मात्मनां स्वदृक् ।\nअन्तरोऽनन्तरो भाति पश्य तं माययोरुधा"
    },
    {
      "id": "bhagavatam-1-13-48",
      "sequence": 529,
      "chapter": 13,
      "sourceIndex": 48,
      "verse": 48,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.48",
      "original": "सोऽयमद्य महाराज भगवान् भूतभावनः ।\nकालरूपोऽवतीर्णोऽस्यां अभावाय सुरद्विषाम्"
    },
    {
      "id": "bhagavatam-1-13-49",
      "sequence": 530,
      "chapter": 13,
      "sourceIndex": 49,
      "verse": 49,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.49",
      "original": "निष्पादितं देवकृत्यं अवशेषं प्रतीक्षते ।\nतावद् यूयं अवेक्षध्वं भवेद् यावदिहेश्वरः"
    },
    {
      "id": "bhagavatam-1-13-50",
      "sequence": 531,
      "chapter": 13,
      "sourceIndex": 50,
      "verse": 50,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.50",
      "original": "धृतराष्ट्रः सह भ्रात्रा गान्धार्या च स्वभार्यया ।\nदक्षिणेन हिमवत ऋषीणां आश्रमं गतः"
    },
    {
      "id": "bhagavatam-1-13-51",
      "sequence": 532,
      "chapter": 13,
      "sourceIndex": 51,
      "verse": 51,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.51",
      "original": "स्रोतोभिः सप्तभिर्या वै स्वर्धुनी सप्तधा व्यधात् ।\nसप्तानां प्रीतये नाना सप्तस्रोतः प्रचक्षते"
    },
    {
      "id": "bhagavatam-1-13-52",
      "sequence": 533,
      "chapter": 13,
      "sourceIndex": 52,
      "verse": 52,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.52",
      "original": "स्नात्वानुसवनं तस्मिन् हुत्वा चाग्नीन्यथाविधि ।\nअब्भक्ष उपशान्तात्मा स आस्ते विगतैषणः"
    },
    {
      "id": "bhagavatam-1-13-53",
      "sequence": 534,
      "chapter": 13,
      "sourceIndex": 53,
      "verse": 53,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.53",
      "original": "जितासनो जितश्वासः प्रत्याहृतषडिन्द्रियः ।\nहरिभावनया ध्वस्तः अजःसत्त्वतमोमलः"
    },
    {
      "id": "bhagavatam-1-13-54",
      "sequence": 535,
      "chapter": 13,
      "sourceIndex": 54,
      "verse": 54,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.54",
      "original": "विज्ञानात्मनि संयोज्य क्षेत्रज्ञे प्रविलाप्य तम् ।\nब्रह्मण्यात्मानमाधारे घटाम्बरमिवाम्बरे"
    },
    {
      "id": "bhagavatam-1-13-55",
      "sequence": 536,
      "chapter": 13,
      "sourceIndex": 55,
      "verse": 55,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.55",
      "original": "ध्वस्तमायागुणोदर्को निरुद्धकरणाशयः ।\nनिवर्तिताखिलाहार आस्ते स्थाणुरिवाचलः ।\nतस्यान्तरायो मैवाभूः सन्न्यस्ताखिलकर्मणः"
    },
    {
      "id": "bhagavatam-1-13-56",
      "sequence": 537,
      "chapter": 13,
      "sourceIndex": 56,
      "verse": 56,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.56",
      "original": "स वा अद्यतनाद् राजन् परतः पञ्चमेऽहनि ।\nकलेवरं हास्यति स्वं तच्च भस्मीभविष्यति"
    },
    {
      "id": "bhagavatam-1-13-57",
      "sequence": 538,
      "chapter": 13,
      "sourceIndex": 57,
      "verse": 57,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.57",
      "original": "दह्यमानेऽग्निभिर्देहे पत्युः पत्‍नी सहोटजे ।\nबहिः स्थिता पतिं साध्वी तमग्निमनु वेक्ष्यति"
    },
    {
      "id": "bhagavatam-1-13-58",
      "sequence": 539,
      "chapter": 13,
      "sourceIndex": 58,
      "verse": 58,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.58",
      "original": "विदुरस्तु तदाश्चर्यं निशाम्य कुरुनन्दन ।\nहर्षशोकयुतस्तस्माद् गन्ता तीर्थनिषेवकः"
    },
    {
      "id": "bhagavatam-1-13-59",
      "sequence": 540,
      "chapter": 13,
      "sourceIndex": 59,
      "verse": 59,
      "section": "Skandha 1, Chapter 13",
      "label": "1.13.59",
      "original": "इत्युक्त्वाथारुहत् स्वर्गं नारदः सहतुम्बुरुः ।\nयुधिष्ठिरो वचस्तस्य हृदि कृत्वाजहाच्छुचः"
    }
  ]
}
