  },
  "entries": [
    {
      "id": "bhagavatam-1-2-1",
      "sequence": 24,
      "chapter": 2,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.1",
      "original": "व्यास उवाच ।\nइति संप्रश्नसंहृष्टो विप्राणां रौमहर्षणिः ।\nप्रतिपूज्य वचस्तेषां प्रवक्तुं उपचक्रमे"
    },
    {
      "id": "bhagavatam-1-2-2",
      "sequence": 25,
      "chapter": 2,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.2",
      "original": "सूत उवाच ।\nयं प्रव्रजन्तमनुपेतमपेतकृत्यं\nद्वैपायनो विरहकातर आजुहाव ।\nपुत्रेति तन्मयतया तरवोऽभिनेदुः\nतं सर्वभूतहृदयं मुनिमानतोऽस्मि",
      "meter": "वसंततिलका"
    },
    {
      "id": "bhagavatam-1-2-3",
      "sequence": 26,
      "chapter": 2,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.3",
      "original": "यः स्वानुभावमखिल श्रुतिसारमेकं\nअध्यात्मदीपं अतितितीर्षतां तमोऽन्धम् ।\nसंसारिणां करुणयाऽऽह पुराणगुह्यं\nतं व्याससूनुमुपयामि गुरुं मुनीनाम्"
    },
    {
      "id": "bhagavatam-1-2-4",
      "sequence": 27,
      "chapter": 2,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.4",
      "original": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम् ।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-2-5",
      "sequence": 28,
      "chapter": 2,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.5",
      "original": "मुनयः साधु पृष्टोऽहं भवद्‌भिः लोकमङ्गलम् ।\nयत्कृतः कृष्णसंप्रश्नो येनात्मा सुप्रसीदति"
    },
    {
      "id": "bhagavatam-1-2-6",
      "sequence": 29,
      "chapter": 2,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.6",
      "original": "स वै पुंसां परो धर्मो यतो भक्तिरधोक्षजे ।\nअहैतुक्यप्रतिहता ययात्मा संप्रसीदति"
    },
    {
      "id": "bhagavatam-1-2-7",
      "sequence": 30,
      "chapter": 2,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.7",
      "original": "वासुदेवे भगवति भक्तियोगः प्रयोजितः ।\nजनयत्याशु वैराग्यं ज्ञानं च यद् अहैतुकम्"
    },
    {
      "id": "bhagavatam-1-2-8",
      "sequence": 31,
      "chapter": 2,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.8",
      "original": "धर्मः स्वनुष्ठितः पुंसां विष्वक्सेनकथासु यः ।\nनोत्पादयेद् यदि रतिं श्रम एव हि केवलम्"
    },
    {
      "id": "bhagavatam-1-2-9",
      "sequence": 32,
      "chapter": 2,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.9",
      "original": "धर्मस्य ह्यापवर्ग्यस्य नार्थोऽर्थायोपकल्पते ।\nनार्थस्य धर्मैकान्तस्य कामो लाभाय हि स्मृतः"
    },
    {
      "id": "bhagavatam-1-2-10",
      "sequence": 33,
      "chapter": 2,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.10",
      "original": "कामस्य नेन्द्रियप्रीतिः लाभो जीवेत यावता ।\nजीवस्य तत्त्वजिज्ञासा नार्थो यश्चेह कर्मभिः"
    },
    {
      "id": "bhagavatam-1-2-11",
      "sequence": 34,
      "chapter": 2,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.11",
      "original": "वदन्ति तत् तत्त्वविदः तत्त्वं यत् ज्ञानमद्वयम् ।\nब्रह्मेति परमात्मेति भगवानिति शब्द्यते"
    },
    {
      "id": "bhagavatam-1-2-12",
      "sequence": 35,
      "chapter": 2,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.12",
      "original": "तत् श्रद्दधाना मुनयो ज्ञानवैराग्ययुक्तया ।\nपश्यन्त्यात्मनि चात्मानं भक्त्या श्रुतगृहीतया"
    },
    {
      "id": "bhagavatam-1-2-13",
      "sequence": 36,
      "chapter": 2,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.13",
      "original": "अतः पुम्भिः द्विजश्रेष्ठा वर्णाश्रमविभागशः ।\nस्वनुष्ठितस्य धर्मस्य संसिद्धिः हरितोषणम्"
    },
    {
      "id": "bhagavatam-1-2-14",
      "sequence": 37,
      "chapter": 2,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.14",
      "original": "तस्मादेकेन मनसा भगवान् सात्वतां पतिः ।\nश्रोतव्यः कीर्तितव्यश्च ध्येयः पूज्यश्च नित्यदा"
    },
    {
      "id": "bhagavatam-1-2-15",
      "sequence": 38,
      "chapter": 2,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.15",
      "original": "यद् अदनुध्यासिना युक्ताः कर्मग्रन्थिनिबन्धनम् ।\nछिन्दन्ति कोविदास्तस्य को न कुर्यात् कथारतिम्"
    },
    {
      "id": "bhagavatam-1-2-16",
      "sequence": 39,
      "chapter": 2,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.16",
      "original": "शुश्रूषोः श्रद्दधानस्य वासुदेवकथारुचिः ।\nस्यान्महत्सेवया विप्राः पुण्यतीर्थनिषेवणात्"
    },
    {
      "id": "bhagavatam-1-2-17",
      "sequence": 40,
      "chapter": 2,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.17",
      "original": "श्रृण्वतां स्वकथां कृष्णः पुण्यश्रवणकीर्तनः ।\nहृद्यन्तःस्थो ह्यभद्राणि विधुनोति सुहृत्सताम्"
    },
    {
      "id": "bhagavatam-1-2-18",
      "sequence": 41,
      "chapter": 2,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.18",
      "original": "नष्टप्रायेष्वभद्रेषु नित्यं भागवतसेवया ।\nभगवति उत्तमश्लोके भक्तिर्भवति नैष्ठिकी"
    },
    {
      "id": "bhagavatam-1-2-19",
      "sequence": 42,
      "chapter": 2,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.19",
      "original": "तदा रजस्तमोभावाः कामलोभादयश्च ये ।\nचेत एतैरनाविद्धं स्थितं सत्त्वे प्रसीदति"
    },
    {
      "id": "bhagavatam-1-2-20",
      "sequence": 43,
      "chapter": 2,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.20",
      "original": "एवं प्रसन्नमनसो भगवद्‍भक्तियोगतः ।\nभगवत् तत्त्वविज्ञानं मुक्तसङ्गस्य जायते"
    },
    {
      "id": "bhagavatam-1-2-21",
      "sequence": 44,
      "chapter": 2,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.21",
      "original": "भिद्यते हृदयग्रन्थिः छिद्यन्ते सर्वसंशयाः ।\nक्षीयन्ते चास्य कर्माणि दृष्ट एवात्मनीश्वरे"
    },
    {
      "id": "bhagavatam-1-2-22",
      "sequence": 45,
      "chapter": 2,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.22",
      "original": "अतो वै कवयो नित्यं भक्तिं परमया मुदा ।\nवासुदेवे भगवति कुर्वन्त्यात्मप्रसादनीम्"
    },
    {
      "id": "bhagavatam-1-2-23",
      "sequence": 46,
      "chapter": 2,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.23",
      "original": "सत्त्वं रजस्तम इति प्रकृतेर्गुणास्तैः\nयुक्तः परः पुरुष एक इहास्य धत्ते ।\nस्थित्यादये हरिविरिञ्चिहरेति संज्ञाः\nश्रेयांसि तत्र खलु सत्त्वतनोः नृणां स्युः",
      "meter": "वसंततिलका"
    },
    {
      "id": "bhagavatam-1-2-24",
      "sequence": 47,
      "chapter": 2,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.24",
      "original": "पार्थिवाद् दारुणो धूमः तस्मादग्निस्त्रयीमयः ।\nतमसस्तु रजस्तस्मात् सत्त्वं यद् ब्रह्मदर्शनम्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-2-25",
      "sequence": 48,
      "chapter": 2,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.25",
      "original": "भेजिरे मुनयोऽथाग्रे भगवन्तं अधोक्षजम् ।\nसत्त्वं विशुद्धं क्षेमाय कल्पन्ते येऽनु तानिह"
    },
    {
      "id": "bhagavatam-1-2-26",
      "sequence": 49,
      "chapter": 2,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.26",
      "original": "मुमुक्षवो घोररूपान् हित्वा भूतपतीनथ ।\nनारायणकलाः शान्ता भजन्ति ह्यनसूयवः"
    },
    {
      "id": "bhagavatam-1-2-27",
      "sequence": 50,
      "chapter": 2,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.27",
      "original": "रजस्तमःप्रकृतयः समशीला भजन्ति वै ।\nपितृभूतप्रजेशादीन् श्रियैश्वर्यप्रजेप्सवः"
    },
    {
      "id": "bhagavatam-1-2-28",
      "sequence": 51,
      "chapter": 2,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.28",
      "original": "वासुदेवपरा वेदा वासुदेवपरा मखाः ।\nवासुदेवपरा योगा वासुदेवपराः क्रियाः"
    },
    {
      "id": "bhagavatam-1-2-29",
      "sequence": 52,
      "chapter": 2,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.29",
      "original": "वासुदेवपरं ज्ञानं वासुदेवपरं तपः ।\nवासुदेवपरो धर्मो वासुदेवपरा गतिः"
    },
    {
      "id": "bhagavatam-1-2-30",
      "sequence": 53,
      "chapter": 2,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.30",
      "original": "स एवेदं ससर्जाग्रे भगवान् आत्ममायया ।\nसद् असद् रूपया चासौ गुणमय्यागुणो विभुः"
    },
    {
      "id": "bhagavatam-1-2-31",
      "sequence": 54,
      "chapter": 2,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.31",
      "original": "तया विलसितेष्वेषु गुणेषु गुणवानिव ।\nअन्तःप्रविष्ट आभाति विज्ञानेन विजृम्भितः"
    },
    {
      "id": "bhagavatam-1-2-32",
      "sequence": 55,
      "chapter": 2,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.32",
      "original": "यथा ह्यवहितो वह्निः दारुष्वेकः स्वयोनिषु ।\nनानेव भाति विश्वात्मा भूतेषु च तथा पुमान्"
    },
    {
      "id": "bhagavatam-1-2-33",
      "sequence": 56,
      "chapter": 2,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.33",
      "original": "असौ गुणमयैर्भावैः भूत सूक्ष्मेन्द्रियात्मभिः ।\nस्वनिर्मितेषु निर्विष्टो भुङ्क्ते भूतेषु तद्‍गुणान्"
    },
    {
      "id": "bhagavatam-1-2-34",
      "sequence": 57,
      "chapter": 2,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 02",
      "label": "1.2.34",
      "original": "भावयत्येष सत्त्वेन लोकान्वै लोकभावनः ।\nलीलावतारानुरतो देवतिर्यङ् नरादिषु"
    }
  ]
}
