    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-15-1",
      "sequence": 585,
      "chapter": 15,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.1",
      "original": "सूत उवाच ।\nएवं कृष्णसखः कृष्णो भ्रात्र राज्ञाऽऽविकल्पितः ।\nनानाशंकास्पदं रूपं कृष्णविश्लेषकर्षितः"
    },
    {
      "id": "bhagavatam-1-15-2",
      "sequence": 586,
      "chapter": 15,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.2",
      "original": "शोकेन शुष्यद्वदनहृत्सरोजो हतप्रभः ।\nविभुं तमेवानुध्यायन्नाशक्रोत्प्रतिभाषितूम"
    },
    {
      "id": "bhagavatam-1-15-3",
      "sequence": 587,
      "chapter": 15,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.3",
      "original": "कृच्छ्रेण संस्तभ्य शुचः पाणिनाऽऽमृज्य नेत्रयोः ।\nपरोक्षेण समुन्नद्धप्रणयौत्कण्ठ्यकातरः"
    },
    {
      "id": "bhagavatam-1-15-4",
      "sequence": 588,
      "chapter": 15,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.4",
      "original": "सख्य मैत्रीं सौहृदं च सारथ्यादिषु संस्मरन ।\nनृपमग्रजमित्याह बाष्पगद्गदया गिरा"
    },
    {
      "id": "bhagavatam-1-15-5",
      "sequence": 589,
      "chapter": 15,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.5",
      "original": "अर्जुन उवाच ।\nवञ्चितोऽहं महाराज हरिणा बन्धुरुपिणा ।\nयेन मेऽपहृतं तेजो देवविस्मापनं महत"
    },
    {
      "id": "bhagavatam-1-15-6",
      "sequence": 590,
      "chapter": 15,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.6",
      "original": "यस्य क्षणवियोगेन लोको ह्यप्रियदर्शनः ।\nउक्थेन रहितो ह्येष मृतकः प्रोच्यते यथा"
    },
    {
      "id": "bhagavatam-1-15-7",
      "sequence": 591,
      "chapter": 15,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.7",
      "original": "यत्संश्रयाद् द्रुपदगेहमुपागतानां राज्ञा स्वयंवरमुखे स्मरदुर्मदानाम् ।\nतेजो हृतं खलु मयाभिहतश्च मत्स्यः सज्जीकृतेन धनुष्याधिगता च कृष्णा"
    },
    {
      "id": "bhagavatam-1-15-8",
      "sequence": 592,
      "chapter": 15,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.8",
      "original": "यत्संनिधावहमु खाण्डवमग्नयेऽदामिन्द्रं च सामरगणं तरसा विजित्य ।\nलब्धा सभा मयकृताद्भुतशिल्पमाया दिग्भ्योऽहरन्नृपतयो बलिमध्वरे ते"
    },
    {
      "id": "bhagavatam-1-15-9",
      "sequence": 593,
      "chapter": 15,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.9",
      "original": "यत्तेजसा नृपशिरोऽङ्घ्रिमहन्मखार्थे आर्योऽनुजस्तव गजायुतसत्ववीर्यः ।\nतेनाहृताः प्रमथनाथमखाय भूपा यन्मोचितास्तदनयन् बलिमध्वरे ते"
    },
    {
      "id": "bhagavatam-1-15-10",
      "sequence": 594,
      "chapter": 15,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.10",
      "original": "पत्‍न्यास्तवधिमखक्लृप्तमहाभिषेकश्‍लाघिष्ठन्चारुकाबरं कितवैः सभायाम ।\nस्पृष्टं विकीर्य पदयोः पतिताश्रुमुख्या यस्तत्स्त्रियोऽकृत हतेशविमुक्तकेशाः"
    },
    {
      "id": "bhagavatam-1-15-11",
      "sequence": 595,
      "chapter": 15,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.11",
      "original": "यो नो जुगोप वनमेत्य दुरन्तकृच्छ्राद दुर्वाससोऽरिविहतादयुताग्रभुग यः ।\nशाकान्नशिशःटमुपयुज्य यतास्त्रिलोकीं तृप्ताममंस्त सलिले विनिमंग्नसंघः"
    },
    {
      "id": "bhagavatam-1-15-12",
      "sequence": 596,
      "chapter": 15,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.12",
      "original": "यत्तेजसाथ भगवान युधि शुलपाणि र्विस्मापितः सगिरिजोऽस्त्रमदान्निजं मे ।\nअन्येऽपि चाहममुनैव कलेवरेण प्राप्तो महेन्द्रभवने महदासनार्धम"
    },
    {
      "id": "bhagavatam-1-15-13",
      "sequence": 597,
      "chapter": 15,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.13",
      "original": "तत्रैव मे विहरतो भुजदण्डयुग्मं गाण्डीवलक्षणमरातिवधाय देवाः ।\nसेन्द्रा श्रिता यदनुभावितमाजमीढ तेनाहमद्य मुषितः पुरुषेण भूम्र"
    },
    {
      "id": "bhagavatam-1-15-14",
      "sequence": 598,
      "chapter": 15,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.14",
      "original": "यद्वान्धवः कुरुबलाब्धिमनन्तपार मेको रथेन ततरेऽहमतार्यसत्त्वम ।\nप्रत्याहृतं बहु धनं च मयो परेषां तेजास्पदं मणीमयं च हृतं शिरोभ्यः"
    },
    {
      "id": "bhagavatam-1-15-15",
      "sequence": 599,
      "chapter": 15,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.15",
      "original": "यो भीष्मकर्णगुरुशल्यमूष्वदभ्र रजन्यवर्यरथमण्डलमन्डितासु ।\nअग्रेचरो मम विभो रथयूथपाना मायुर्मनांसि च दृशा सह ओज आर्च्छत"
    },
    {
      "id": "bhagavatam-1-15-16",
      "sequence": 600,
      "chapter": 15,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.16",
      "original": "यद्दोष्षु मा प्राणीहितं गुरुभिष्मकर्ण नप्तृत्रिगर्तशलसैन्धवबाह्निकाद्येः ।\nअस्त्राण्यमोघमाहिमानि निरुपिताने नो पस्पृशुर्नृहरिदासमिवासुराणि"
    },
    {
      "id": "bhagavatam-1-15-17",
      "sequence": 601,
      "chapter": 15,
      "sourceIndex": 17,
      "verse": 18,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.18",
      "original": "सौत्ये वृतः कुमतिनाऽऽत्मदं ईश्वरो मे यत्पादपद्ममभवाय भजन्ति भव्याः ।\nमां श्रान्तवाहमरयो रथिनो भुविष्ठं न प्राहरन यदनुभावनिरस्तचिस्ताः । \\१७॥\nनर्माण्युदाररुचिरस्मितशोभितानि हे पार्थ हेऽर्जुन सखे कुरुनन्दनेति ।\nसंजल्पितानि नरदेव हृदिस्पृशानि स्मर्तूर्लुठन्ति हृदयं मम माधवस्य"
    },
    {
      "id": "bhagavatam-1-15-18",
      "sequence": 602,
      "chapter": 15,
      "sourceIndex": 18,
      "verse": 19,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.19",
      "original": "शय्यासनाटनविकथनभोजनादि ष्वैक्याद्वयस्य ऋतवानिति विप्रलब्धः ।\nसख्युः सखेव पितृवत्तनयस्य सर्वं सेहे महान्महितया कुमतेरघं मे"
    },
    {
      "id": "bhagavatam-1-15-19",
      "sequence": 603,
      "chapter": 15,
      "sourceIndex": 19,
      "verse": 20,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.20",
      "original": "सोऽहं नृपेन्द्र रहितः पुरुषोत्तमेन सख्या प्रियेण सुहृदा हृदयने शुन्य ।\nअध्वन्युरुक्रमपरिग्रहमंग रक्षन गोपैरसाद्भिबलेव विनिर्जितोऽस्मि"
    },
    {
      "id": "bhagavatam-1-15-20",
      "sequence": 604,
      "chapter": 15,
      "sourceIndex": 20,
      "verse": 21,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.21",
      "original": "तद्वै धनुस्त इषवः स रथो हयास्ते सोऽहं रथी नॄपतयो यत आनमन्ति ।\nसर्व क्षणेन तदभुदसदीशरिक्तं भस्मन हुतं कुहकाराद्भमोवोत्पमुष्याम"
    },
    {
      "id": "bhagavatam-1-15-21",
      "sequence": 605,
      "chapter": 15,
      "sourceIndex": 21,
      "verse": 22,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.22",
      "original": "राजंस्त्वयाभिषुष्टांना सुहृदां न सुहृत्पुरेः ।\nविप्रशपविमुढांना निघ्नतां मुष्टिभिर्मिथः"
    },
    {
      "id": "bhagavatam-1-15-22",
      "sequence": 606,
      "chapter": 15,
      "sourceIndex": 22,
      "verse": 23,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.23",
      "original": "वारुणीं मदिरां पीत्वा मदोन्मथितचेतसाम ।\nअजानतामिव्यान्योन्य चतूः पंचावशेषिताः"
    },
    {
      "id": "bhagavatam-1-15-23",
      "sequence": 607,
      "chapter": 15,
      "sourceIndex": 23,
      "verse": 24,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.24",
      "original": "प्रायेणैतद भगवत ईश्वरस्य विचेष्टितम ।\nमिथो निघ्नन्ति भूतानि भावयन्ति च यन्मिथः"
    },
    {
      "id": "bhagavatam-1-15-24",
      "sequence": 608,
      "chapter": 15,
      "sourceIndex": 24,
      "verse": 25,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.25",
      "original": "जलौकसां जले यद्वन्महान्तोऽदन्त्यणीयसः ।\nदुर्बलान्बालिनो राजन्महान्तो बलिनो मिथः"
    },
    {
      "id": "bhagavatam-1-15-25",
      "sequence": 609,
      "chapter": 15,
      "sourceIndex": 25,
      "verse": 26,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.26",
      "original": "एवं बलिष्ठैर्यदुभिर्महद्भिरितरान विभुः ।\nयदुन यदुभिरन्योन्यं भुभारान संजहार ह"
    },
    {
      "id": "bhagavatam-1-15-26",
      "sequence": 610,
      "chapter": 15,
      "sourceIndex": 26,
      "verse": 27,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.27",
      "original": "देशकालार्थयुक्तानि हृत्तापोपशमानि च ।\nहरन्ति स्मरताश्चित्तं गोविन्दाभिहितानि मे"
    },
    {
      "id": "bhagavatam-1-15-27",
      "sequence": 611,
      "chapter": 15,
      "sourceIndex": 27,
      "verse": 28,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.28",
      "original": "सूत उवाच ।\nएवं चिन्तयतो जिष्णोः कृष्णपादसरोरुहम ।\nसौहार्देनातिगाढेन शान्ताऽऽसीद्विमला मतिः"
    },
    {
      "id": "bhagavatam-1-15-28",
      "sequence": 612,
      "chapter": 15,
      "sourceIndex": 28,
      "verse": 29,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.29",
      "original": "वासुदेवांगघ्यनुध्यानपरिबृंहितरंहसा ।\nभक्त्या निर्मथिताशेषकषायाधिषणोऽर्जुनः"
    },
    {
      "id": "bhagavatam-1-15-29",
      "sequence": 613,
      "chapter": 15,
      "sourceIndex": 29,
      "verse": 30,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.30",
      "original": "गीतं भगवता ज्ञान यत तत संग्राममुर्धनि ।\nकालकर्मतमोरुद्धं पुनरध्यगमद विभुः"
    },
    {
      "id": "bhagavatam-1-15-30",
      "sequence": 614,
      "chapter": 15,
      "sourceIndex": 30,
      "verse": 31,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.31",
      "original": "विशोको ब्रह्मासम्पत्या संछिन्नद्वैतसंशयः ।\nलीनप्रकृतिनैर्गुण्यादलिंगत्वादसम्भवः"
    },
    {
      "id": "bhagavatam-1-15-31",
      "sequence": 615,
      "chapter": 15,
      "sourceIndex": 31,
      "verse": 32,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.32",
      "original": "निशम्य भगवन्मार्ग संस्थां यदुकुलस्य च ।\nस्वःपथाय मतिं चक्रे निभॄतात्मा युधिष्ठिरः"
    },
    {
      "id": "bhagavatam-1-15-32",
      "sequence": 616,
      "chapter": 15,
      "sourceIndex": 32,
      "verse": 33,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.33",
      "original": "पृथाप्यनुश्रुत्य धनत्र्ज्ययोदितं नाश यदुनां भगवद्गतिं च ताम ।\nएकान्तभक्त्या भगवत्यधोक्षजे निवेशितात्मोपराम संसृतेः"
    },
    {
      "id": "bhagavatam-1-15-33",
      "sequence": 617,
      "chapter": 15,
      "sourceIndex": 33,
      "verse": 34,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.34",
      "original": "ययाहरदृ भुवो भारं तां तनुं विजहावजः ।\nकण्टकं कण्टकेनेव द्वयं चापीशितूः समम"
    },
    {
      "id": "bhagavatam-1-15-34",
      "sequence": 618,
      "chapter": 15,
      "sourceIndex": 34,
      "verse": 35,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.35",
      "original": "यथा मत्स्यादिरुपाणि धत्ते जाह्याद यथा नटः ।\nभूभरः क्षपितो येन जहौ तच्च कलेवरम"
    },
    {
      "id": "bhagavatam-1-15-35",
      "sequence": 619,
      "chapter": 15,
      "sourceIndex": 35,
      "verse": 36,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.36",
      "original": "यदा मुकुन्दो भगवानिमां महीं जहौ स्ततन्वा श्रवणीयसत्कथः ।\nतदाहरेवाप्रतिबुद्धचेतसा मधर्महेतूः कलिरन्ववर्तत"
    },
    {
      "id": "bhagavatam-1-15-36",
      "sequence": 620,
      "chapter": 15,
      "sourceIndex": 36,
      "verse": 37,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.37",
      "original": "युधिष्ठिरस्तत्पर्सर्पणं बुधः पुरे च राष्ट्रे च गृहे तथाऽऽत्मनि ।\nविभग्य लोभानृतजिह्नाहिंसना द्यधर्मचक्रं गमनाय पर्यधात"
    },
    {
      "id": "bhagavatam-1-15-37",
      "sequence": 621,
      "chapter": 15,
      "sourceIndex": 37,
      "verse": 38,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.38",
      "original": "स्वराट पौत्रं विनयिनमात्मनः सुसमं गुणैः ।\nतोयनीव्याः पतिं भूमेरभ्यषिचंद गजाहृये"
    },
    {
      "id": "bhagavatam-1-15-38",
      "sequence": 622,
      "chapter": 15,
      "sourceIndex": 38,
      "verse": 39,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.39",
      "original": "मथूरायां तथा वज्रं शुरसेनपतिं ततः ।\nप्राजापत्यां निरुप्योष्टिमग्नीनपिबदीश्वरः"
    },
    {
      "id": "bhagavatam-1-15-39",
      "sequence": 623,
      "chapter": 15,
      "sourceIndex": 39,
      "verse": 40,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.40",
      "original": "विसृज्य तत्र तत सर्व दुकुनलवलयादिकम ।\nनिर्ममो निरहंकारः संछिन्नाशेषबन्धनः"
    },
    {
      "id": "bhagavatam-1-15-40",
      "sequence": 624,
      "chapter": 15,
      "sourceIndex": 40,
      "verse": 41,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.41",
      "original": "वाचं जुहाव मनसि तत्प्राण इतरे च तम ।\nमृत्यावपानं सोत्सर्गं तं पंचत्वे ह्याजोहवीत"
    },
    {
      "id": "bhagavatam-1-15-41",
      "sequence": 625,
      "chapter": 15,
      "sourceIndex": 41,
      "verse": 42,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.42",
      "original": "त्रेत्वे हुत्वाथ पंचत्वं तच्चेकत्वेऽजुहोन्मुनिः ।\nसर्वमात्मन्यजुहवीद ब्रह्मण्यात्मानमव्यये"
    },
    {
      "id": "bhagavatam-1-15-42",
      "sequence": 626,
      "chapter": 15,
      "sourceIndex": 42,
      "verse": 43,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.43",
      "original": "चीरवासा निराहारो बद्धवड मुक्तमूर्धजः ।\nदर्शयन्नात्मनो रुपं जडोन्मत्तपिशाचवत"
    },
    {
      "id": "bhagavatam-1-15-43",
      "sequence": 627,
      "chapter": 15,
      "sourceIndex": 43,
      "verse": 44,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.44",
      "original": "अनपेक्षमाणो निरगादश्रृण्वन्बधिरो यथा ।\nउदीचीं प्रविवेशांशं गतपुर्वा महात्मभिः ।\nहृदि ब्रह्मा परं ध्यायान्नवर्तेत यतो गतः"
    },
    {
      "id": "bhagavatam-1-15-44",
      "sequence": 628,
      "chapter": 15,
      "sourceIndex": 44,
      "verse": 45,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.45",
      "original": "सर्व तमनु निर्जग्मुर्भ्रातरः कृतनिश्चयाः ।\nकलिनाधर्ममित्रेण दृष्टा स्पृष्टाः प्रजा भुवि"
    },
    {
      "id": "bhagavatam-1-15-45",
      "sequence": 629,
      "chapter": 15,
      "sourceIndex": 45,
      "verse": 46,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.46",
      "original": "ते साधुकृतसर्वार्था ज्ञात्वऽऽत्यन्तिकमातमनः ।\nमनसा धारयामासुर्वैकुठचरणाम्बुजम"
    },
    {
      "id": "bhagavatam-1-15-46",
      "sequence": 630,
      "chapter": 15,
      "sourceIndex": 46,
      "verse": 47,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.47",
      "original": "तद्धनोद्रिक्यया भक्त्या विशुद्धधिषणाः परे ।\nतस्मिन नारायणपदे एकान्तमतयो गतिम"
    },
    {
      "id": "bhagavatam-1-15-47",
      "sequence": 631,
      "chapter": 15,
      "sourceIndex": 47,
      "verse": 48,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.48",
      "original": "अवापुर्दुरवापां ते असद्भिर्विषयात्मभिः ।\nविहुतकल्मषास्थाने विरजेनात्मनैव हि"
    },
    {
      "id": "bhagavatam-1-15-48",
      "sequence": 632,
      "chapter": 15,
      "sourceIndex": 48,
      "verse": 49,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.49",
      "original": "विदुरोऽपि परित्यज्य प्रभासे देहमात्मवान ।\nकृष्णावेशेन तच्चित्तः पितृभिः स्वक्षयं ययौ"
    },
    {
      "id": "bhagavatam-1-15-49",
      "sequence": 633,
      "chapter": 15,
      "sourceIndex": 49,
      "verse": 50,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.50",
      "original": "द्रौपदी च तदाऽऽज्ञाय पतीनामनपेक्षताम ।\nवासुदेवे भगवति ह्योकान्तमतिराप तम"
    },
    {
      "id": "bhagavatam-1-15-50",
      "sequence": 634,
      "chapter": 15,
      "sourceIndex": 50,
      "verse": 51,
      "section": "Skandha 1, Chapter 15",
      "label": "1.15.51",
      "original": "यः श्रद्धयैतद भगवत्प्रियाणां पाण्डोः सुतानामिती सम्प्रयाणम ।\nश्रुणोत्यलं स्वत्ययनं पवित्रं लब्ध्या हरौ भक्तिमुपैति सिद्धिम"
    }
  ]
}
