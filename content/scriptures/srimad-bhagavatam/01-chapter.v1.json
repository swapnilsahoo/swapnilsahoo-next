  },
  "entries": [
    {
      "id": "bhagavatam-1-1-1",
      "sequence": 1,
      "chapter": 1,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.1",
      "original": "जन्माद्यस्य यतोऽन्वयादितरतः चार्थेष्वभिज्ञः स्वराट् ।\nतेने ब्रह्म हृदा य आदिकवये मुह्यन्ति यत् सूरयः ।\nतेजोवारिमृदां यथा विनिमयो यत्र त्रिसर्गोऽमृषा ।\nधाम्ना स्वेन सदा निरस्तकुहकं सत्यं परं धीमहि"
    },
    {
      "id": "bhagavatam-1-1-2",
      "sequence": 2,
      "chapter": 1,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.2",
      "original": "धर्मः प्रोज्झितकैतवोऽत्र परमो निर्मत्सराणां सतां ।\nवेद्यं वास्तवमत्र वस्तु शिवदं तापत्रयोन्मूलनम् ।\nश्रीमद्‍भागवते महामुनिकृते किं वा परैरीश्वरः ।\nसद्यो हृद्यवरुध्यतेऽत्र कृतिभिः शुश्रूषुभिः तत् क्षणात्"
    },
    {
      "id": "bhagavatam-1-1-3",
      "sequence": 3,
      "chapter": 1,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.3",
      "original": "निगमकल्पतरोर्गलितं फलं ।\nशुकमुखाद् अमृतद्रवसंयुतम् ।\nपिबत भागवतं रसमालयं ।\nमुहुरहो रसिका भुवि भावुकाः",
      "meter": "द्रुतविलम्बित"
    },
    {
      "id": "bhagavatam-1-1-4",
      "sequence": 4,
      "chapter": 1,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.4",
      "original": "नैमिषेऽनिमिषक्षेत्रे ऋषयः शौनकादयः ।\nसत्रं स्वर्गायलोकाय सहस्रसममासत",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-1-5",
      "sequence": 5,
      "chapter": 1,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.5",
      "original": "त एकदा तु मुनयः प्रातर्हुतहुताग्नयः ।\nसत्कृतं सूतमासीनं पप्रच्छुः इदमादरात्"
    },
    {
      "id": "bhagavatam-1-1-6",
      "sequence": 6,
      "chapter": 1,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.6",
      "original": "ऋषय ऊचुः ।\nत्वया खलु पुराणानि सेतिहासानि चानघ ।\nआख्यातान्यप्यधीतानि धर्मशास्त्राणि यान्युत"
    },
    {
      "id": "bhagavatam-1-1-7",
      "sequence": 7,
      "chapter": 1,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.7",
      "original": "यानि वेदविदां श्रेष्ठो भगवान् बादरायणः ।\nअन्ये च मुनयः सूत परावरविदो विदुः"
    },
    {
      "id": "bhagavatam-1-1-8",
      "sequence": 8,
      "chapter": 1,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.8",
      "original": "वेत्थ त्वं सौम्य तत्सर्वं तत्त्वतः तदनुग्रहात् ।\nब्रूयुः स्निग्धस्य शिष्यस्य गुरवो गुह्यमप्युत"
    },
    {
      "id": "bhagavatam-1-1-9",
      "sequence": 9,
      "chapter": 1,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.9",
      "original": "तत्र तत्राञ्जसाऽऽयुष्मन् भवता यद् विनिश्चितम् ।\nपुंसां एकान्ततः श्रेयः तन्नः शंसितुमर्हसि"
    },
    {
      "id": "bhagavatam-1-1-10",
      "sequence": 10,
      "chapter": 1,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.10",
      "original": "प्रायेणाल्पायुषः सभ्य कलौ अस्मिन् युगे जनाः ।\nमन्दाः सुमन्दमतयो मन्दभाग्या ह्युपद्रुताः"
    },
    {
      "id": "bhagavatam-1-1-11",
      "sequence": 11,
      "chapter": 1,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.11",
      "original": "भूरीणि भूरिकर्माणि श्रोतव्यानि विभागशः ।\nअतः साधोऽत्र यत्सारं समुद्धृत्य मनीषया ।\nब्रूहि नः श्रद्दधानानां येनात्मा संप्रसीदति"
    },
    {
      "id": "bhagavatam-1-1-12",
      "sequence": 12,
      "chapter": 1,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.12",
      "original": "सूत जानासि भद्रं ते भगवान् सात्वतां पतिः ।\nदेवक्यां वसुदेवस्य जातो यस्य चिकीर्षया"
    },
    {
      "id": "bhagavatam-1-1-13",
      "sequence": 13,
      "chapter": 1,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.13",
      "original": "तन्नः शुष्रूषमाणानां अर्हस्यङ्गानुवर्णितुम् ।\nयस्यावतारो भूतानां क्षेमाय च भवाय च"
    },
    {
      "id": "bhagavatam-1-1-14",
      "sequence": 14,
      "chapter": 1,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.14",
      "original": "आपन्नः संसृतिं घोरां यन्नाम विवशो गृणन् ।\nततः सद्यो विमुच्येत यद् बिभेति स्वयं भयम्"
    },
    {
      "id": "bhagavatam-1-1-15",
      "sequence": 15,
      "chapter": 1,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.15",
      "original": "यत्पादसंश्रयाः सूत मुनयः प्रशमायनाः ।\nसद्यः पुनन्त्युपस्पृष्टाः स्वर्धुन्यापोऽनुसेवया"
    },
    {
      "id": "bhagavatam-1-1-16",
      "sequence": 16,
      "chapter": 1,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.16",
      "original": "को वा भगवतस्तस्य पुण्यश्लोकेड्यकर्मणः ।\nशुद्धिकामो न श्रृणुयाद् यशः कलिमलापहम्"
    },
    {
      "id": "bhagavatam-1-1-17",
      "sequence": 17,
      "chapter": 1,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.17",
      "original": "तस्य कर्माण्युदाराणि परिगीतानि सूरिभिः ।\nब्रूहि नः श्रद्दधानानां लीलया दधतः कलाः"
    },
    {
      "id": "bhagavatam-1-1-18",
      "sequence": 18,
      "chapter": 1,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.18",
      "original": "अथाख्याहि हरेर्धीमन् अवतारकथाः शुभाः ।\nलीला विदधतः स्वैरं ईश्वरस्यात्ममायया"
    },
    {
      "id": "bhagavatam-1-1-19",
      "sequence": 19,
      "chapter": 1,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.19",
      "original": "वयं तु न वितृप्याम उत्तमश्लोकविक्रमे ।\nयत् श्रृण्वतां रसज्ञानां स्वादु स्वादु पदे पदे"
    },
    {
      "id": "bhagavatam-1-1-20",
      "sequence": 20,
      "chapter": 1,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.20",
      "original": "कृतवान् किल वीर्याणि सह रामेण केशवः ।\nअतिमर्त्यानि भगवान् गूढः कपटमानुषः"
    },
    {
      "id": "bhagavatam-1-1-21",
      "sequence": 21,
      "chapter": 1,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.21",
      "original": "कलिमागतमाज्ञाय क्षेत्रेऽस्मिन् वैष्णवे वयम् ।\nआसीना दीर्घसत्रेण कथायां सक्षणा हरेः"
    },
    {
      "id": "bhagavatam-1-1-22",
      "sequence": 22,
      "chapter": 1,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.22",
      "original": "त्वं नः संदर्शितो धात्रा दुस्तरं निस्तितीर्षताम् ।\nकलिं सत्त्वहरं पुंसां कर्णधार इवार्णवम्"
    },
    {
      "id": "bhagavatam-1-1-23",
      "sequence": 23,
      "chapter": 1,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 01",
      "label": "1.1.23",
      "original": "ब्रूहि योगेश्वरे कृष्णे ब्रह्मण्ये धर्मवर्मणि ।\nस्वां काष्ठामधुनोपेते धर्मः कं शरणं गतः"
    }
  ]
}
