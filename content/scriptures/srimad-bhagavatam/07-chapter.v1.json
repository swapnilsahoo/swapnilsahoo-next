    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-7-1",
      "sequence": 213,
      "chapter": 7,
      "sourceIndex": 1,
      "verse": 2,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.2",
      "original": "शौनक उवाच ।\nनिर्गते नारदे सूत भगवान् बादरायणः ।\nश्रुतवांस्तदभिप्रेतं ततः किमकरोद् विभुः ।\nसूत उवाच ।\nब्रह्मनद्यां सरस्वत्यां आश्रमः पश्चिमे तटे ।\nशम्याप्रास इति प्रोक्त ऋषीणां सत्रवर्धनः ॥",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-7-2",
      "sequence": 214,
      "chapter": 7,
      "sourceIndex": 2,
      "verse": 3,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.3",
      "original": "तस्मिन् स्व आश्रमे व्यासो बदरीषण्डमण्डिते ।\nआसीनोऽप उपस्पृश्य प्रणिदध्यौ मनः स्वयम् ॥"
    },
    {
      "id": "bhagavatam-1-7-3",
      "sequence": 215,
      "chapter": 7,
      "sourceIndex": 3,
      "verse": 4,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.4",
      "original": "भक्तियोगेन मनसि सम्यक् प्रणिहितेऽमले ।\nअपश्यत् पुरुषं पूर्णं मायां च तदपाश्रयम् ॥"
    },
    {
      "id": "bhagavatam-1-7-4",
      "sequence": 216,
      "chapter": 7,
      "sourceIndex": 4,
      "verse": 5,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.5",
      "original": "यया संमोहितो जीव आत्मानं त्रिगुणात्मकम् ।\nपरोऽपि मनुतेऽनर्थं तत्कृतं चाभिपद्यते ॥"
    },
    {
      "id": "bhagavatam-1-7-5",
      "sequence": 217,
      "chapter": 7,
      "sourceIndex": 5,
      "verse": 6,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.6",
      "original": "अनर्थोपशमं साक्षाद् भक्तियोगमधोक्षजे ।\nलोकस्याजानतो विद्वांन् चक्रे सात्वतसंहिताम् ॥"
    },
    {
      "id": "bhagavatam-1-7-6",
      "sequence": 218,
      "chapter": 7,
      "sourceIndex": 6,
      "verse": 7,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.7",
      "original": "यस्यां वै श्रूयमाणायां कृष्णे परमपूरुषे ।\nभक्तिरुत्पद्यते पुंसः शोकमोहभयापहा ॥"
    },
    {
      "id": "bhagavatam-1-7-7",
      "sequence": 219,
      "chapter": 7,
      "sourceIndex": 7,
      "verse": 8,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.8",
      "original": "स संहितां भागवतीं कृत्वानुक्रम्य चात्मजम् ।\nशुकं अध्यापयामास निवृत्तिनिरतं मुनिः ॥"
    },
    {
      "id": "bhagavatam-1-7-8",
      "sequence": 220,
      "chapter": 7,
      "sourceIndex": 8,
      "verse": 9,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.9",
      "original": "शौनक उवाच ।\nस वै निवृत्तिनिरतः सर्वत्रोपेक्षको मुनिः ।\nकस्य वा बृहतीं एतां आत्मारामः समभ्यसत्"
    },
    {
      "id": "bhagavatam-1-7-9",
      "sequence": 221,
      "chapter": 7,
      "sourceIndex": 9,
      "verse": 10,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.10",
      "original": "सूत उवाच ।\nआत्मारामाश्च मुनयो निर्ग्रन्था अप्युरुक्रमे ।\nकुर्वन्ति अहैतुकीं भक्तिं इत्थंभूतगुणो हरिः"
    },
    {
      "id": "bhagavatam-1-7-10",
      "sequence": 222,
      "chapter": 7,
      "sourceIndex": 10,
      "verse": 11,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.11",
      "original": "हरेर्गुणाक्षिप्तमतिः भगवान् बादरायणिः ।\nअध्यगान् महदाख्यानं नित्यं विष्णुजनप्रियः"
    },
    {
      "id": "bhagavatam-1-7-11",
      "sequence": 223,
      "chapter": 7,
      "sourceIndex": 11,
      "verse": 12,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.12",
      "original": "परीक्षितोऽथ राजर्षेः जन्मकर्मविलापनम् ।\nसंस्थां च पाण्डुपुत्राणां वक्ष्ये कृष्णकथोदयम्"
    },
    {
      "id": "bhagavatam-1-7-12",
      "sequence": 224,
      "chapter": 7,
      "sourceIndex": 12,
      "verse": 13,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.13",
      "original": "यदा मृधे कौरवसृञ्जयानां\nवीरेष्वथो वीरगतिं गतेषु ।\nवृकोदराविद्धगदाभिमर्श\nभग्नोरुदण्डे धृतराष्ट्रपुत्रे",
      "meter": "इंद्रवज्रा"
    },
    {
      "id": "bhagavatam-1-7-13",
      "sequence": 225,
      "chapter": 7,
      "sourceIndex": 13,
      "verse": 14,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.14",
      "original": "भर्तुः प्रियं द्रौणिरिति स्म पश्यन्\nकृष्णासुतानां स्वपतां शिरांसि ।\nउपाहरद् विप्रियमेव तस्य\nजुगुप्सितं कर्म विगर्हयन्ति"
    },
    {
      "id": "bhagavatam-1-7-14",
      "sequence": 226,
      "chapter": 7,
      "sourceIndex": 14,
      "verse": 15,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.15",
      "original": "माता शिशूनां निधनं सुतानां\nनिशम्य घोरं परितप्यमाना ।\nतदारुदद् बाष्पकलाकुलाक्षी\nतां सांत्वयन्नाह किरीटमाली"
    },
    {
      "id": "bhagavatam-1-7-15",
      "sequence": 227,
      "chapter": 7,
      "sourceIndex": 15,
      "verse": 16,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.16",
      "original": "तदा शुचस्ते प्रमृजामि भद्रे\nयद्‍ब्रह्मबंधोः शिर आततायिनः ।\nगाण्डीवमुक्तैः विशिखैरुपाहरे\nत्वाक्रम्य यत्स्नास्यसि दग्धपुत्रा"
    },
    {
      "id": "bhagavatam-1-7-16",
      "sequence": 228,
      "chapter": 7,
      "sourceIndex": 16,
      "verse": 17,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.17",
      "original": "इति प्रियां वल्गुविचित्रजल्पैः\nस सान्त्वयित्वाच्युतमित्रसूतः ।\nअन्वाद्रवद् दंशित उग्रधन्वा\nकपिध्वजो गुरुपुत्रं रथेन",
      "meter": "उपेंद्रवज्रा"
    },
    {
      "id": "bhagavatam-1-7-17",
      "sequence": 229,
      "chapter": 7,
      "sourceIndex": 17,
      "verse": 18,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.18",
      "original": "तमापतन्तं स विलक्ष्य दूरात्\nकुमारहोद्विग्नमना रथेन ।\nपराद्रवत् प्राणपरीप्सुरुर्व्यां\nयावद्‍गमं रुद्रभयाद् यथार्कः"
    },
    {
      "id": "bhagavatam-1-7-18",
      "sequence": 230,
      "chapter": 7,
      "sourceIndex": 18,
      "verse": 19,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.19",
      "original": "यदाशरणमात्मानं ऐक्षत श्रान्तवाजिनम् ।\nअस्त्रं ब्रह्मशिरो मेने आत्मत्राणं द्विजात्मजः",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-7-19",
      "sequence": 231,
      "chapter": 7,
      "sourceIndex": 19,
      "verse": 20,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.20",
      "original": "अथोपस्पृश्य सलिलं सन्दधे तत्समाहितः ।\nअजानन् उपसंहारं प्राणकृच्छ्र उपस्थिते"
    },
    {
      "id": "bhagavatam-1-7-20",
      "sequence": 232,
      "chapter": 7,
      "sourceIndex": 20,
      "verse": 21,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.21",
      "original": "ततः प्रादुष्कृतं तेजः प्रचण्डं सर्वतो दिशम् ।\nप्राणापदमभिप्रेक्ष्य विष्णुं जिष्णुरुवाच ह"
    },
    {
      "id": "bhagavatam-1-7-21",
      "sequence": 233,
      "chapter": 7,
      "sourceIndex": 21,
      "verse": 22,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.22",
      "original": "अर्जुन उवाच ।\nकृष्ण कृष्ण महाबाहो भक्तानामभयङ्कर ।\nत्वमेको दह्यमानानां अपवर्गोऽसि संसृतेः"
    },
    {
      "id": "bhagavatam-1-7-22",
      "sequence": 234,
      "chapter": 7,
      "sourceIndex": 22,
      "verse": 23,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.23",
      "original": "त्वमाद्यः पुरुषः साक्षाद् ईश्वरः प्रकृतेः परः ।\nमायां व्युदस्य चिच्छक्त्या कैवल्ये स्थित आत्मनि"
    },
    {
      "id": "bhagavatam-1-7-23",
      "sequence": 235,
      "chapter": 7,
      "sourceIndex": 23,
      "verse": 24,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.24",
      "original": "स एव जीवलोकस्य मायामोहितचेतसः ।\nविधत्से स्वेन वीर्येण श्रेयो धर्मादिलक्षणम्"
    },
    {
      "id": "bhagavatam-1-7-24",
      "sequence": 236,
      "chapter": 7,
      "sourceIndex": 24,
      "verse": 25,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.25",
      "original": "तथायं चावतारस्ते भुवो भारजिहीर्षया ।\nस्वानां चानन्यभावानां अनुध्यानाय चासकृत्"
    },
    {
      "id": "bhagavatam-1-7-25",
      "sequence": 237,
      "chapter": 7,
      "sourceIndex": 25,
      "verse": 26,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.26",
      "original": "किमिदं स्वित्कुतो वेति देवदेव न वेद्‌म्यहम् ।\nसर्वतो मुखमायाति तेजः परमदारुणम्"
    },
    {
      "id": "bhagavatam-1-7-26",
      "sequence": 238,
      "chapter": 7,
      "sourceIndex": 26,
      "verse": 27,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.27",
      "original": "श्रीभगवानुवाच ।\nवेत्थेदं द्रोणपुत्रस्य ब्राह्ममस्त्रं प्रदर्शितम् ।\nनैवासौ वेद संहारं प्राणबाध उपस्थिते"
    },
    {
      "id": "bhagavatam-1-7-27",
      "sequence": 239,
      "chapter": 7,
      "sourceIndex": 27,
      "verse": 28,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.28",
      "original": "न ह्यस्यान्यतमं किञ्चिद् अस्त्रं प्रत्यवकर्शनम् ।\nजह्यस्त्रतेज उन्नद्धं अस्त्रज्ञो ह्यस्त्रतेजसा"
    },
    {
      "id": "bhagavatam-1-7-28",
      "sequence": 240,
      "chapter": 7,
      "sourceIndex": 28,
      "verse": 29,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.29",
      "original": "सूत उवाच ।\nश्रुत्वा भगवता प्रोक्तं फाल्गुनः परवीरहा ।\nस्पृष्ट्वापस्तं परिक्रम्य ब्राह्मं ब्राह्माय संदधे"
    },
    {
      "id": "bhagavatam-1-7-29",
      "sequence": 241,
      "chapter": 7,
      "sourceIndex": 29,
      "verse": 30,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.30",
      "original": "संहत्य अन्योन्यं उभयोः तेजसी शरसंवृते ।\nआवृत्य रोदसी खं च ववृधातेऽर्कवह्निवत्"
    },
    {
      "id": "bhagavatam-1-7-30",
      "sequence": 242,
      "chapter": 7,
      "sourceIndex": 30,
      "verse": 31,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.31",
      "original": "दृष्ट्वास्त्रतेजस्तु तयोः त्रिँल्लोकान् प्रदहन्महत् ।\nदह्यमानाः प्रजाः सर्वाः सांवर्तकममंसत"
    },
    {
      "id": "bhagavatam-1-7-31",
      "sequence": 243,
      "chapter": 7,
      "sourceIndex": 31,
      "verse": 32,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.32",
      "original": "प्रजोपप्लवमालक्ष्य लोकव्यतिकरं च तम् ।\nमतं च वासुदेवस्य संजहारार्जुनो द्वयम्"
    },
    {
      "id": "bhagavatam-1-7-32",
      "sequence": 244,
      "chapter": 7,
      "sourceIndex": 32,
      "verse": 33,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.33",
      "original": "तत आसाद्य तरसा दारुणं गौतमीसुतम् ।\nबबंधामर्षताम्राक्षः पशुं रशनया यथा"
    },
    {
      "id": "bhagavatam-1-7-33",
      "sequence": 245,
      "chapter": 7,
      "sourceIndex": 33,
      "verse": 34,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.34",
      "original": "शिबिराय निनीषन्तं रज्ज्वा बद्ध्वा रिपुं बलात् ।\nप्राहार्जुनं प्रकुपितो भगवान् अंबुजेक्षणः"
    },
    {
      "id": "bhagavatam-1-7-34",
      "sequence": 246,
      "chapter": 7,
      "sourceIndex": 34,
      "verse": 35,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.35",
      "original": "मैनं पार्थार्हसि त्रातुं ब्रह्मबंधुमिमं जहि ।\nयो असौ अनागसः सुप्तान् अवधीन्निशि बालकान्"
    },
    {
      "id": "bhagavatam-1-7-35",
      "sequence": 247,
      "chapter": 7,
      "sourceIndex": 35,
      "verse": 36,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.36",
      "original": "मत्तं प्रमत्तमुन्मत्तं सुप्तं बालं स्त्रियं जडम् ।\nप्रपन्नं विरथं भीतं न रिपुं हन्ति धर्मवित्"
    },
    {
      "id": "bhagavatam-1-7-36",
      "sequence": 248,
      "chapter": 7,
      "sourceIndex": 36,
      "verse": 37,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.37",
      "original": "स्वप्राणान्यः परप्राणैः प्रपुष्णात्यघृणः खलः ।\nतद् वधस्तस्य हि श्रेयो यद् दोषाद्यात्यधः पुमान्"
    },
    {
      "id": "bhagavatam-1-7-37",
      "sequence": 249,
      "chapter": 7,
      "sourceIndex": 37,
      "verse": 38,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.38",
      "original": "प्रतिश्रुतं च भवता पाञ्चाल्यै श्रृण्वतो मम ।\nआहरिष्ये शिरस्तस्य यस्ते मानिनि पुत्रहा"
    },
    {
      "id": "bhagavatam-1-7-38",
      "sequence": 250,
      "chapter": 7,
      "sourceIndex": 38,
      "verse": 39,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.39",
      "original": "तदसौ वध्यतां पाप आतताय्यात्मबंधुहा ।\nभर्तुश्च विप्रियं वीर कृतवान् कुलपांसनः"
    },
    {
      "id": "bhagavatam-1-7-39",
      "sequence": 251,
      "chapter": 7,
      "sourceIndex": 39,
      "verse": 40,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.40",
      "original": "सूत उवाच ।\nएवं परीक्षता धर्मं पार्थः कृष्णेन चोदितः ।\nनैच्छद् हन्तुं गुरुसुतं यद्यप्यात्महनं महान्"
    },
    {
      "id": "bhagavatam-1-7-40",
      "sequence": 252,
      "chapter": 7,
      "sourceIndex": 40,
      "verse": 41,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.41",
      "original": "अथोपेत्य स्वशिबिरं गोविंदप्रियसारथिः ।\nन्यवेदयत् तं प्रियायै शोचन्त्या आत्मजान् हतान्"
    },
    {
      "id": "bhagavatam-1-7-41",
      "sequence": 253,
      "chapter": 7,
      "sourceIndex": 41,
      "verse": 42,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.42",
      "original": "तथाहृतं पशुवत्पाशबद्धं\nअवाङ्मुखं कर्मजुगुप्सितेन ।\nनिरीक्ष्य कृष्णापकृतं गुरोः सुतं\nवामस्वभावा कृपया ननाम च",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-7-42",
      "sequence": 254,
      "chapter": 7,
      "sourceIndex": 42,
      "verse": 43,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.43",
      "original": "उवाच चासहन्त्यस्य बंधनानयनं सती ।\nमुच्यतां मुच्यतां एष ब्राह्मणो नितरां गुरुः",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-7-43",
      "sequence": 255,
      "chapter": 7,
      "sourceIndex": 43,
      "verse": 44,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.44",
      "original": "सरहस्यो धनुर्वेदः सविसर्गोपसंयमः ।\nअस्त्रग्रामश्च भवता शिक्षितो यदनुग्रहात्"
    },
    {
      "id": "bhagavatam-1-7-44",
      "sequence": 256,
      "chapter": 7,
      "sourceIndex": 44,
      "verse": 45,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.45",
      "original": "स एष भगवान् द्रोणः प्रजारूपेण वर्तते ।\nतस्यात्मनोऽर्धं पत्‍न्याः ते नान्वगाद् वीरसूः कृपी"
    },
    {
      "id": "bhagavatam-1-7-45",
      "sequence": 257,
      "chapter": 7,
      "sourceIndex": 45,
      "verse": 46,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.46",
      "original": "तद् धर्मज्ञ महाभाग भवद्‌भिः र्गौरवं कुलम् ।\nवृजिनं नार्हति प्राप्तुं पूज्यं वन्द्यमभीक्ष्णशः"
    },
    {
      "id": "bhagavatam-1-7-46",
      "sequence": 258,
      "chapter": 7,
      "sourceIndex": 46,
      "verse": 47,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.47",
      "original": "मा रोदीदस्य जननी गौतमी पतिदेवता ।\nयथाहं मृतवत्साऽर्ता रोदिम्यश्रुमुखी मुहुः"
    },
    {
      "id": "bhagavatam-1-7-47",
      "sequence": 259,
      "chapter": 7,
      "sourceIndex": 47,
      "verse": 48,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.48",
      "original": "यैः कोपितं ब्रह्मकुलं राजन्यैरजितात्मभिः ।\nतत् कुलं प्रदहत्याशु सानुबंधं शुचार्पितम्"
    },
    {
      "id": "bhagavatam-1-7-48",
      "sequence": 260,
      "chapter": 7,
      "sourceIndex": 48,
      "verse": 49,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.49",
      "original": "सूत उवाच ।\nधर्म्यं न्याय्यं सकरुणं निर्व्यलीकं समं महत् ।\nराजा धर्मसुतो राज्ञ्याः प्रत्यनंदद् वचो द्विजाः"
    },
    {
      "id": "bhagavatam-1-7-49",
      "sequence": 261,
      "chapter": 7,
      "sourceIndex": 49,
      "verse": 50,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.50",
      "original": "नकुलः सहदेवश्च युयुधानो धनंजयः ।\nभगवान् देवकीपुत्रो ये चान्ये याश्च योषितः"
    },
    {
      "id": "bhagavatam-1-7-50",
      "sequence": 262,
      "chapter": 7,
      "sourceIndex": 50,
      "verse": 51,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.51",
      "original": "तत्राहामर्षितो भीमः तस्य श्रेयान् वधः स्मृतः ।\nन भर्तुर्नात्मनश्चार्थे योऽहन् सुप्तान् शिशून् वृथा"
    },
    {
      "id": "bhagavatam-1-7-51",
      "sequence": 263,
      "chapter": 7,
      "sourceIndex": 51,
      "verse": 52,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.52",
      "original": "निशम्य भीमगदितं द्रौपद्याश्च चतुर्भुजः ।\nआलोक्य वदनं सख्युः इदमाह हसन्निव"
    },
    {
      "id": "bhagavatam-1-7-52",
      "sequence": 264,
      "chapter": 7,
      "sourceIndex": 52,
      "verse": 53,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.53",
      "original": "श्रीभगवानुवाच ।\nब्रह्मबंधुर्न हन्तव्य आततायी वधार्हणः ।\nमयैवोभयमाम्नातं परिपाह्यनुशासनम्"
    },
    {
      "id": "bhagavatam-1-7-53",
      "sequence": 265,
      "chapter": 7,
      "sourceIndex": 53,
      "verse": 54,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.54",
      "original": "कुरु प्रतिश्रुतं सत्यं यत्तत् सांत्वयता प्रियाम् ।\nप्रियं च भीमसेनस्य पाञ्चाल्या मह्यमेव च"
    },
    {
      "id": "bhagavatam-1-7-54",
      "sequence": 266,
      "chapter": 7,
      "sourceIndex": 54,
      "verse": 55,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.55",
      "original": "सूत उवाच ।\nअर्जुनः सहसाऽऽज्ञाय हरेर्हार्दमथासिना ।\nमणिं जहार मूर्धन्यं द्विजस्य सहमूर्धजम्"
    },
    {
      "id": "bhagavatam-1-7-55",
      "sequence": 267,
      "chapter": 7,
      "sourceIndex": 55,
      "verse": 56,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.56",
      "original": "विमुच्य रशनाबद्धं बालहत्याहतप्रभम् ।\nतेजसा मणिना हीनं शिबिरान् निरयापयत्"
    },
    {
      "id": "bhagavatam-1-7-56",
      "sequence": 268,
      "chapter": 7,
      "sourceIndex": 56,
      "verse": 57,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.57",
      "original": "वपनं द्रविणादानं स्थानान् निर्यापणं तथा ।\nएष हि ब्रह्मबंधूनां वधो नान्योऽस्ति दैहिकः"
    },
    {
      "id": "bhagavatam-1-7-57",
      "sequence": 269,
      "chapter": 7,
      "sourceIndex": 57,
      "verse": 58,
      "section": "Skandha 1, Chapter 07",
      "label": "1.7.58",
      "original": "पुत्रशोकातुराः सर्वे पाण्डवाः सह कृष्णया ।\nस्वानां मृतानां यत्कृत्यं चक्रुर्निर्हरणादिकम्"
    }
  ]
}
