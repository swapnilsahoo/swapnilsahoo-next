    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%A7%E0%A5%A6&oldid=110181",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-10-1",
      "sequence": 371,
      "chapter": 10,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.1",
      "original": "शौनक उवाच ।\nहत्वा स्वरिक्थस्पृध आततायिनो\nयुधिष्ठिरो धर्मभृतां वरिष्ठः ।\nसहानुजैः प्रत्यवरुद्धभोजनः\nकथं प्रवृत्तः किमकारषीत्ततः",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-10-2",
      "sequence": 372,
      "chapter": 10,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.2",
      "original": "सूत उवाच ।\nवंशं कुरोर्वंशदवाग्निनिर्हृतं\nसंरोहयित्वा भवभावनो हरिः ।\nनिवेशयित्वा निजराज्य ईश्वरो\nयुधिष्ठिरं प्रीतमना बभूव ह"
    },
    {
      "id": "bhagavatam-1-10-3",
      "sequence": 373,
      "chapter": 10,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.3",
      "original": "निशम्य भीष्मोक्तमथाच्युतोक्तं\nप्रवृत्त विज्ञान विधूत विभ्रमः ।\nशशास गामिन्द्र इवाजिताश्रयः\nपरिध्युपान्तां अनुजानुवर्तितः"
    },
    {
      "id": "bhagavatam-1-10-4",
      "sequence": 374,
      "chapter": 10,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.4",
      "original": "कामं ववर्ष पर्जन्यः सर्वकामदुघा मही ।\nसिषिचुः स्म व्रजान् गावः पयसोधस्वतीर्मुदा",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-10-5",
      "sequence": 375,
      "chapter": 10,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.5",
      "original": "नद्यः समुद्रा गिरयः सवनस्पतिवीरुधः ।\nफलन्त्योषधयः सर्वाः कामं अन्वृतु तस्य वै"
    },
    {
      "id": "bhagavatam-1-10-6",
      "sequence": 376,
      "chapter": 10,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.6",
      "original": "नाधयो व्याधयः क्लेशा दैवभूतात्महेतवः ।\nअजातशत्रौ अवभवन् जन्तूनां राज्ञि कर्हिचित्"
    },
    {
      "id": "bhagavatam-1-10-7",
      "sequence": 377,
      "chapter": 10,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.7",
      "original": "उषित्वा हास्तिनपुरे मासान् कतिपयान् हरिः ।\nसुहृदां च विशोकाय स्वसुश्च प्रियकाम्यया"
    },
    {
      "id": "bhagavatam-1-10-8",
      "sequence": 378,
      "chapter": 10,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.8",
      "original": "आमंत्र्य चाभ्यनुज्ञातः परिष्वज्याभिवाद्य तम् ।\nआरुरोह रथं कैश्चित् परिष्वक्तोऽभिवादितः"
    },
    {
      "id": "bhagavatam-1-10-9",
      "sequence": 379,
      "chapter": 10,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.9",
      "original": "सुभद्रा द्रौपदी कुन्ती विराटतनया तथा ।\nगान्धारी धृतराष्ट्रश्च युयुत्सुः गौतमो यमौ"
    },
    {
      "id": "bhagavatam-1-10-10",
      "sequence": 380,
      "chapter": 10,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.10",
      "original": "वृकोदरश्च धौम्यश्च स्त्रियो मत्स्यसुतादयः ।\nन सेहिरे विमुह्यन्तो विरहं शार्ङ्गधन्वनः"
    },
    {
      "id": "bhagavatam-1-10-11",
      "sequence": 381,
      "chapter": 10,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.11",
      "original": "सत्सङ्गात् मुक्तदुःसङ्गो हातुं नोत्सहते बुधः ।\nकीर्त्यमानं यशो यस्य सकृत् आकर्ण्य रोचनम्"
    },
    {
      "id": "bhagavatam-1-10-12",
      "sequence": 382,
      "chapter": 10,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.12",
      "original": "तस्मिन् न्यस्तधियः पार्थाः सहेरन् विरहं कथम् ।\nदर्शनस्पर्शसंलाप शयनासन भोजनैः"
    },
    {
      "id": "bhagavatam-1-10-13",
      "sequence": 383,
      "chapter": 10,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.13",
      "original": "सर्वे तेऽनिमिषैः अक्षैः तं अनु द्रुतचेतसः ।\nवीक्षन्तः स्नेहसम्बद्धा विचेलुस्तत्र तत्र ह"
    },
    {
      "id": "bhagavatam-1-10-14",
      "sequence": 384,
      "chapter": 10,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.14",
      "original": "न्यरुन्धन् उद्‍गलत् बाष्पं औत्कण्ठ्यात् देवकीसुते ।\nनिर्यात्यगारात् नोऽभद्रं इति स्यात् बान्धवस्त्रियः"
    },
    {
      "id": "bhagavatam-1-10-15",
      "sequence": 385,
      "chapter": 10,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.15",
      "original": "मृदङ्गशङ्खभेर्यश्च वीणापणव गोमुखाः ।\nधुन्धुर्यानक घण्टाद्या नेदुः दुन्दुभयस्तथा"
    },
    {
      "id": "bhagavatam-1-10-16",
      "sequence": 386,
      "chapter": 10,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.16",
      "original": "प्रासादशिखरारूढाः कुरुनार्यो दिदृक्षया ।\nववृषुः कुसुमैः कृष्णं प्रेमव्रीडास्मितेक्षणाः"
    },
    {
      "id": "bhagavatam-1-10-17",
      "sequence": 387,
      "chapter": 10,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.17",
      "original": "सितातपत्रं जग्राह मुक्तादामविभूषितम् ।\nरत्‍नदण्डं गुडाकेशः प्रियः प्रियतमस्य ह"
    },
    {
      "id": "bhagavatam-1-10-18",
      "sequence": 388,
      "chapter": 10,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.18",
      "original": "उद्धवः सात्यकिश्चैव व्यजने परमाद्‍भुते ।\nविकीर्यमाणः कुसुमै रेजे मधुपतिः पथि"
    },
    {
      "id": "bhagavatam-1-10-19",
      "sequence": 389,
      "chapter": 10,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.19",
      "original": "अश्रूयन्ताशिषः सत्याः तत्र तत्र द्विजेरिताः ।\nनानुरूपानुरूपाश्च निर्गुणस्य गुणात्मनः"
    },
    {
      "id": "bhagavatam-1-10-20",
      "sequence": 390,
      "chapter": 10,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.20",
      "original": "अन्योन्यमासीत् संजल्प उत्तमश्लोकचेतसाम् ।\nकौरवेन्द्रपुरस्त्रीणां सर्वश्रुतिमनोहरः"
    },
    {
      "id": "bhagavatam-1-10-21",
      "sequence": 391,
      "chapter": 10,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.21",
      "original": "स वै किलायं पुरुषः पुरातनो\nय एक आसीदविशेष आत्मनि ।\nअग्रे गुणेभ्यो जगदात्मनीश्वरे\nनिमीलितात्मन्निशि सुप्तशक्तिषु",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-10-22",
      "sequence": 392,
      "chapter": 10,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.22",
      "original": "स एव भूयो निजवीर्यचोदितां\nस्वजीवमायां प्रकृतिं सिसृक्षतीम् ।\nअनामरूपात्मनि रूपनामनी\nविधित्समानोऽनुससार शास्त्रकृत्"
    },
    {
      "id": "bhagavatam-1-10-23",
      "sequence": 393,
      "chapter": 10,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.23",
      "original": "स वा अयं यत्पदमत्र सूरयो\nजितेन्द्रिया निर्जितमातरिश्वनः ।\nपश्यन्ति भक्ति उत्कलितामलात्मना\nनन्वेष सत्त्वं परिमार्ष्टुमर्हति"
    },
    {
      "id": "bhagavatam-1-10-24",
      "sequence": 394,
      "chapter": 10,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.24",
      "original": "स वा अयं सख्यनुगीत सत्कथो\nवेदेषु गुह्येषु च गुह्यवादिभिः ।\nय एक ईशो जगदात्मलीलया\nसृजत्यवत्यत्ति न तत्र सज्जते"
    },
    {
      "id": "bhagavatam-1-10-25",
      "sequence": 395,
      "chapter": 10,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.25",
      "original": "यदा ह्यधर्मेण तमोधियो नृपा\nजीवन्ति तत्रैष हि सत्त्वतः किल ।\nधत्ते भगं सत्यमृतं दयां यशो\nभवाय रूपाणि दधत् युगे युगे"
    },
    {
      "id": "bhagavatam-1-10-26",
      "sequence": 396,
      "chapter": 10,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.26",
      "original": "अहो अलं श्लाघ्यतमं यदोः कुलं\nअहो अलं पुण्यतमं मधोर्वनम् ।\nयदेष पुंसां ऋषभः श्रियः पतिः\nस्वजन्मना चङ्क्रमणेन चाञ्चति"
    },
    {
      "id": "bhagavatam-1-10-27",
      "sequence": 397,
      "chapter": 10,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.27",
      "original": "अहो बत स्वर्यशसः तिरस्करी\nकुशस्थली पुण्ययशस्करी भुवः ।\nपश्यन्ति नित्यं यदनुग्रहेषितं\nस्मितावलोकं स्वपतिं स्म यत्प्रजाः"
    },
    {
      "id": "bhagavatam-1-10-28",
      "sequence": 398,
      "chapter": 10,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.28",
      "original": "नूनं व्रतस्नानहुतादिनेश्वरः\nसमर्चितो ह्यस्य गृहीतपाणिभिः ।\nपिबंति याः सख्यधरामृतं मुहुः\nव्रजस्त्रियः सम्मुमुहुः यदाशयाः"
    },
    {
      "id": "bhagavatam-1-10-29",
      "sequence": 399,
      "chapter": 10,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.29",
      "original": "या वीर्यशुल्केन हृताः स्वयंवरे\nप्रमथ्य चैद्यः प्रमुखान्हि शुष्मिणः ।\nप्रद्युम्न साम्बाम्ब सुतादयोऽपरा\nयाः चाहृता भौमवधे सहस्रशः"
    },
    {
      "id": "bhagavatam-1-10-30",
      "sequence": 400,
      "chapter": 10,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.30",
      "original": "एताः परं स्त्रीत्वमपास्तपेशलं\nनिरस्तशौचं बत साधु कुर्वते ।\nयासां गृहात् पुष्करलोचनः पतिः\nन जातु अपैत्याहृतिभिः हृदि स्पृशन्"
    },
    {
      "id": "bhagavatam-1-10-31",
      "sequence": 401,
      "chapter": 10,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.31",
      "original": "एवंविधा गदन्तीनां स गिरः पुरयोषिताम् ।\nनिरीक्षणेन अभिनन्दन् सस्मितेन ययौ हरिः",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-10-32",
      "sequence": 402,
      "chapter": 10,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.32",
      "original": "अजातशत्रुः पृतनां गोपीथाय मधुद्विषः ।\nपरेभ्यः शङ्कितः स्नेहात् प्रायुङ्क्त चतुरङ्‌गिणीम्"
    },
    {
      "id": "bhagavatam-1-10-33",
      "sequence": 403,
      "chapter": 10,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.33",
      "original": "अथ दूरागतान् शौरिः कौरवान् विरहातुरान् ।\nसन्निवर्त्य दृढं स्निग्धान् प्रायात्स्वनगरीं प्रियैः"
    },
    {
      "id": "bhagavatam-1-10-34",
      "sequence": 404,
      "chapter": 10,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.34",
      "original": "कुरुजाङ्गलपाञ्चालान् शूरसेनान् सयामुनान् ।\nब्रह्मावर्तं कुरुक्षेत्रं मत्स्यान् सारस्वतानथ"
    },
    {
      "id": "bhagavatam-1-10-35",
      "sequence": 405,
      "chapter": 10,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.35",
      "original": "मरुधन्वमतिक्रम्य सौवीराभीरयोः परान् ।\nआनर्तान् भार्गवोपागात् श्रान्तवाहो मनाग्विभुः"
    },
    {
      "id": "bhagavatam-1-10-36",
      "sequence": 406,
      "chapter": 10,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 10",
      "label": "1.10.36",
      "original": "तत्र तत्र ह तत्रत्यैः हरिः प्रत्युद्यतार्हणः ।\nसायं भेजे दिशं पश्चात् गविष्ठो गां गतस्तदा"
    }
  ]
}
