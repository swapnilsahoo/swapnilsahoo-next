  },
  "entries": [
    {
      "id": "bhagavatam-1-14-1",
      "sequence": 541,
      "chapter": 14,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.1",
      "original": "सूत उवाच ।\nसम्प्रस्थिते द्वारकायां जिष्णौ बन्धुदिदृक्षया ।\nज्ञातुं च पुण्यश्लोकस्य कृष्णस्य च विचेष्टितम्"
    },
    {
      "id": "bhagavatam-1-14-2",
      "sequence": 542,
      "chapter": 14,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.2",
      "original": "व्यतीताः कतिचिन्मासाः तदा नायात् ततोऽर्जुनः ।\nददर्श घोररूपाणि निमित्तानि कुरूद्वहः"
    },
    {
      "id": "bhagavatam-1-14-3",
      "sequence": 543,
      "chapter": 14,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.3",
      "original": "कालस्य च गतिं रौद्रां विपर्यस्तर्तुधर्मिणः ।\nपापीयसीं नृणां वार्तां क्रोधलोभानृतात्मनाम्"
    },
    {
      "id": "bhagavatam-1-14-4",
      "sequence": 544,
      "chapter": 14,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.4",
      "original": "जिह्मप्रायं व्यवहृतं शाठ्यमिश्रं च सौहृदम् ।\nपितृमातृसुहृद्‍भ्रातृ दम्पतीनां च कल्कनम्"
    },
    {
      "id": "bhagavatam-1-14-5",
      "sequence": 545,
      "chapter": 14,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.5",
      "original": "निमित्तान्यत्यरिष्टानि काले तु अनुगते नृणाम् ।\nलोभादि अधर्मप्रकृतिं दृष्ट्वोवाचानुजं नृपः"
    },
    {
      "id": "bhagavatam-1-14-6",
      "sequence": 546,
      "chapter": 14,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.6",
      "original": "युधिष्ठिर उवाच ।\nसम्प्रेषितो द्वारकायां जिष्णुर्बन्धु दिदृक्षया ।\nज्ञातुं च पुण्यश्लोकस्य कृष्णस्य च विचेष्टितम्"
    },
    {
      "id": "bhagavatam-1-14-7",
      "sequence": 547,
      "chapter": 14,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.7",
      "original": "गताः सप्ताधुना मासा भीमसेन तवानुजः ।\nनायाति कस्य वा हेतोः नाहं वेदेदमञ्जसा"
    },
    {
      "id": "bhagavatam-1-14-8",
      "sequence": 548,
      "chapter": 14,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.8",
      "original": "अपि देवर्षिणाऽऽदिष्टः स कालोऽयमुपस्थितः ।\nयदाऽऽत्मनोऽङ्‌गमाक्रीडं भगवान् उत्सिसृक्षति"
    },
    {
      "id": "bhagavatam-1-14-9",
      "sequence": 549,
      "chapter": 14,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.9",
      "original": "यस्मान्नः सम्पदो राज्यं दाराः प्राणाः कुलं प्रजाः ।\nआसन् सपत्‍नविजयो लोकाश्च यदनुग्रहात्"
    },
    {
      "id": "bhagavatam-1-14-10",
      "sequence": 550,
      "chapter": 14,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.10",
      "original": "पश्योत्पातान् नरव्याघ्र दिव्यान् भौमान् सदैहिकान् ।\nदारुणान्शंसतोऽदूराद् भयं नो बुद्धिमोहनम्"
    },
    {
      "id": "bhagavatam-1-14-11",
      "sequence": 551,
      "chapter": 14,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.11",
      "original": "ऊर्वक्षिबाहवो मह्यं स्फुरन्त्यङ्‌ग पुनः पुनः ।\nवेपथुश्चापि हृदये आरात् दास्यन्ति विप्रियम्"
    },
    {
      "id": "bhagavatam-1-14-12",
      "sequence": 552,
      "chapter": 14,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.12",
      "original": "शिवैषोद्यन्तं आदित्यं अभिरौति अनलानना ।\nमामङ्‌ग सारमेयोऽयं अभिरेभत्यभीरुवत्"
    },
    {
      "id": "bhagavatam-1-14-13",
      "sequence": 553,
      "chapter": 14,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.13",
      "original": "शस्ताः कुर्वन्ति मां सव्यं दक्षिणं पशवोऽपरे ।\nवाहांश्च पुरुषव्याघ्र लक्षये रुदतो मम"
    },
    {
      "id": "bhagavatam-1-14-14",
      "sequence": 554,
      "chapter": 14,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.14",
      "original": "मृत्युदूतः कपोतोऽयं उलूकः कम्पयन् मनः ।\nप्रत्युलूकश्च कुह्वानैः अनिद्रौ शून्यमिच्छतः"
    },
    {
      "id": "bhagavatam-1-14-15",
      "sequence": 555,
      "chapter": 14,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.15",
      "original": "धूम्रा दिशः परिधयः कम्पते भूः सहाद्रिभिः ।\nनिर्घातश्च महांस्तात साकं च स्तनयित्‍नुभिः"
    },
    {
      "id": "bhagavatam-1-14-16",
      "sequence": 556,
      "chapter": 14,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.16",
      "original": "वायुर्वाति खरस्पर्शो रजसा विसृजंस्तमः ।\nअसृग् वर्षन्ति जलदा बीभत्सं इव सर्वतः"
    },
    {
      "id": "bhagavatam-1-14-17",
      "sequence": 557,
      "chapter": 14,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.17",
      "original": "सूर्यं हतप्रभं पश्य ग्रहमर्दं मिथो दिवि ।\nससङ्‌कुलैर्भूतगणैः ज्वलिते इव रोदसी"
    },
    {
      "id": "bhagavatam-1-14-18",
      "sequence": 558,
      "chapter": 14,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.18",
      "original": "नद्यो नदाश्च क्षुभिताः सरांसि च मनांसि च ।\nन ज्वलत्यग्निराज्येन कालोऽयं किं विधास्यति"
    },
    {
      "id": "bhagavatam-1-14-19",
      "sequence": 559,
      "chapter": 14,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.19",
      "original": "न पिबन्ति स्तनं वत्सा न दुह्यन्ति च मातरः ।\nरुदन्त्यश्रुमुखा गावो न हृष्यन्ति ऋषभा व्रजे"
    },
    {
      "id": "bhagavatam-1-14-20",
      "sequence": 560,
      "chapter": 14,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.20",
      "original": "दैवतानि रुदन्तीव स्विद्यन्ति ह्युच्चलन्ति च ।\nइमे जनपदा ग्रामाः पुरोद्यानाकराश्रमाः ।\nभ्रष्टश्रियो निरानन्दाः किमघं दर्शयन्ति नः"
    },
    {
      "id": "bhagavatam-1-14-21",
      "sequence": 561,
      "chapter": 14,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.21",
      "original": "मन्य एतैर्महोत्पातैः नूनं भगवतः पदैः ।\nअनन्यपुरुषश्रीभिः हीना भूर्हतसौभगा"
    },
    {
      "id": "bhagavatam-1-14-22",
      "sequence": 562,
      "chapter": 14,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.22",
      "original": "इति चिन्तयतस्तस्य दृष्टारिष्टेन चेतसा ।\nराज्ञः प्रत्यागमद् ब्रह्मन् यदुपुर्याः कपिध्वजः"
    },
    {
      "id": "bhagavatam-1-14-23",
      "sequence": 563,
      "chapter": 14,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.23",
      "original": "तं पादयोः निपतितं अयथापूर्वमातुरम् ।\nअधोवदनं अब्बिन्दून् सृजन्तं नयनाब्जयोः"
    },
    {
      "id": "bhagavatam-1-14-24",
      "sequence": 564,
      "chapter": 14,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.24",
      "original": "विलोक्य उद्विग्नहृदयो विच्छायं अनुजं नृपः ।\nपृच्छति स्म सुहृत् मध्ये संस्मरन् नारदेरितम्"
    },
    {
      "id": "bhagavatam-1-14-25",
      "sequence": 565,
      "chapter": 14,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.25",
      "original": "युधिष्ठिर उवाच ।\nकच्चिदानर्तपुर्यां नः स्वजनाः सुखमासते ।\nमधुभोजदशार्हार्ह सात्वतान्धकवृष्णयः"
    },
    {
      "id": "bhagavatam-1-14-26",
      "sequence": 566,
      "chapter": 14,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.26",
      "original": "शूरो मातामहः कच्चित् स्वस्त्यास्ते वाथ मारिषः ।\nमातुलः सानुजः कच्चित् कुशल्यानकदुन्दुभिः"
    },
    {
      "id": "bhagavatam-1-14-27",
      "sequence": 567,
      "chapter": 14,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.27",
      "original": "सप्त स्वसारस्तत्पत्‍न्यो मातुलान्यः सहात्मजाः ।\nआसते सस्नुषाः क्षेमं देवकीप्रमुखाः स्वयम्"
    },
    {
      "id": "bhagavatam-1-14-28",
      "sequence": 568,
      "chapter": 14,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.28",
      "original": "कच्चित् राजाऽऽहुको जीवति असत्पुत्रोऽस्य चानुजः ।\nहृदीकः ससुतोऽक्रूरो जयन्तगदसारणाः"
    },
    {
      "id": "bhagavatam-1-14-29",
      "sequence": 569,
      "chapter": 14,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.29",
      "original": "आसते कुशलं कच्चित् ये च शत्रुजिदादयः ।\nकच्चिदास्ते सुखं रामो भगवान् सात्वतां प्रभुः"
    },
    {
      "id": "bhagavatam-1-14-30",
      "sequence": 570,
      "chapter": 14,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.30",
      "original": "प्रद्युम्नः सर्ववृष्णीनां सुखमास्ते महारथः ।\nगम्भीररयोऽनिरुद्धो वर्धते भगवानुत"
    },
    {
      "id": "bhagavatam-1-14-31",
      "sequence": 571,
      "chapter": 14,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.31",
      "original": "सुषेणश्चारुदेष्णश्च साम्बो जाम्बवतीसुतः ।\nअन्ये च कार्ष्णिप्रवराः सपुत्रा ऋषभादयः"
    },
    {
      "id": "bhagavatam-1-14-32",
      "sequence": 572,
      "chapter": 14,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.32",
      "original": "तथैवानुचराः शौरेः श्रुतदेवोद्धवादयः ।\nसुनन्दनन्दशीर्षण्या ये चान्ये सात्वतर्षभाः"
    },
    {
      "id": "bhagavatam-1-14-33",
      "sequence": 573,
      "chapter": 14,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.33",
      "original": "अपि स्वस्त्यासते सर्वे रामकृष्ण भुजाश्रयाः ।\nअपि स्मरन्ति कुशलं अस्माकं बद्धसौहृदाः"
    },
    {
      "id": "bhagavatam-1-14-34",
      "sequence": 574,
      "chapter": 14,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.34",
      "original": "भगवानपि गोविन्दो ब्रह्मण्यो भक्तवत्सलः ।\nकच्चित्पुरे सुधर्मायां सुखमास्ते सुहृद्‌वृतः"
    },
    {
      "id": "bhagavatam-1-14-35",
      "sequence": 575,
      "chapter": 14,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.35",
      "original": "मङ्‌गलाय च लोकानां क्षेमाय च भवाय च ।\nआस्ते यदुकुलाम्भोधौ आद्योऽनन्तसखः पुमान्"
    },
    {
      "id": "bhagavatam-1-14-36",
      "sequence": 576,
      "chapter": 14,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.36",
      "original": "यद्‍बाहुदण्डगुप्तायां स्वपुर्यां यदवोऽर्चिताः ।\nक्रीडन्ति परमानन्दं महापौरुषिका इव"
    },
    {
      "id": "bhagavatam-1-14-37",
      "sequence": 577,
      "chapter": 14,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.37",
      "original": "यत् पादशुश्रूषणमुख्य कर्मणा\nसत्यादयो द्व्यष्टसहस्रयोषितः ।\nनिर्जित्य सङ्‌ख्ये त्रिदशांस्तदाशिषो\nहरन्ति वज्रायुधवल्लभोचिताः"
    },
    {
      "id": "bhagavatam-1-14-38",
      "sequence": 578,
      "chapter": 14,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.38",
      "original": "यद्‍बाहुदण्डाभ्युदयानुजीविनो\nयदुप्रवीरा ह्यकुतोभया मुहुः ।\nअधिक्रमन्त्यङ्‌घ्रिभिराहृतां बलात्\nसभां सुधर्मां सुरसत्तमोचिताम्"
    },
    {
      "id": "bhagavatam-1-14-39",
      "sequence": 579,
      "chapter": 14,
      "sourceIndex": 39,
      "verse": 39,
      "section": "Skandha 1, Chapter 14",
      "label": "1.14.39",
