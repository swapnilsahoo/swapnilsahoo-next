  },
  "entries": [
    {
      "id": "bhagavatam-1-18-1",
      "sequence": 718,
      "chapter": 18,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.1",
      "original": "सूत उवाच ।\nयो वै द्रौण्यस्त्रविप्लुष्टो न मातुरुदरे मृतः ।\nअनुग्रहाद् भगवतः कृष्णस्याद्‍भुतकर्मणः"
    },
    {
      "id": "bhagavatam-1-18-2",
      "sequence": 719,
      "chapter": 18,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.2",
      "original": "ब्रह्मकोपोत्थिताद् यस्तु तक्षकात् प्राणविप्लवात् ।\nन सम्मुमोहोरुभयाद् भगवत्यर्पिताशयः"
    },
    {
      "id": "bhagavatam-1-18-3",
      "sequence": 720,
      "chapter": 18,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.3",
      "original": "उत्सृज्य सर्वतः सङ्गं विज्ञाताजितसंस्थितिः ।\nवैयासकेर्जहौ शिष्यो गङ्गायां स्वं कलेवरम्"
    },
    {
      "id": "bhagavatam-1-18-4",
      "sequence": 721,
      "chapter": 18,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.4",
      "original": "नोत्तमश्लोकवार्तानां जुषतां तत्कथामृतम् ।\nस्यात्सम्भ्रमोऽन्तकालेऽपि स्मरतां तत्पदाम्बुजम्"
    },
    {
      "id": "bhagavatam-1-18-5",
      "sequence": 722,
      "chapter": 18,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.5",
      "original": "तावत्कलिर्न प्रभवेत् प्रविष्टोऽपीह सर्वतः ।\nयावदीशो महानुर्व्यां आभिमन्यव एकराट्"
    },
    {
      "id": "bhagavatam-1-18-6",
      "sequence": 723,
      "chapter": 18,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.6",
      "original": "यस्मिन्नहनि यर्ह्येव भगवान् उत्ससर्ज गाम् ।\nतदैवेहानुवृत्तोऽसौ अधर्मप्रभवः कलिः"
    },
    {
      "id": "bhagavatam-1-18-7",
      "sequence": 724,
      "chapter": 18,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.7",
      "original": "नानुद्वेष्टि कलिं सम्राट् सारङ्ग इव सारभुक् ।\nकुशलान्याशु सिद्ध्यन्ति नेतराणि कृतानि यत्"
    },
    {
      "id": "bhagavatam-1-18-8",
      "sequence": 725,
      "chapter": 18,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.8",
      "original": "किं नु बालेषु शूरेण कलिना धीरभीरुणा ।\nअप्रमत्तः प्रमत्तेषु यो वृको नृषु वर्तते"
    },
    {
      "id": "bhagavatam-1-18-9",
      "sequence": 726,
      "chapter": 18,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.9",
      "original": "उपवर्णितमेतद् वः पुण्यं पारीक्षितं मया ।\nवासुदेव कथोपेतं आख्यानं यदपृच्छत"
    },
    {
      "id": "bhagavatam-1-18-10",
      "sequence": 727,
      "chapter": 18,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.10",
      "original": "या याः कथा भगवतः कथनीयोरुकर्मणः ।\nगुणकर्माश्रयाः पुम्भिः संसेव्यास्ता बुभूषुभिः"
    },
    {
      "id": "bhagavatam-1-18-11",
      "sequence": 728,
      "chapter": 18,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.11",
      "original": "ऋषय ऊचुः\nसूत जीव समाः सौम्य शाश्वतीर्विशदं यशः ।\nयस्त्वं शंससि कृष्णस्य मर्त्यानां अमृतं हि नः"
    },
    {
      "id": "bhagavatam-1-18-12",
      "sequence": 729,
      "chapter": 18,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.12",
      "original": "कर्मण्यस्मिन् अनाश्वासे धूमधूम्रात्मनां भवान् ।\nआपाययति गोविन्द पादपद्मासवं मधु"
    },
    {
      "id": "bhagavatam-1-18-13",
      "sequence": 730,
      "chapter": 18,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.13",
      "original": "तुलयाम लवेनापि न स्वर्गं नापुनर्भवम् ।\nभगवत् सङ्‌गिसंगस्य मर्त्यानां किमुताशिषः"
    },
    {
      "id": "bhagavatam-1-18-14",
      "sequence": 731,
      "chapter": 18,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.14",
      "original": "को नाम तृप्येद् रसवित्कथायां\nमहत्तमैकान्त परायणस्य ।\nनान्तं गुणानां अगुणस्य जग्मुः\nयोगेश्वरा ये भवपाद्ममुख्याः"
    },
    {
      "id": "bhagavatam-1-18-15",
      "sequence": 732,
      "chapter": 18,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.15",
      "original": "तन्नो भवान् वै भगवत्प्रधानो\nमहत्तमैकान्त परायणस्य ।\nहरेरुदारं चरितं विशुद्धं\nशुश्रूषतां नो वितनोतु विद्वन्"
    },
    {
      "id": "bhagavatam-1-18-16",
      "sequence": 733,
      "chapter": 18,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.16",
      "original": "स वै महाभागवतः परीक्षिद्\nयेनापवर्गाख्यमदभ्रबुद्धिः ।\nज्ञानेन वैयासकिशब्दितेन\nभेजे खगेन्द्रध्वजपादमूलम्"
    },
    {
      "id": "bhagavatam-1-18-17",
      "sequence": 734,
      "chapter": 18,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.17",
      "original": "तन्नः परं पुण्यमसंवृतार्थं\nआख्यानमत्यद्‍भुत योगनिष्ठम् ।\nआख्याह्यनन्ता चरितोपपन्नं\nपारीक्षितं भागवताभिरामम्"
    },
    {
      "id": "bhagavatam-1-18-18",
      "sequence": 735,
      "chapter": 18,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.18",
      "original": "सूत उवाच ।\nअहो वयं जन्मभृतोऽद्य हास्म\nवृद्धानुवृत्त्यापि विलोमजाताः ।\nदौष्कुल्यमाधिं विधुनोति शीघ्रं\nमहत्तमानामभिधानयोगः"
    },
    {
      "id": "bhagavatam-1-18-19",
      "sequence": 736,
      "chapter": 18,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.19",
      "original": "कुतः पुनर्गृणतो नाम तस्य\nमहत्तमैकान्त परायणस्य ।\nयोऽनन्तशक्तिः भगवाननन्तो\nमहद्‍गुणत्वाद् यमनन्तमाहुः"
    },
    {
      "id": "bhagavatam-1-18-20",
      "sequence": 737,
      "chapter": 18,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.20",
      "original": "एतावतालं ननु सूचितेन\nगुणैरसाम्यानतिशायनस्य ।\nहित्वेतरान् प्रार्थयतो विभूतिः\nयस्याङ्‌घ्रिरेणुं जुषतेऽनभीप्सोः"
    },
    {
      "id": "bhagavatam-1-18-21",
      "sequence": 738,
      "chapter": 18,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.21",
      "original": "अथापि यत्पादनखावसृष्टं\nजगद्विरिञ्चोपहृतार्हणाम्भः ।\nसेशं पुनात्यन्यतमो मुकुन्दात्\nको नाम लोके भगवत्पदार्थः"
    },
    {
      "id": "bhagavatam-1-18-22",
      "sequence": 739,
      "chapter": 18,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.22",
      "original": "यत्रानुरक्ताः सहसैव धीरा\nव्यपोह्य देहादिषु सङ्गमूढम् ।\nव्रजन्ति तत्पारमहंस्यमन्त्यं\nयस्मिन्नहिंसोपशमः स्वधर्मः"
    },
    {
      "id": "bhagavatam-1-18-23",
      "sequence": 740,
      "chapter": 18,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.23",
      "original": "अहं हि पृष्टोऽर्यमणो भवद्‌भिः\nआचक्ष आत्मावगमोऽत्र यावान् ।\nनभः पतन्त्यात्मसमं पतत्त्रिणः\nतथा समं विष्णुगतिं विपश्चितः"
    },
    {
      "id": "bhagavatam-1-18-24",
      "sequence": 741,
      "chapter": 18,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.24",
      "original": "एकदा धनुरुद्यम्य विचरन्मृगयां वने ।\nमृगाननुगतः श्रान्तः क्षुधितस्तृषितो भृशम्"
    },
    {
      "id": "bhagavatam-1-18-25",
      "sequence": 742,
      "chapter": 18,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.25",
      "original": "जलाशयमचक्षाणः प्रविवेश तमाश्रमम् ।\nददर्श मुनिमासीनं शान्तं मीलितलोचनम्"
    },
    {
      "id": "bhagavatam-1-18-26",
      "sequence": 743,
      "chapter": 18,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.26",
      "original": "प्रतिरुद्धेन्द्रियप्राण मनोबुद्धिमुपारतम् ।\nस्थानत्रयात्परं प्राप्तं ब्रह्मभूतमविक्रियम्"
    },
    {
      "id": "bhagavatam-1-18-27",
      "sequence": 744,
      "chapter": 18,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.27",
      "original": "विप्रकीर्णजटाच्छन्नं रौरवेणाजिनेन च ।\nविशुष्यत्तालुरुदकं तथाभूतमयाचत"
    },
    {
      "id": "bhagavatam-1-18-28",
      "sequence": 745,
      "chapter": 18,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.28",
      "original": "अलब्धतृणभूम्यादिः असम्प्राप्तार्घ्यसूनृतः ।\nअवज्ञातं इवात्मानं मन्यमानश्चुकोप ह"
    },
    {
      "id": "bhagavatam-1-18-29",
      "sequence": 746,
      "chapter": 18,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.29",
      "original": "अभूतपूर्वः सहसा क्षुत्तृड्भ्यामर्दितात्मनः ।\nब्राह्मणं प्रत्यभूद्‍ब्रह्मन् मत्सरो मन्युरेव च"
    },
    {
      "id": "bhagavatam-1-18-30",
      "sequence": 747,
      "chapter": 18,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.30",
      "original": "स तु ब्रह्मऋषेरंसे गतासुमुरगं रुषा ।\nविनिर्गच्छन् धनुष्कोट्या निधाय पुरमागत्"
    },
    {
      "id": "bhagavatam-1-18-31",
      "sequence": 748,
      "chapter": 18,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.31",
      "original": "एष किं निभृताशेष करणो मीलितेक्षणः ।\nमृषा समाधिराहोस्वित् किं नु स्यात् क्षत्रबन्धुभिः"
    },
    {
      "id": "bhagavatam-1-18-32",
      "sequence": 749,
      "chapter": 18,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.32",
      "original": "तस्य पुत्रोऽतितेजस्वी विहरन् बालकोऽर्भकैः ।\nराज्ञाघं प्रापितं तातं श्रुत्वा तत्रेदमब्रवीत्"
    },
    {
      "id": "bhagavatam-1-18-33",
      "sequence": 750,
      "chapter": 18,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.33",
      "original": "अहो अधर्मः पालानां पीव्नां बलिभुजामिव ।\nस्वामिन्यघं यद् दासानां द्वारपानां शुनामिव"
    },
    {
      "id": "bhagavatam-1-18-34",
      "sequence": 751,
      "chapter": 18,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.34",
      "original": "ब्राह्मणैः क्षत्रबन्धुर्हि गृहपालो निरूपितः ।\nस कथं तद्‍गृहे द्वाःस्थः सभाण्डं भोक्तुमर्हति"
    },
    {
      "id": "bhagavatam-1-18-35",
      "sequence": 752,
      "chapter": 18,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.35",
      "original": "कृष्णे गते भगवति शास्तर्युत्पथगामिनाम् ।\nतद् भिन्नसेतूनद्याहं शास्मि पश्यत मे बलम्"
    },
    {
      "id": "bhagavatam-1-18-36",
      "sequence": 753,
      "chapter": 18,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.36",
      "original": "इत्युक्त्वा रोषताम्राक्षो वयस्यान् ऋषिबालकः ।\nकौशिक्याप उपस्पृश्य वाग्वज्रं विससर्ज ह"
    },
    {
      "id": "bhagavatam-1-18-37",
      "sequence": 754,
      "chapter": 18,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.37",
      "original": "इति लङ्‌घितमर्यादं तक्षकः सप्तमेऽहनि ।\nदङ्क्ष्यति स्म कुलाङ्गारं चोदितो मे ततद्रुहम्"
    },
    {
      "id": "bhagavatam-1-18-38",
      "sequence": 755,
      "chapter": 18,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.38",
      "original": "ततोऽभ्येत्याश्रमं बालो गले सर्पकलेवरम् ।\nपितरं वीक्ष्य दुःखार्तो मुक्तकण्ठो रुरोद ह"
    },
    {
      "id": "bhagavatam-1-18-39",
      "sequence": 756,
      "chapter": 18,
      "sourceIndex": 39,
      "verse": 39,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.39",
      "original": "स वा आङ्‌गिरसो ब्रह्मन् श्रुत्वा सुतविलापनम् ।\nउन्मील्य शनकैर्नेत्रे दृष्ट्वा चांसे मृतोरगम्"
    },
    {
      "id": "bhagavatam-1-18-40",
      "sequence": 757,
      "chapter": 18,
      "sourceIndex": 40,
      "verse": 40,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.40",
      "original": "विसृज्य तं च पप्रच्छ वत्स कस्माद्धि रोदिषि ।\nकेन वा तेऽपकृतं इत्युक्तः स न्यवेदयत्"
    },
    {
      "id": "bhagavatam-1-18-41",
      "sequence": 758,
      "chapter": 18,
      "sourceIndex": 41,
      "verse": 41,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.41",
      "original": "निशम्य शप्तमतदर्हं नरेन्द्रं\nस ब्राह्मणो नात्मजमभ्यनन्दत् ।\nअहो बतांहो महदद्य ते कृतं\nअल्पीयसि द्रोह उरुर्दमो धृतः"
    },
    {
      "id": "bhagavatam-1-18-42",
      "sequence": 759,
      "chapter": 18,
      "sourceIndex": 42,
      "verse": 42,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.42",
      "original": "न वै नृभिर्नरदेवं पराख्यं\nसम्मातुमर्हस्यविपक्वबुद्धे ।\nयत्तेजसा दुर्विषहेण गुप्ता\nविन्दन्ति भद्राण्यकुतोभयाः प्रजाः"
    },
    {
      "id": "bhagavatam-1-18-43",
      "sequence": 760,
      "chapter": 18,
      "sourceIndex": 43,
      "verse": 43,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.43",
      "original": "अलक्ष्यमाणे नरदेवनाम्नि\nरथाङ्गपाणावयमङ्ग लोकः ।\nतदा हि चौरप्रचुरो विनङ्क्ष्यति\nअरक्ष्यमाणोऽविव रूथवत् क्षणात्"
    },
    {
      "id": "bhagavatam-1-18-44",
      "sequence": 761,
      "chapter": 18,
      "sourceIndex": 44,
      "verse": 44,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.44",
      "original": "तदद्य नः पापमुपैत्यनन्वयं\nयन्नष्टनाथस्य वसोर्विलुम्पकात् ।\nपरस्परं घ्नन्ति शपन्ति वृञ्जते\nपशून् स्त्रियोऽर्थाम् पुरुदस्यवो जनाः"
    },
    {
      "id": "bhagavatam-1-18-45",
      "sequence": 762,
      "chapter": 18,
      "sourceIndex": 45,
      "verse": 45,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.45",
      "original": "तदाऽऽर्यधर्मः प्रविलीयते नृणां\nवर्णाश्रमाचारयुतस्त्रयीमयः ।\nततोऽर्थकामाभिनिवेशितात्मनां\nशुनां कपीनामिव वर्णसङ्करः"
    },
    {
      "id": "bhagavatam-1-18-46",
      "sequence": 763,
      "chapter": 18,
      "sourceIndex": 46,
      "verse": 46,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.46",
      "original": "धर्मपालो नरपतिः स तु सम्राड् बृहच्छ्रवाः ।\nसाक्षान् महाभागवतो राजर्षिर्हयमेधयाट्"
    },
    {
      "id": "bhagavatam-1-18-47",
      "sequence": 764,
      "chapter": 18,
      "sourceIndex": 47,
      "verse": 47,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.47",
      "original": "क्षुत्तृट्श्रमयुतो दीनो नैवास्मच्छापमर्हति ॥ ४६.५ ।\nअपापेषु स्वभृत्येषु बालेनापक्वबुद्धिना ।\nपापं कृतं तद्‍भगवान् सर्वात्मा क्षन्तुमर्हति"
    },
    {
      "id": "bhagavatam-1-18-48",
      "sequence": 765,
      "chapter": 18,
      "sourceIndex": 48,
      "verse": 48,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.48",
      "original": "तिरस्कृता विप्रलब्धाः शप्ताः क्षिप्ता हता अपि ।\nनास्य तत्प्रतिकुर्वन्ति तद्‍भक्ताः प्रभवोऽपि हि"
    },
    {
      "id": "bhagavatam-1-18-49",
      "sequence": 766,
      "chapter": 18,
      "sourceIndex": 49,
      "verse": 49,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.49",
      "original": "इति पुत्रकृताघेन सोऽनुतप्तो महामुनिः ।\nस्वयं विप्रकृतो राज्ञा नैवाघं तदचिन्तयत्"
    },
    {
      "id": "bhagavatam-1-18-50",
      "sequence": 767,
      "chapter": 18,
      "sourceIndex": 50,
      "verse": 50,
      "section": "Skandha 1, Chapter 18",
      "label": "1.18.50",
      "original": "प्रायशः साधवो लोके परैर्द्वन्द्वेषु योजिताः ।\nन व्यथन्ति न हृष्यन्ति यत आत्मागुणाश्रयः"
    }
  ]
}
