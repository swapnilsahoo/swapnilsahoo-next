    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%A9&oldid=369178",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-3-1",
      "sequence": 58,
      "chapter": 3,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.1",
      "original": "सूत उवाच।\nजगृहे पौरुषं रूपं भगवान् महदादिभिः।\nसंभूतं षोडशकलं आदौ लोकसिसृक्षया",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-3-2",
      "sequence": 59,
      "chapter": 3,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.2",
      "original": "यस्याम्भसि शयानस्य योगनिद्रां वितन्वतः।\nनाभिह्रदाम्बुजादासीद् ब्रह्मा विश्वसृजां पतिः"
    },
    {
      "id": "bhagavatam-1-3-3",
      "sequence": 60,
      "chapter": 3,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.3",
      "original": "यस्यावयवसंस्थानैः कल्पितो लोकविस्तरः।\nतद् वै भगवतो रूपं विशुद्धं सत्त्वमूर्जितम्"
    },
    {
      "id": "bhagavatam-1-3-4",
      "sequence": 61,
      "chapter": 3,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.4",
      "original": "पश्यन्त्यदोरूपमदभ्रचक्षुषा।\nसहस्रपादोरुभुजाननाद्‍भुतम् ।\nसहस्रमूर्धश्रवणाक्षिनासिकं\nसहस्रमौल्यम्बरकुण्डलोल्लसत्",
      "meter": "इंद्रवंशा"
    },
    {
      "id": "bhagavatam-1-3-5",
      "sequence": 62,
      "chapter": 3,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.5",
      "original": "एतन्नानावताराणां निधानं बीजमव्ययम् ।\nयस्यांशांशेन सृज्यन्ते देवतिर्यङ्नरादयः",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-3-6",
      "sequence": 63,
      "chapter": 3,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.6",
      "original": "स एव प्रथमं देवः कौमारं सर्गमाश्रितः।\nचचार दुश्चरं ब्रह्मा ब्रह्मचर्यमखण्डितम्"
    },
    {
      "id": "bhagavatam-1-3-7",
      "sequence": 64,
      "chapter": 3,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.7",
      "original": "द्वितीयं तु भवायास्य रसातलगतां महीम्।\nउद्धरिष्यन् उपादत्त यज्ञेशः सौकरं वपुः"
    },
    {
      "id": "bhagavatam-1-3-8",
      "sequence": 65,
      "chapter": 3,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.8",
      "original": "तृतीयं ऋषिसर्गं वै देवर्षित्वमुपेत्य सः ।\nतन्त्रं सात्वतमाचष्ट नैष्कर्म्यं कर्मणां यतः"
    },
    {
      "id": "bhagavatam-1-3-9",
      "sequence": 66,
      "chapter": 3,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.9",
      "original": "तुर्ये धर्मकलासर्गे नरनारायणौ ऋषी ।\nभूत्वात्मोपशमोपेतं अकरोद् दुश्चरं तपः"
    },
    {
      "id": "bhagavatam-1-3-10",
      "sequence": 67,
      "chapter": 3,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.10",
      "original": "पञ्चमः कपिलो नाम सिद्धेशः कालविप्लुतम् ।\nप्रोवाचासुरये सांख्यं तत्त्वग्रामविनिर्णयम्"
    },
    {
      "id": "bhagavatam-1-3-11",
      "sequence": 68,
      "chapter": 3,
      "sourceIndex": 11,
      "verse": 12,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.12",
      "original": "षष्ठे अत्रेरपत्यत्वं वृतः प्राप्तोऽनसूयया।\nआन्वीक्षिकीमलर्काय प्रह्लादादिभ्य ऊचिवान्॥११।\nततः सप्तम आकूत्यां रुचेर्यज्ञोऽभ्यजायत ।\nस यामाद्यैः सुरगणैः अपात् स्वायंभुवान्तरम्"
    },
    {
      "id": "bhagavatam-1-3-12",
      "sequence": 69,
      "chapter": 3,
      "sourceIndex": 12,
      "verse": 13,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.13",
      "original": "अष्टमे मेरुदेव्यां तु नाभेर्जात उरुक्रमः ।\nदर्शयन्वर्त्म धीराणां सर्वाश्रम नमस्कृतम्"
    },
    {
      "id": "bhagavatam-1-3-13",
      "sequence": 70,
      "chapter": 3,
      "sourceIndex": 13,
      "verse": 14,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.14",
      "original": "ऋषिभिर्याचितो भेजे नवमं पार्थिवं वपुः ।\nदुग्धेमामोषधीर्विप्राः तेनायं स उशत्तमः"
    },
    {
      "id": "bhagavatam-1-3-14",
      "sequence": 71,
      "chapter": 3,
      "sourceIndex": 14,
      "verse": 15,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.15",
      "original": "रूपं स जगृहे मात्स्यं चाक्षुषोदधिसंप्लवे।\nनाव्यारोप्य महीमय्यां अपाद् वैवस्वतं मनुम्"
    },
    {
      "id": "bhagavatam-1-3-15",
      "sequence": 72,
      "chapter": 3,
      "sourceIndex": 15,
      "verse": 16,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.16",
      "original": "सुरासुराणां उदधिं मथ्नतां मन्दराचलम् ।\nदध्रे कमठरूपेण पृष्ठ एकादशे विभुः"
    },
    {
      "id": "bhagavatam-1-3-16",
      "sequence": 73,
      "chapter": 3,
      "sourceIndex": 16,
      "verse": 17,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.17",
      "original": "धान्वन्तरं द्वादशमं त्रयोदशममेव च।\nअपाययत्सुरान्अन्यान् मोहिन्या मोहयन्स्त्रिया"
    },
    {
      "id": "bhagavatam-1-3-17",
      "sequence": 74,
      "chapter": 3,
      "sourceIndex": 17,
      "verse": 18,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.18",
      "original": "चतुर्दशं नारसिंहं बिभ्रद् दैत्येन्द्रमूर्जितम् ।\nददार करजैरूरौ एरकां कटकृत् यथा"
    },
    {
      "id": "bhagavatam-1-3-18",
      "sequence": 75,
      "chapter": 3,
      "sourceIndex": 18,
      "verse": 19,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.19",
      "original": "पञ्चदशं वामनकं कृत्वागादध्वरं बलेः।\nपदत्रयं याचमानः प्रत्यादित्सुस्त्रिविष्टपम्"
    },
    {
      "id": "bhagavatam-1-3-19",
      "sequence": 76,
      "chapter": 3,
      "sourceIndex": 19,
      "verse": 20,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.20",
      "original": "अवतारे षोडशमे पश्यन् ब्रह्मद्रुहो नृपान् ।\nत्रिःसप्तकृत्वः कुपितो निःक्षत्रां अकरोन्महीम्"
    },
    {
      "id": "bhagavatam-1-3-20",
      "sequence": 77,
      "chapter": 3,
      "sourceIndex": 20,
      "verse": 21,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.21",
      "original": "ततः सप्तदशे जातः सत्यवत्यां पराशरात् ।\nचक्रे वेदतरोः शाखा दृष्ट्वा पुंसोऽल्पमेधसः"
    },
    {
      "id": "bhagavatam-1-3-21",
      "sequence": 78,
      "chapter": 3,
      "sourceIndex": 21,
      "verse": 22,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.22",
      "original": "नरदेवत्वमापन्नः सुरकार्यचिकीर्षया ।\nसमुद्रनिग्रहादीनि चक्रे वीर्याण्यतः परम्"
    },
    {
      "id": "bhagavatam-1-3-22",
      "sequence": 79,
      "chapter": 3,
      "sourceIndex": 22,
      "verse": 23,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.23",
      "original": "एकोनविंशे विंशतिमे वृष्णिषु प्राप्य जन्मनी ।\nरामकृष्णाविति भुवो भगवान् अहरद्भरम्"
    },
    {
      "id": "bhagavatam-1-3-23",
      "sequence": 80,
      "chapter": 3,
      "sourceIndex": 23,
      "verse": 24,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.24",
      "original": "ततः कलौ संप्रवृत्ते सम्मोहाय सुरद्विषाम्।\nबुद्धो नाम्नां जनसुतः कीकटेषु भविष्यति"
    },
    {
      "id": "bhagavatam-1-3-24",
      "sequence": 81,
      "chapter": 3,
      "sourceIndex": 24,
      "verse": 25,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.25",
      "original": "अथासौ युगसंध्यायां दस्युप्रायेषु राजसु ।\nजनिता विष्णुयशसो नाम्ना कल्किर्जगत्पतिः"
    },
    {
      "id": "bhagavatam-1-3-25",
      "sequence": 82,
      "chapter": 3,
      "sourceIndex": 25,
      "verse": 26,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.26",
      "original": "अवतारा ह्यसङ्ख्येया हरेः सत्त्वनिधेर्द्विजाः ।\nयथाविदासिनःकुल्याः सरसः स्युः सहस्रशः"
    },
    {
      "id": "bhagavatam-1-3-26",
      "sequence": 83,
      "chapter": 3,
      "sourceIndex": 26,
      "verse": 27,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.27",
      "original": "ऋषयो मनवो देवा मनुपुत्रा महौजसः।\nकलाः सर्वे हरेरेव सप्रजापतयः तथा"
    },
    {
      "id": "bhagavatam-1-3-27",
      "sequence": 84,
      "chapter": 3,
      "sourceIndex": 27,
      "verse": 28,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.28",
      "original": "एते चांशकलाःपुंसःकृष्णस्तु भगवान्स्वयम् ।\nइन्द्रारिव्याकुलं लोकं मृडयन्ति युगे युगे"
    },
    {
      "id": "bhagavatam-1-3-28",
      "sequence": 85,
      "chapter": 3,
      "sourceIndex": 28,
      "verse": 29,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.29",
      "original": "जन्म गुह्यं भगवतो य एतत्प्रयतो नरः।\nसायंप्रातर्गृणन्भक्त्या दुःखग्रामाद् विमुच्यते"
    },
    {
      "id": "bhagavatam-1-3-29",
      "sequence": 86,
      "chapter": 3,
      "sourceIndex": 29,
      "verse": 30,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.30",
      "original": "एतद् रूपं भगवतो ह्यरूपस्य चिदात्मनः ।\nमायागुणैर्विरचितं महदादिभिरात्मनि"
    },
    {
      "id": "bhagavatam-1-3-30",
      "sequence": 87,
      "chapter": 3,
      "sourceIndex": 30,
      "verse": 31,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.31",
      "original": "यथा नभसि मेघौघो रेणुर्वा पार्थिवोऽनिले ।\nएवं द्रष्टरि दृश्यत्वं आरोपितं अबुद्धिभिः"
    },
    {
      "id": "bhagavatam-1-3-31",
      "sequence": 88,
      "chapter": 3,
      "sourceIndex": 31,
      "verse": 33,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.33",
      "original": "अतः परं यदव्यक्तं अव्यूढगुणबृंहितम्।\nअदृष्टाश्रुतवस्तुत्वात् स जीवो यत् पुनर्भवः॥३२।\nयत्रेमे सदसद् रूपे प्रतिषिद्धे स्वसंविदा ।\nअविद्ययाऽऽत्मनि कृते इति तद्ब्रह्मदर्शनम्"
    },
    {
      "id": "bhagavatam-1-3-32",
      "sequence": 89,
      "chapter": 3,
      "sourceIndex": 32,
      "verse": 34,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.34",
      "original": "यद्येषोपरता देवी माया वैशारदी मतिः ।\nसंपन्न एवेति विदुः महिम्नि स्वे महीयते"
    },
    {
      "id": "bhagavatam-1-3-33",
      "sequence": 90,
      "chapter": 3,
      "sourceIndex": 33,
      "verse": 35,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.35",
      "original": "एवं जन्मानि कर्माणि ह्यकर्तुरजनस्य च ।\nवर्णयन्ति स्म कवयो वेदगुह्यानि हृत्पतेः"
    },
    {
      "id": "bhagavatam-1-3-34",
      "sequence": 91,
      "chapter": 3,
      "sourceIndex": 34,
      "verse": 36,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.36",
      "original": "स वा इदं विश्वममोघलीलः\nसृजत्यवत्यत्ति न सज्जतेऽस्मिन्।\nभूतेषु चान्तर्हित आत्मतंत्रः\nषाड्वर्गिकं जिघ्रति षड्गुणेशः",
      "meter": "उपेंद्रवज्रा"
    },
    {
      "id": "bhagavatam-1-3-35",
      "sequence": 92,
      "chapter": 3,
      "sourceIndex": 35,
      "verse": 37,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.37",
      "original": "न चास्य कश्चिन्निपुणेन धातुः\nअवैति जन्तुः कुमनीष ऊतीः।\nनामानि रूपाणि मनोवचोभिः\nसन्तन्वतो नटचर्यामिवाज्ञः"
    },
    {
      "id": "bhagavatam-1-3-36",
      "sequence": 93,
      "chapter": 3,
      "sourceIndex": 36,
      "verse": 38,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.38",
      "original": "स वेद धातुः पदवीं परस्य\nदुरन्तवीर्यस्य रथाङ्गपाणेः।\nयोऽमायय ासन्ततयानुवृत्त्या\nभजेत तत्पादसरोजगन्धम्"
    },
    {
      "id": "bhagavatam-1-3-37",
      "sequence": 94,
      "chapter": 3,
      "sourceIndex": 37,
      "verse": 39,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.39",
      "original": "अथेह धन्या भगवन्त इत्थं\nयद्‌वासुदेवेऽखिललोकनाथे।\nकुर्वन्ति सर्वात्मकमात्मभावं\nन यत्र भूयः परिवर्तउग्रः"
    },
    {
      "id": "bhagavatam-1-3-38",
      "sequence": 95,
      "chapter": 3,
      "sourceIndex": 38,
      "verse": 40,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.40",
      "original": "इदं भागवतं नाम पुराणं ब्रह्मसम्मितम् ।\nउत्तमश्लोकचरितं चकार भगवान् ऋषिः"
    },
    {
      "id": "bhagavatam-1-3-39",
      "sequence": 96,
      "chapter": 3,
      "sourceIndex": 39,
      "verse": 41,
      "section": "Skandha 1, Chapter 03",
      "label": "1.3.41",
