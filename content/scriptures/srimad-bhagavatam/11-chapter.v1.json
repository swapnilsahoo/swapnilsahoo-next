    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-11-1",
      "sequence": 407,
      "chapter": 11,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.1",
      "original": "सूत उवाच ।\nआनर्तान् स उपव्रज्य स्वृद्धाञ्जनपदान् स्वकान् ।\nदध्मौ दरवरं तेषां विषादं शमयन्निव"
    },
    {
      "id": "bhagavatam-1-11-2",
      "sequence": 408,
      "chapter": 11,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.2",
      "original": "स उच्चकाशे धवलोदरो दरोऽपि\nउरुक्रमस्य अधरशोण शोणिमा ।\nदाध्मायमानः करकञ्जसम्पुटे\nयथाब्जखण्डे कलहंस उत्स्वनः"
    },
    {
      "id": "bhagavatam-1-11-3",
      "sequence": 409,
      "chapter": 11,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.3",
      "original": "तमुपश्रुत्य निनदं जगद्‍भयभयावहम् ।\nप्रत्युद्ययुः प्रजाः सर्वा भर्तृदर्शनलालसाः"
    },
    {
      "id": "bhagavatam-1-11-4",
      "sequence": 410,
      "chapter": 11,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.4",
      "original": "तत्रोपनीतबलयो रवेर्दीपमिवादृताः ।\nआत्मारामं पूर्णकामं निजलाभेन नित्यदा"
    },
    {
      "id": "bhagavatam-1-11-5",
      "sequence": 411,
      "chapter": 11,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.5",
      "original": "प्रीत्युत्फुल्लमुखाः प्रोचुः हर्षगद्‍गदया गिरा ।\nपितरं सर्वसुहृदं अवितारं इवार्भकाः"
    },
    {
      "id": "bhagavatam-1-11-6",
      "sequence": 412,
      "chapter": 11,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.6",
      "original": "नताः स्म ते नाथ सदाङ्‌घ्रिपङ्‌कजं\nविरिञ्चवैरिञ्च्य सुरेन्द्र वन्दितम् ।\nपरायणं क्षेममिहेच्छतां परं\nन यत्र कालः प्रभवेत्परः प्रभुः"
    },
    {
      "id": "bhagavatam-1-11-7",
      "sequence": 413,
      "chapter": 11,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.7",
      "original": "भवाय नस्त्वं भव विश्वभावन\nत्वमेव माताथ सुहृत्पतिः पिता ।\nत्वं सद्‍गुरुर्नः परमं च दैवतं\nयस्यानुवृत्त्या कृतिनो बभूविम"
    },
    {
      "id": "bhagavatam-1-11-8",
      "sequence": 414,
      "chapter": 11,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.8",
      "original": "अहो सनाथा भवता स्म यद्वयं\nत्रैविष्टपानामपि दूरदर्शनम् ।\nप्रेमस्मित स्निग्ध निरीक्षणाननं\nपश्येम रूपं तव सर्वसौभगम्"
    },
    {
      "id": "bhagavatam-1-11-9",
      "sequence": 415,
      "chapter": 11,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.9",
      "original": "यर्ह्यम्बुजाक्षापससार भो भवान्\nकुरून् मधून् वाथ सुहृद् दिदृक्षया ।\nतत्राब्दकोटिप्रतिमः क्षणो भवेद्\nरविं विनाक्ष्णोरिव नस्तवाच्युत"
    },
    {
      "id": "bhagavatam-1-11-10",
      "sequence": 416,
      "chapter": 11,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.10",
      "original": "इति चोदीरिता वाचः प्रजानां भक्तवत्सलः ।\nशृण्वानोऽनुग्रहं दृष्ट्या वितन्वन् प्राविशत्पुरम्"
    },
    {
      "id": "bhagavatam-1-11-11",
      "sequence": 417,
      "chapter": 11,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.11",
      "original": "मधुभोजदशार्हार्ह कुकुरान्धक वृष्णिभिः ।\nआत्मतुल्य बलैर्गुप्तां नागैर्भोगवतीमिव"
    },
    {
      "id": "bhagavatam-1-11-12",
      "sequence": 418,
      "chapter": 11,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.12",
      "original": "सर्वर्तु सर्वविभव पुण्यवृक्षलताश्रमैः ।\nउद्यानोपवनारामैः वृत पद्माकर श्रियम्"
    },
    {
      "id": "bhagavatam-1-11-13",
      "sequence": 419,
      "chapter": 11,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.13",
      "original": "गोपुरद्वारमार्गेषु कृतकौतुक तोरणाम् ।\nचित्रध्वजपताकाग्रैः अन्तः प्रतिहतातपाम्"
    },
    {
      "id": "bhagavatam-1-11-14",
      "sequence": 420,
      "chapter": 11,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.14",
      "original": "सम्मार्जित महामार्ग रथ्यापणक चत्वराम् ।\nसिक्तां गन्धजलैरुप्तां फलपुष्पाक्षताङ्‌कुरैः"
    },
    {
      "id": "bhagavatam-1-11-15",
      "sequence": 421,
      "chapter": 11,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.15",
      "original": "द्वारि द्वारि गृहाणां च दध्यक्षत फलेक्षुभिः ।\nअलङ्‌कृतां पूर्णकुम्भैः बलिभिः धूपदीपकैः"
    },
    {
      "id": "bhagavatam-1-11-16",
      "sequence": 422,
      "chapter": 11,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.16",
      "original": "निशम्य प्रेष्ठमायान्तं वसुदेवो महामनाः ।\nअक्रूरश्चोग्रसेनश्च रामश्चाद्‍भुतविक्रमः"
    },
    {
      "id": "bhagavatam-1-11-17",
      "sequence": 423,
      "chapter": 11,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.17",
      "original": "प्रद्युम्नः चारुदेष्णश्च साम्बो जाम्बवतीसुतः ।\nप्रहर्षवेग उच्छशित शयनासन भोजनाः"
    },
    {
      "id": "bhagavatam-1-11-18",
      "sequence": 424,
      "chapter": 11,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.18",
      "original": "वारणेन्द्रं पुरस्कृत्य ब्राह्मणैः ससुमङ्‌गलैः ।\nशङ्‌खतूर्य निनादेन ब्रह्मघोषेण चादृताः ।\nप्रत्युज्जग्मू रथैर्हृष्टाः प्रणयागत साध्वसाः"
    },
    {
      "id": "bhagavatam-1-11-19",
      "sequence": 425,
      "chapter": 11,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.19",
      "original": "वारमुख्याश्च शतशो यानैः तत् दर्शनोत्सुकाः ।\nलसत्कुण्डल निर्भात कपोल वदनश्रियः"
    },
    {
      "id": "bhagavatam-1-11-20",
      "sequence": 426,
      "chapter": 11,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.20",
      "original": "नटनर्तकगन्धर्वाः सूत मागध वन्दिनः ।\nगायन्ति चोत्तमश्लोक चरितानि अद्‍भुतानि च"
    },
    {
      "id": "bhagavatam-1-11-21",
      "sequence": 427,
      "chapter": 11,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.21",
      "original": "भगवान् तत्र बन्धूनां पौराणां अनुवर्तिनाम् ।\nयथाविधि उपसङ्‌गम्य सर्वेषां मानमादधे"
    },
    {
      "id": "bhagavatam-1-11-22",
      "sequence": 428,
      "chapter": 11,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.22",
      "original": "प्रह्वाभिवादन आश्लेष करस्पर्श स्मितेक्षणैः ।\nआश्वास्य चाश्वपाकेभ्यो वरैश्च अभिमतैर्विभुः"
    },
    {
      "id": "bhagavatam-1-11-23",
      "sequence": 429,
      "chapter": 11,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.23",
      "original": "स्वयं च गुरुभिर्विप्रैः सदारैः स्थविरैरपि ।\nआशीर्भिः युज्यमानोऽन्यैः वन्दिभिश्चाविशत् पुरम्"
    },
    {
      "id": "bhagavatam-1-11-24",
      "sequence": 430,
      "chapter": 11,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.24",
      "original": "राजमार्गं गते कृष्णे द्वारकायाः कुलस्त्रियः ।\nहर्म्याण्यारुरुहुर्विप्र तदीक्षण महोत्सवाः"
    },
    {
      "id": "bhagavatam-1-11-25",
      "sequence": 431,
      "chapter": 11,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.25",
      "original": "नित्यं निरीक्षमाणानां यदपि द्वारकौकसाम् ।\nन वितृप्यन्ति हि दृशः श्रियो धामाङ्‌गमच्युतम्"
    },
    {
      "id": "bhagavatam-1-11-26",
      "sequence": 432,
      "chapter": 11,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.26",
      "original": "श्रियो निवासो यस्योरः पानपात्रं मुखं दृशाम् ।\nबाहवो लोकपालानां सारङ्‌गाणां पदाम्बुजम्"
    },
    {
      "id": "bhagavatam-1-11-27",
      "sequence": 433,
      "chapter": 11,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.27",
      "original": "सितातपत्रव्यजनैः उपस्कृतः\nनवर्षैः अभिवर्षितः पथि ।\nपिशङ्‌गवासा वनमालया बभौ\nयथार्कोडुप चाप वैद्युतैः"
    },
    {
      "id": "bhagavatam-1-11-28",
      "sequence": 434,
      "chapter": 11,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.28",
      "original": "प्रविष्टस्तु गृहं पित्रोः परिष्वक्तः स्वमातृभिः ।\nववन्दे शिरसा सप्त देवकीप्रमुखा मुदा"
    },
    {
      "id": "bhagavatam-1-11-29",
      "sequence": 435,
      "chapter": 11,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.29",
      "original": "ताः पुत्रमङ्‌कं आरोप्य स्नेहस्नुत पयोधराः ।\nहर्षविह्वलितात्मानः सिषिचुः नेत्रजैर्जलैः"
    },
    {
      "id": "bhagavatam-1-11-30",
      "sequence": 436,
      "chapter": 11,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.30",
      "original": "अथाविशत् स्वभवनं सर्वकाममनुत्तमम् ।\nप्रासादा यत्र पत्‍नीनां सहस्राणि च षोडश"
    },
    {
      "id": "bhagavatam-1-11-31",
      "sequence": 437,
      "chapter": 11,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.31",
      "original": "पत्‍न्यः पतिं प्रोष्य गृहानुपागतं\nक्य सञ्जात मनोमहोत्सवाः ।\nउत्तस्थुरारात् सहसासनाशयात्\nव्रतैः व्रीडित लोचनाननाः"
    },
    {
      "id": "bhagavatam-1-11-32",
      "sequence": 438,
      "chapter": 11,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.32",
      "original": "तं आत्मजैः दृष्टिभिरन्तरात्मना\nदुरन्तभावाः परिरेभिरे पतिम् ।\nनिरुद्धमप्यास्रवदम्बु नेत्रयोः\nविलज्जतीनां भृगुवर्य वैक्लवात्"
    },
    {
      "id": "bhagavatam-1-11-33",
      "sequence": 439,
      "chapter": 11,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.33",
      "original": "यद्यप्यसौ पार्श्वगतो रहोगतः\nतथापि तस्याङ्‌घ्रियुगं नवं नवम् ।\nपदे पदे का विरमेत तत्पदात्\nचलापि यच्छ्रीर्न जहाति कर्हिचित्"
    },
    {
      "id": "bhagavatam-1-11-34",
      "sequence": 440,
      "chapter": 11,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.34",
      "original": "एवं नृपाणां क्षितिभारजन्मनां\nअक्षौहिणीभिः परिवृत्ततेजसाम् ।\nविधाय वैरं श्वसनो यथानलं\nमिथो वधेनोपरतो निरायुधः"
    },
    {
      "id": "bhagavatam-1-11-35",
      "sequence": 441,
      "chapter": 11,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.35",
      "original": "स एष नरलोकेऽस्मिन् अवतीर्णः स्वमायया ।\nरेमे स्त्रीरत्‍नकूटस्थो भगवान् प्राकृतो यथा"
    },
    {
      "id": "bhagavatam-1-11-36",
      "sequence": 442,
      "chapter": 11,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.36",
      "original": "उद्दामभाव पिशुनामल वल्गुहास ।\nव्रीडावलोकनिहतो मदनोऽपि यासाम् ॥\nसम्मुह्य चापमजहात् प्रमदोत्तमास्ता ।\nयस्येन्द्रियं विमथितुं कुहकैर्न शेकुः"
    },
    {
      "id": "bhagavatam-1-11-37",
      "sequence": 443,
      "chapter": 11,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.37",
      "original": "तमयं मन्यते लोको ह्यसङ्‌गमपि सङ्‌गिनम् ।\nआत्मौपम्येन मनुजं व्यापृण्वानं यतोऽबुधः"
    },
    {
      "id": "bhagavatam-1-11-38",
      "sequence": 444,
      "chapter": 11,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 11",
      "label": "1.11.38",
