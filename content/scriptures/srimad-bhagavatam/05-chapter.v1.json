    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%AB&oldid=110176",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-5-1",
      "sequence": 134,
      "chapter": 5,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.1",
      "original": "सूत उवाच ।\nअथ तं सुखमासीन उपासीनं बृहच्छ्रवाः ।\nदेवर्षिः प्राह विप्रर्षिं वीणापाणिः स्मयन्निव",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-5-2",
      "sequence": 135,
      "chapter": 5,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.2",
      "original": "नारद उवाच ।\nपाराशर्य महाभाग भवतः कच्चिदात्मना ।\nपरितुष्यति शारीर आत्मा मानस एव वा"
    },
    {
      "id": "bhagavatam-1-5-3",
      "sequence": 136,
      "chapter": 5,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.3",
      "original": "जिज्ञासितं सुसंपन्नं अपि ते महदद्‍भुतम् ।\nकृतवान् भारतं यस्त्वं सर्वार्थपरिबृंहितम्"
    },
    {
      "id": "bhagavatam-1-5-4",
      "sequence": 137,
      "chapter": 5,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.4",
      "original": "जिज्ञासितमधीतं च यत्तद् ब्रह्म सनातनम् ।\nतथापि शोचस्यात्मानं अकृतार्थ इव प्रभो"
    },
    {
      "id": "bhagavatam-1-5-5",
      "sequence": 138,
      "chapter": 5,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.5",
      "original": "व्यास उवाच ।\nअस्त्येव मे सर्वमिदं त्वयोक्तं\nतथापि नात्मा परितुष्यते मे ।\nतन्मूलमव्यक्तमगाधबोधं\nपृच्छामहे त्वात्मभवात्मभूतम्",
      "meter": "उपेंद्रवज्रा"
    },
    {
      "id": "bhagavatam-1-5-6",
      "sequence": 139,
      "chapter": 5,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.6",
      "original": "स वै भवान् वेद समस्तगुह्यं\nउपासितो यत्पुरुषः पुराणः ।\nपरावरेशो मनसैव विश्वं\nसृजत्यवत्यत्ति गुणैरसङ्गः"
    },
    {
      "id": "bhagavatam-1-5-7",
      "sequence": 140,
      "chapter": 5,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.7",
      "original": "त्वं पर्यटन्नर्क इव त्रिलोकीं\nअन्तश्चरो वायुरिवात्मसाक्षी ।\nपरावरे ब्रह्मणि धर्मतो व्रतैः\nस्नातस्य मे न्यूनमलं विचक्ष्व"
    },
    {
      "id": "bhagavatam-1-5-8",
      "sequence": 141,
      "chapter": 5,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.8",
      "original": "श्रीनारद उवाच ।\nभवतानुदितप्रायं यशो भगवतोऽमलम् ।\nयेनैवासौ न तुष्येत मन्ये तद्दर्शनं खिलम्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-5-9",
      "sequence": 142,
      "chapter": 5,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.9",
      "original": "यथा धर्मादयश्चार्था मुनिवर्यानुकीर्तिताः ।\nन तथा वासुदेवस्य महिमा ह्यनुवर्णितः"
    },
    {
      "id": "bhagavatam-1-5-10",
      "sequence": 143,
      "chapter": 5,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.10",
      "original": "न यद् वचश्चित्रपदं हरेर्यशो\nजगत्पवित्रं प्रगृणीत कर्हिचित् ।\nतद्वायसं तीर्थमुशन्ति मानसा\nन यत्र हंसा निरमन्त्युशिक्क्षयाः",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-5-11",
      "sequence": 144,
      "chapter": 5,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.11",
      "original": "तद्वाग्विसर्गो जनताघविप्लवो\nयस्मिन् प्रतिश्लोकमबद्धवत्यपि ।\nनामान्यनन्तस्य यशोऽङ्‌कितानि यत्\nश्रृण्वन्ति गायन्ति गृणन्ति साधवः"
    },
    {
      "id": "bhagavatam-1-5-12",
      "sequence": 145,
      "chapter": 5,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.12",
      "original": "नैष्कर्म्यमप्यच्युतभाववर्जितं\nन शोभते ज्ञानमलं निरञ्जनम् ।\nकुतः पुनः शश्वदभद्रमीश्वरे\nन चार्पितं कर्म यदप्यकारणम्"
    },
    {
      "id": "bhagavatam-1-5-13",
      "sequence": 146,
      "chapter": 5,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.13",
      "original": "अथो महाभाग भवानमोघदृक्\nशुचिश्रवाः सत्यरतो धृतव्रतः ।\nउरुक्रमस्याखिलबंधमुक्तये\nसमाधिनानुस्मर तद्‌विचेष्टितम्"
    },
    {
      "id": "bhagavatam-1-5-14",
      "sequence": 147,
      "chapter": 5,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.14",
      "original": "ततोऽन्यथा किञ्चन यद्‌विवक्षतः\nपृथग् दृशस्तत् कृतरूपनामभिः ।\nन कर्हिचित् क्वापि च दुःस्थिता मतिः\nलभेत वाताहतनौरिवास्पदम्"
    },
    {
      "id": "bhagavatam-1-5-15",
      "sequence": 148,
      "chapter": 5,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.15",
      "original": "जुगुप्सितं धर्मकृतेऽनुशासतः\nस्वभावरक्तस्य महान् व्यतिक्रमः ।\nयद्‌वाक्यतो धर्म इतीतरः स्थितो\nन मन्यते तस्य निवारणं जनः"
    },
    {
      "id": "bhagavatam-1-5-16",
      "sequence": 149,
      "chapter": 5,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.16",
      "original": "विचक्षणोऽस्यार्हति वेदितुं विभोः\nअनन्तपारस्य निवृत्तितः सुखम् ।\nप्रवर्तमानस्य गुणैरनात्मनः\nततो भवान् दर्शय चेष्टितं विभोः"
    },
    {
      "id": "bhagavatam-1-5-17",
      "sequence": 150,
      "chapter": 5,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.17",
      "original": "त्यक्त्वा स्वधर्मं चरणाम्बुजं हरेः\nभजन् अपक्वोऽथ पतेत् ततो यदि ।\nयत्र क्व वाभद्रमभूदमुष्य किं\nको वार्थ आप्तोऽभजतां स्वधर्मतः"
    },
    {
      "id": "bhagavatam-1-5-18",
      "sequence": 151,
      "chapter": 5,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.18",
      "original": "तस्यैव हेतोः प्रयतेत कोविदो\nन लभ्यते यद्‍भ्रमतामुपर्यधः ।\nतल्लभ्यते दुःखवदन्यतः सुखं\nकालेन सर्वत्र गभीररंहसा",
      "meter": "इंद्रवंशा"
    },
    {
      "id": "bhagavatam-1-5-19",
      "sequence": 152,
      "chapter": 5,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.19",
      "original": "न वै जनो जातु कथञ्चनाव्रजेत्\nमुकुंदसेव्यन्यवदङ्ग संसृतिम् ।\nस्मरन् मुकुंदाङ्घ्र्युपगूहनं पुनः\nविहातुमिच्छेन्न रसग्रहो जनः",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-5-20",
      "sequence": 153,
      "chapter": 5,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.20",
      "original": "इदं हि विश्वं भगवानिवेतरो\nयतो जगत्स्थाननिरोधसंभवाः ।\nतद्धि स्वयं वेद भवांस्तथापि वै\nप्रादेशमात्रं भवतः प्रदर्शितम्"
    },
    {
      "id": "bhagavatam-1-5-21",
      "sequence": 154,
      "chapter": 5,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.21",
      "original": "त्वमात्मनात्मानमवेह्यमोघदृक्\nपरस्य पुंसः परमात्मनः कलाम् ।\nअजं प्रजातं जगतः शिवाय तन्\nमहानुभावाभ्युदयोऽधिगण्यताम्"
    },
    {
      "id": "bhagavatam-1-5-22",
      "sequence": 155,
      "chapter": 5,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.22",
      "original": "इदं हि पुंसस्तपसः श्रुतस्य वा\nस्विष्टस्य सूक्तस्य च बुद्धिदत्तयोः ।\nअविच्युतोऽर्थः कविभिर्निरूपितो\nयदुत्तमश्लोक गुणानुवर्णनम्"
    },
    {
      "id": "bhagavatam-1-5-23",
      "sequence": 156,
      "chapter": 5,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.23",
      "original": "अहं पुरातीतभवेऽभवं मुने\nदास्यास्तु कस्याश्चन वेदवादिनाम् ।\nनिरूपितो बालक एव योगिनां\nशुश्रूषणे प्रावृषि निर्विविक्षताम्",
      "meter": "इंद्रवंशा"
    },
    {
      "id": "bhagavatam-1-5-24",
      "sequence": 157,
      "chapter": 5,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.24",
      "original": "ते मय्यपेताखिलचापलेऽर्भके\nदान्तेऽधृतक्रीडनकेऽनुवर्तिनि ।\nचक्रुः कृपां यद्यपि तुल्यदर्शनाः\nशुश्रूषमाणे मुनयोऽल्पभाषिणि"
    },
    {
      "id": "bhagavatam-1-5-25",
      "sequence": 158,
      "chapter": 5,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.25",
      "original": "उच्छिष्टलेपाननुमोदितो द्विजैः\nसकृत्स्म भुञ्जे तदपास्तकिल्बिषः ।\nएवं प्रवृत्तस्य विशुद्धचेतसः\nतद्धर्म एवात्मरुचिः प्रजायते"
    },
    {
      "id": "bhagavatam-1-5-26",
      "sequence": 159,
      "chapter": 5,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.26",
      "original": "तत्रान्वहं कृष्णकथाः प्रगायतां\nअनुग्रहेणाश्रृणवं मनोहराः ।\nताः श्रद्धया मेऽनुपदं विश्रृण्वतः\nप्रियश्रवस्यङ्ग ममाभवद् रुचिः",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-5-27",
      "sequence": 160,
      "chapter": 5,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.27",
      "original": "तस्मिंस्तदा लब्धरुचेर्महामते\nप्रियश्रवस्यस्खलिता मतिर्मम ।\nययाहमेतत् सदसत्स्वमायया\nपश्ये मयि ब्रह्मणि कल्पितं परे",
      "meter": "इंद्रवंशा"
    },
    {
      "id": "bhagavatam-1-5-28",
      "sequence": 161,
      "chapter": 5,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.28",
      "original": "इत्थं शरत् प्रावृषिकावृतू हरेः\nविश्रृण्वतो मेऽनुसवं यशोऽमलम् ।\nसङ्कीर्त्यमानं मुनिभिर्महात्मभिः\nभक्तिः प्रवृत्ताऽऽत्मरजस्तमोपहा"
    },
    {
      "id": "bhagavatam-1-5-29",
      "sequence": 162,
      "chapter": 5,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.29",
      "original": "तस्यैवं मेऽनुरक्तस्य प्रश्रितस्य हतैनसः ।\nश्रद्दधानस्य बालस्य दान्तस्यानुचरस्य च",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-5-30",
      "sequence": 163,
      "chapter": 5,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.30",
      "original": "ज्ञानं गुह्यतमं यत्तत् साक्षाद्‍भगवतोदितम् ।\nअन्ववोचन् गमिष्यन्तः कृपया दीनवत्सलाः"
    },
    {
      "id": "bhagavatam-1-5-31",
      "sequence": 164,
      "chapter": 5,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.31",
      "original": "येनैवाहं भगवतो वासुदेवस्य वेधसः ।\nमायानुभावमविदं येन गच्छन्ति तत्पदम्"
    },
    {
      "id": "bhagavatam-1-5-32",
      "sequence": 165,
      "chapter": 5,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.32",
      "original": "एतत् संसूचितं ब्रह्मन् तापत्रयचिकित्सितम् ।\nयदीश्वरे भगवति कर्म ब्रह्मणि भावितम्"
    },
    {
      "id": "bhagavatam-1-5-33",
      "sequence": 166,
      "chapter": 5,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.33",
      "original": "आमयो यश्च भूतानां जायते येन सुव्रत ।\nतदेव ह्यामयं द्रव्यं न पुनाति चिकित्सितम्"
    },
    {
      "id": "bhagavatam-1-5-34",
      "sequence": 167,
      "chapter": 5,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.34",
      "original": "एवं नृणां क्रियायोगाः सर्वे संसृतिहेतवः ।\nत एवात्मविनाशाय कल्पन्ते कल्पिताः परे"
    },
    {
      "id": "bhagavatam-1-5-35",
      "sequence": 168,
      "chapter": 5,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 05",
      "label": "1.5.35",
