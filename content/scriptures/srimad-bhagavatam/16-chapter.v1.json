    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-16-1",
      "sequence": 635,
      "chapter": 16,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.1",
      "original": "सूत उवाच\nततः परीक्षिद्द्विजवर्यशिक्षया महीं महाभागवतः शशास ह  ।\nयथा हि सूत्यामभिजातकोविदाः समादिशन् विप्र महद्गुणस्तथा"
    },
    {
      "id": "bhagavatam-1-16-2",
      "sequence": 636,
      "chapter": 16,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.2",
      "original": "स उत्तरस्य तनयामुपयेम इरावतीम्  ।\nजनमेजयादींश्चतुरस्तस्यामुत्पादयत्सुतान्"
    },
    {
      "id": "bhagavatam-1-16-3",
      "sequence": 637,
      "chapter": 16,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.3",
      "original": "आजहाराश्वमेधांस्त्रीन् गङ्गायां भूरिदक्षिणान्  ।\nशारद्वतं गुरुं कृत्वा देवा यत्राक्षिगोचराः"
    },
    {
      "id": "bhagavatam-1-16-4",
      "sequence": 638,
      "chapter": 16,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.4",
      "original": "निजग्राहौजसा वीरः कलिं दिग्विजये क्वचित् ।\nनृपलिङ्गधरं शूद्रं घ्नन्तं गोमिथुनं पदा"
    },
    {
      "id": "bhagavatam-1-16-5",
      "sequence": 639,
      "chapter": 16,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.5",
      "original": "शौनक उवाच\nकस्य हेतोर्निजग्राह कलिं दिग्विजये नृपः  ।\nनृदेवचिह्नधृक्शूद्र कोऽसौ गां यः पदाहनत् ।\nतत्कथ्यतां महाभाग यदि कृष्णकथाश्रयम्"
    },
    {
      "id": "bhagavatam-1-16-6",
      "sequence": 640,
      "chapter": 16,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.6",
      "original": "अथवास्य पदाम्भोज मकरन्दलिहां सताम्  ।\nकिमन्यैरसदालापैरायुषो यदसद्व्ययः"
    },
    {
      "id": "bhagavatam-1-16-7",
      "sequence": 641,
      "chapter": 16,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.7",
      "original": "क्षुद्रायुषां नृणामङ्ग मर्त्यानामृतमिच्छताम्  ।\nइहोपहूतो भगवान्मृत्युः शामित्रकर्मणि"
    },
    {
      "id": "bhagavatam-1-16-8",
      "sequence": 642,
      "chapter": 16,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.8",
      "original": "न कश्चिन्म्रियते तावद्यावदास्त इहान्तकः  ।\nएतदर्थं हि भगवानाहूतः परमर्षिभिः  ।\nअहो नृलोके पीयेत हरिलीलामृतं वचः"
    },
    {
      "id": "bhagavatam-1-16-9",
      "sequence": 643,
      "chapter": 16,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.9",
      "original": "मन्दस्य मन्दप्रज्ञस्य वयो मन्दायुषश्च वै  ।\nनिद्रया ह्रियते नक्तं दिवा च व्यर्थकर्मभिः"
    },
    {
      "id": "bhagavatam-1-16-10",
      "sequence": 644,
      "chapter": 16,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.10",
      "original": "सूत उवाच\nयदा परीक्षित्कुरुजाङ्गलेऽवसत्कलिं प्रविष्टं निजचक्रवर्तिते  ।\nनिशम्य वार्तामनतिप्रियां ततः शरासनं संयुगशौण्डिराददे"
    },
    {
      "id": "bhagavatam-1-16-11",
      "sequence": 645,
      "chapter": 16,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.11",
      "original": "स्वलङ्कृतं श्यामतुरङ्गयोजितं रथं मृगेन्द्रध्वजमाश्रितः पुरात् ।\nवृतो रथाश्वद्विपपत्तियुक्तया स्वसेनया दिग्विजयाय निर्गतः"
    },
    {
      "id": "bhagavatam-1-16-12",
      "sequence": 646,
      "chapter": 16,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.12",
      "original": "भद्राश्वं केतुमालं च भारतं चोत्तरान् कुरून्  ।\nकिम्पुरुषादीनि वर्षाणि विजित्य जगृहे बलिम्"
    },
    {
      "id": "bhagavatam-1-16-13",
      "sequence": 647,
      "chapter": 16,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.13",
      "original": "नगरांश्च वनांश्चैव नदीश्च विमलोदकाः  ।\nपुरुषान् देवकल्पांश्च नारीश्च प्रियदर्शनाः"
    },
    {
      "id": "bhagavatam-1-16-14",
      "sequence": 648,
      "chapter": 16,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.14",
      "original": "अदृष्टपूर्वान् सुभगान् स ददर्श धनञ्जयः  ।\nसदनानि च शुभ्राणि नारीश्चाप्सरसां निभाः"
    },
    {
      "id": "bhagavatam-1-16-15",
      "sequence": 649,
      "chapter": 16,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.15",
      "original": "तत्र तत्रोपशृण्वानः स्वपूर्वेषां महात्मनाम्  ।\nप्रगीयमाणं च यशः कृष्णमाहात्म्यसूचकम्"
    },
    {
      "id": "bhagavatam-1-16-16",
      "sequence": 650,
      "chapter": 16,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.16",
      "original": "आत्मानं च परित्रातमश्वत्थाम्नोऽस्त्रतेजसः  ।\nस्नेहं च वृष्णिपार्थानां तेषां भक्तिं च केशवे"
    },
    {
      "id": "bhagavatam-1-16-17",
      "sequence": 651,
      "chapter": 16,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.17",
      "original": "तेभ्यः परमसन्तुष्टः प्रीत्युज्जृम्भितलोचनः  ।\nमहाधनानि वासांसि ददौ हारान्महामनाः"
    },
    {
      "id": "bhagavatam-1-16-18",
      "sequence": 652,
      "chapter": 16,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.18",
      "original": "सारथ्यपारषदसेवनसख्यदौत्य   वीरासनानुगमनस्तवनप्रणामान्  ।\nस्निग्धेषु पाण्डुषु जगत्प्रणतिं च विष्णोर्  भक्तिं करोति नृपतिश्चरणारविन्दे"
    },
    {
      "id": "bhagavatam-1-16-19",
      "sequence": 653,
      "chapter": 16,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.19",
      "original": "*\nतस्यैवं वर्तमानस्य पूर्वेषां वृत्तिमन्वहम्  ।\nनातिदूरे किलाश्चर्यं यदासीत्तन्निबोध मे"
    },
    {
      "id": "bhagavatam-1-16-20",
      "sequence": 654,
      "chapter": 16,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.20",
      "original": "धर्मः पदैकेन चरन् विच्छायामुपलभ्य गाम्  ।\nपृच्छति स्माश्रुवदनां विवत्सामिव मातरम्"
    },
    {
      "id": "bhagavatam-1-16-21",
      "sequence": 655,
      "chapter": 16,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.21",
      "original": "धर्म उवाच\nकच्चिद्भद्रेऽनामयमात्मनस्ते विच्छायासि म्लायतेषन्मुखेन  ।\nआलक्षये भवतीमन्तराधिं दूरे बन्धुं शोचसि कञ्चनाम्ब"
    },
    {
      "id": "bhagavatam-1-16-22",
      "sequence": 656,
      "chapter": 16,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.22",
      "original": "पादैर्न्यूनं शोचसि मैकपादमात्मानं वा वृषलैर्भोक्ष्यमाणम्  ।\nआहो सुरादीन् हृतयज्ञभागान् प्रजा उत स्विन्मघवत्यवर्षति"
    },
    {
      "id": "bhagavatam-1-16-23",
      "sequence": 657,
      "chapter": 16,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.23",
      "original": "अरक्ष्यमाणाः स्त्रिय उर्वि बालान् शोचस्यथो पुरुषादैरिवार्तान्  ।\nवाचं देवीं ब्रह्मकुले कुकर्मण्यब्रह्मण्ये राजकुले कुलाग्र्यान्"
    },
    {
      "id": "bhagavatam-1-16-24",
      "sequence": 658,
      "chapter": 16,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.24",
      "original": "किं क्षत्रबन्धून् कलिनोपसृष्टान् राष्ट्राणि वा तैरवरोपितानि  ।\nइतस्ततो वाशनपानवासः स्नानव्यवायोन्मुखजीवलोकम्"
    },
    {
      "id": "bhagavatam-1-16-25",
      "sequence": 659,
      "chapter": 16,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.25",
      "original": "यद्वाम्ब ते भूरिभरावतार कृतावतारस्य हरेर्धरित्रि  ।\nअन्तर्हितस्य स्मरती विसृष्टा कर्माणि निर्वाणविलम्बितानि"
    },
    {
      "id": "bhagavatam-1-16-26",
      "sequence": 660,
      "chapter": 16,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.26",
      "original": "इदं ममाचक्ष्व तवाधिमूलं वसुन्धरे येन विकर्शितासि  ।\nकालेन वा ते बलिनां बलीयसा सुरार्चितं किं हृतमम्ब सौभगम्"
    },
    {
      "id": "bhagavatam-1-16-27",
      "sequence": 661,
      "chapter": 16,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.27",
      "original": "धरण्युवाच\nभवान् हि वेद तत्सर्वं यन्मां धर्मानुपृच्छसि  ।\nचतुर्भिर्वर्तसे येन पादैर्लोकसुखावहैः"
    },
    {
      "id": "bhagavatam-1-16-28",
      "sequence": 662,
      "chapter": 16,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.28",
      "original": "सत्यं शौचं दया क्षान्तिस्त्यागः सन्तोष आर्जवम्  ।\nशमो दमस्तपः साम्यं तितिक्षोपरतिः श्रुतम्"
    },
    {
      "id": "bhagavatam-1-16-29",
      "sequence": 663,
      "chapter": 16,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.29",
      "original": "ज्ञानं विरक्तिरैश्वर्यं शौर्यं तेजो बलं स्मृतिः  ।\nस्वातन्त्र्यं कौशलं कान्तिर्धैर्यं मार्दवमेव च"
    },
    {
      "id": "bhagavatam-1-16-30",
      "sequence": 664,
      "chapter": 16,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.30",
      "original": "प्रागल्भ्यं प्रश्रयः शीलं सह ओजो बलं भगः  ।\nगाम्भीर्यं स्थैर्यमास्तिक्यं कीर्तिर्मानोऽनहङ्कृतिः"
    },
    {
      "id": "bhagavatam-1-16-31",
      "sequence": 665,
      "chapter": 16,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.31",
      "original": "एते चान्ये च भगवन्नित्या यत्र महागुणाः  ।\nप्रार्थ्या महत्त्वमिच्छद्भिर्न वियन्ति स्म कर्हिचित्"
    },
    {
      "id": "bhagavatam-1-16-32",
      "sequence": 666,
      "chapter": 16,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.32",
      "original": "तेनाहं गुणपात्रेण श्रीनिवासेन साम्प्रतम्  ।\nशोचामि रहितं लोकं पाप्मना कलिनेक्षितम्"
    },
    {
      "id": "bhagavatam-1-16-33",
      "sequence": 667,
      "chapter": 16,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.33",
      "original": "आत्मानं चानुशोचामि भवन्तं चामरोत्तमम्  ।\nदेवान् पितॄनृषीन् साधून् सर्वान् वर्णांस्तथाश्रमान्"
    },
    {
      "id": "bhagavatam-1-16-34",
      "sequence": 668,
      "chapter": 16,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.34",
      "original": "ब्रह्मादयो बहुतिथं यदपाङ्गमोक्ष   कामास्तपः समचरन् भगवत्प्रपन्नाः  ।\nसा श्रीः स्ववासमरविन्दवनं विहाय   यत्पादसौभगमलं भजतेऽनुरक्ता"
    },
    {
      "id": "bhagavatam-1-16-35",
      "sequence": 669,
      "chapter": 16,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.35",
      "original": "*\nतस्याहमब्जकुलिशाङ्कुशकेतुकेतैः   श्रीमत्पदैर्भगवतः समलङ्कृताङ्गी  ।\nत्रीनत्यरोच उपलभ्य ततो विभूतिं   लोकान् स मां व्यसृजदुत्स्मयतीं तदन्ते"
    },
    {
      "id": "bhagavatam-1-16-36",
      "sequence": 670,
      "chapter": 16,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.36",
      "original": "*\nयो वै ममातिभरमासुरवंशराज्ञाम्   अक्षौहिणीशतमपानुददात्मतन्त्रः  ।\nत्वां दुःस्थमूनपदमात्मनि पौरुषेण   सम्पादयन् यदुषु रम्यमबिभ्रदङ्गम्"
    },
    {
      "id": "bhagavatam-1-16-37",
      "sequence": 671,
      "chapter": 16,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 16",
      "label": "1.16.37",
