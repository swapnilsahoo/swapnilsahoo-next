    "url": "https://sa.wikisource.org/w/index.php?title=%E0%A4%B6%E0%A5%8D%E0%A4%B0%E0%A5%80%E0%A4%AE%E0%A4%A6%E0%A5%8D%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%B5%E0%A4%A4%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D%2F%E0%A4%B8%E0%A5%8D%E0%A4%95%E0%A4%A8%E0%A5%8D%E0%A4%A7%E0%A4%83%20%E0%A5%A7%2F%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83%20%E0%A5%AF&oldid=330834",
    "license": "CC BY-SA 4.0",
    "licenseUrl": "https://creativecommons.org/licenses/by-sa/4.0/"
  },
  "entries": [
    {
      "id": "bhagavatam-1-9-1",
      "sequence": 322,
      "chapter": 9,
      "sourceIndex": 1,
      "verse": 1,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.1",
      "original": "सूत उवाच ।\nइति भीतः प्रजाद्रोहात् सर्वधर्मविवित्सया ।\nततो विनशनं प्रागाद् यत्र देवव्रतोऽपतत् ॥",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-9-2",
      "sequence": 323,
      "chapter": 9,
      "sourceIndex": 2,
      "verse": 2,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.2",
      "original": "तदा ते भ्रातरः सर्वे सदश्वैः स्वर्णभूषितैः ।\nअन्वगच्छन् रथैर्विप्रा व्यासधौम्यादयस्तथा ॥"
    },
    {
      "id": "bhagavatam-1-9-3",
      "sequence": 324,
      "chapter": 9,
      "sourceIndex": 3,
      "verse": 3,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.3",
      "original": "भगवानपि विप्रर्षे रथेन सधनञ्जयः ।\nस तैर्व्यरोचत नृपः कुबेर इव गुह्यकैः ॥"
    },
    {
      "id": "bhagavatam-1-9-4",
      "sequence": 325,
      "chapter": 9,
      "sourceIndex": 4,
      "verse": 4,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.4",
      "original": "दृष्ट्वा निपतितं भूमौ दिवश्च्युतं इवामरम् ।\nप्रणेमुः पाण्डवा भीष्मं सानुगाः सह चक्रिणा ॥"
    },
    {
      "id": "bhagavatam-1-9-5",
      "sequence": 326,
      "chapter": 9,
      "sourceIndex": 5,
      "verse": 5,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.5",
      "original": "तत्र ब्रह्मर्षयः सर्वे देवर्षयश्च सत्तम ।\nराजर्षयश्च तत्रासन् द्रष्टुं भरतपुङ्गवम् ॥"
    },
    {
      "id": "bhagavatam-1-9-6",
      "sequence": 327,
      "chapter": 9,
      "sourceIndex": 6,
      "verse": 6,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.6",
      "original": "पर्वतो नारदो धौम्यो भगवान् बादरायणः ।\nबृहदश्वो भरद्वाजः सशिष्यो रेणुकासुतः ॥"
    },
    {
      "id": "bhagavatam-1-9-7",
      "sequence": 328,
      "chapter": 9,
      "sourceIndex": 7,
      "verse": 7,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.7",
      "original": "वसिष्ठ इन्द्रप्रमदः त्रितो गृत्समदोऽसितः ।\nकक्षीवान् गौतमोऽत्रिश्च कौशिकोऽथ सुदर्शनः ॥"
    },
    {
      "id": "bhagavatam-1-9-8",
      "sequence": 329,
      "chapter": 9,
      "sourceIndex": 8,
      "verse": 8,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.8",
      "original": "अन्ये च मुनयो ब्रह्मन् ब्रह्मरातादयोऽमलाः ।\nशिष्यैरुपेता आजग्मुः कश्यपाङ्‌गिरसादयः ॥"
    },
    {
      "id": "bhagavatam-1-9-9",
      "sequence": 330,
      "chapter": 9,
      "sourceIndex": 9,
      "verse": 9,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.9",
      "original": "तान् समेतान् महाभागान् उपलभ्य वसूत्तमः ।\nपूजयामास धर्मज्ञो देशकालविभागवित्"
    },
    {
      "id": "bhagavatam-1-9-10",
      "sequence": 331,
      "chapter": 9,
      "sourceIndex": 10,
      "verse": 10,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.10",
      "original": "कृष्णं च तत्प्रभावज्ञ आसीनं जगदीश्वरम् ।\nहृदिस्थं पूजयामास माययोपात्त विग्रहम्"
    },
    {
      "id": "bhagavatam-1-9-11",
      "sequence": 332,
      "chapter": 9,
      "sourceIndex": 11,
      "verse": 11,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.11",
      "original": "पाण्डुपुत्रान् उपासीनान् प्रश्रयप्रेमसङ्गतान् ।\nअभ्याचष्टानुरागाश्रैः अन्धीभूतेन चक्षुषा"
    },
    {
      "id": "bhagavatam-1-9-12",
      "sequence": 333,
      "chapter": 9,
      "sourceIndex": 12,
      "verse": 12,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.12",
      "original": "अहो कष्टमहोऽन्याय्यं यद् यूयं धर्मनन्दनाः ।\nजीवितुं नार्हथ क्लिष्टं विप्रधर्माच्युताश्रयाः"
    },
    {
      "id": "bhagavatam-1-9-13",
      "sequence": 334,
      "chapter": 9,
      "sourceIndex": 13,
      "verse": 13,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.13",
      "original": "संस्थितेऽतिरथे पाण्डौ पृथा बालप्रजा वधूः ।\nयुष्मत्कृते बहून् क्लेशान् प्राप्ता तोकवती मुहुः"
    },
    {
      "id": "bhagavatam-1-9-14",
      "sequence": 335,
      "chapter": 9,
      "sourceIndex": 14,
      "verse": 14,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.14",
      "original": "सर्वं कालकृतं मन्ये भवतां च यदप्रियम् ।\nसपालो यद्वशे लोको वायोरिव घनावलिः"
    },
    {
      "id": "bhagavatam-1-9-15",
      "sequence": 336,
      "chapter": 9,
      "sourceIndex": 15,
      "verse": 15,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.15",
      "original": "यत्र धर्मसुतो राजा गदापाणिर्वृकोदरः ।\nकृष्णोऽस्त्री गाण्डिवं चापं सुहृत् कृष्णः ततो विपत्"
    },
    {
      "id": "bhagavatam-1-9-16",
      "sequence": 337,
      "chapter": 9,
      "sourceIndex": 16,
      "verse": 16,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.16",
      "original": "न ह्यस्य कर्हिचित् राजन् पुमान् वेद विधित्सितम् ।\nयत् विजिज्ञासया युक्ता मुह्यन्ति कवयोऽपि हि"
    },
    {
      "id": "bhagavatam-1-9-17",
      "sequence": 338,
      "chapter": 9,
      "sourceIndex": 17,
      "verse": 17,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.17",
      "original": "तस्मात् इदं दैवतंत्रं व्यवस्य भरतर्षभ ।\nतस्यानुविहितोऽनाथा नाथ पाहि प्रजाः प्रभो"
    },
    {
      "id": "bhagavatam-1-9-18",
      "sequence": 339,
      "chapter": 9,
      "sourceIndex": 18,
      "verse": 18,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.18",
      "original": "एष वै भगवान् साक्षात् आद्यो नारायणः पुमान् ।\nमोहयन् मायया लोकं गूढश्चरति वृष्णिषु"
    },
    {
      "id": "bhagavatam-1-9-19",
      "sequence": 340,
      "chapter": 9,
      "sourceIndex": 19,
      "verse": 19,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.19",
      "original": "अस्यानुभावं भगवान् वेद गुह्यतमं शिवः ।\nदेवर्षिर्नारदः साक्षात् भगवान् कपिलो नृप"
    },
    {
      "id": "bhagavatam-1-9-20",
      "sequence": 341,
      "chapter": 9,
      "sourceIndex": 20,
      "verse": 20,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.20",
      "original": "यं मन्यसे मातुलेयं प्रियं मित्रं सुहृत्तमम् ।\nअकरोः सचिवं दूतं सौहृदादथ सारथिम्"
    },
    {
      "id": "bhagavatam-1-9-21",
      "sequence": 342,
      "chapter": 9,
      "sourceIndex": 21,
      "verse": 21,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.21",
      "original": "सर्वात्मनः समदृशो ह्यद्वयस्यानहङ्कृतेः ।\nतत्कृतं मतिवैषम्यं निरवद्यस्य न क्वचित्"
    },
    {
      "id": "bhagavatam-1-9-22",
      "sequence": 343,
      "chapter": 9,
      "sourceIndex": 22,
      "verse": 22,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.22",
      "original": "तथाप्येकान्तभक्तेषु पश्य भूपानुकम्पितम् ।\nयत् मे असून् त्यजतः साक्षात् कृष्णो दर्शनमागतः"
    },
    {
      "id": "bhagavatam-1-9-23",
      "sequence": 344,
      "chapter": 9,
      "sourceIndex": 23,
      "verse": 23,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.23",
      "original": "भक्त्यावेश्य मनो यस्मिन् वाचा यन्नाम कीर्तयन् ।\nत्यजन् कलेवरं योगी मुच्यते कामकर्मभिः"
    },
    {
      "id": "bhagavatam-1-9-24",
      "sequence": 345,
      "chapter": 9,
      "sourceIndex": 24,
      "verse": 24,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.24",
      "original": "स देवदेवो भगवान् प्रतीक्षतां\nकलेवरं यावदिदं हिनोम्यहम् ।\nप्रसन्नहासारुणलोचनोल्लसन्\nमुखाम्बुजो ध्यानपथश्चतुर्भुजः",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-9-25",
      "sequence": 346,
      "chapter": 9,
      "sourceIndex": 25,
      "verse": 25,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.25",
      "original": "सूत उवाच ।\nयुधिष्ठिरः तत् आकर्ण्य शयानं शरपञ्जरे ।\nअपृच्छत् विविधान् धर्मान् ऋषीणां चानुश्रृण्वताम्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-9-26",
      "sequence": 347,
      "chapter": 9,
      "sourceIndex": 26,
      "verse": 26,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.26",
      "original": "पुरुषस्वभावविहितान् यथावर्णं यथाश्रमम् ।\nवैराग्यरागोपाधिभ्यां आम्नातोभयलक्षणान्"
    },
    {
      "id": "bhagavatam-1-9-27",
      "sequence": 348,
      "chapter": 9,
      "sourceIndex": 27,
      "verse": 27,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.27",
      "original": "दानधर्मान् राजधर्मान् मोक्षधर्मान् विभागशः ।\nस्त्रीधर्मान् भगवद्धर्मान् समासव्यास योगतः"
    },
    {
      "id": "bhagavatam-1-9-28",
      "sequence": 349,
      "chapter": 9,
      "sourceIndex": 28,
      "verse": 28,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.28",
      "original": "धर्मार्थकाममोक्षांश्च सहोपायान् यथा मुने ।\nनानाख्यानेतिहासेषु वर्णयामास तत्त्ववित्"
    },
    {
      "id": "bhagavatam-1-9-29",
      "sequence": 350,
      "chapter": 9,
      "sourceIndex": 29,
      "verse": 29,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.29",
      "original": "धर्मं प्रवदतस्तस्य स कालः प्रत्युपस्थितः ।\nयो योगिनः छन्दमृत्योः वाञ्छितस्तु उत्तरायणः"
    },
    {
      "id": "bhagavatam-1-9-30",
      "sequence": 351,
      "chapter": 9,
      "sourceIndex": 30,
      "verse": 30,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.30",
      "original": "तदोपसंहृत्य गिरः सहस्रणीः\nविमुक्तसङ्गं मन आदिपूरुषे ।\nकृष्णे लसत्पीतपटे चतुर्भुजे\nपुरः स्थितेऽमीलित दृग् व्यधारयत्",
      "meter": "वंशस्थ"
    },
    {
      "id": "bhagavatam-1-9-31",
      "sequence": 352,
      "chapter": 9,
      "sourceIndex": 31,
      "verse": 31,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.31",
      "original": "विशुद्धया धारणया हताशुभः\nतदीक्षयैवाशु गतायुधश्रमः ।\nनिवृत्त सर्वेन्द्रिय वृत्ति विभ्रमः\nतुष्टाव जन्यं विसृजन् जनार्दनम्"
    },
    {
      "id": "bhagavatam-1-9-32",
      "sequence": 353,
      "chapter": 9,
      "sourceIndex": 32,
      "verse": 32,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.32",
      "original": "श्रीभीष्म उवाच ।\nइति मतिरुपकल्पिता वितृष्णा\nभगवति सात्वतपुङ्गवे विभूम्नि ।\nस्वसुखमुपगते क्वचित् विहर्तुं\nप्रकृतिमुपेयुषि यद्‍भवप्रवाहः",
      "meter": "पुष्पिताग्रा"
    },
    {
      "id": "bhagavatam-1-9-33",
      "sequence": 354,
      "chapter": 9,
      "sourceIndex": 33,
      "verse": 33,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.33",
      "original": "त्रिभुवनकमनं तमालवर्णं\nरविकरगौरवराम्बरं दधाने ।\nवपुरलककुलावृत आननाब्जं\nविजयसखे रतिरस्तु मेऽनवद्या"
    },
    {
      "id": "bhagavatam-1-9-34",
      "sequence": 355,
      "chapter": 9,
      "sourceIndex": 34,
      "verse": 34,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.34",
      "original": "युधि तुरगरजो विधूम्र विष्वक्\nकचलुलितश्रमवारि अलङ्कृतास्ये ।\nमम निशितशरैर्विभिद्यमान\nत्वचि विलसत्कवचेऽस्तु कृष्ण आत्मा"
    },
    {
      "id": "bhagavatam-1-9-35",
      "sequence": 356,
      "chapter": 9,
      "sourceIndex": 35,
      "verse": 35,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.35",
      "original": "सपदि सखिवचो निशम्य मध्ये\nनिजपरयोर्बलयो रथं निवेश्य ।\nस्थितवति परसैनिकायुरक्ष्णा\nहृतवति पार्थसखे रतिर्ममास्तु"
    },
    {
      "id": "bhagavatam-1-9-36",
      "sequence": 357,
      "chapter": 9,
      "sourceIndex": 36,
      "verse": 36,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.36",
      "original": "व्यवहित पृतनामुखं निरीक्ष्य\nस्वजनवधात् विमुखस्य दोषबुद्ध्या ।\nकुमतिम अहरत् आत्मविद्यया यः\nचश्चरणरतिः परमस्य तस्य मेऽस्तु"
    },
    {
      "id": "bhagavatam-1-9-37",
      "sequence": 358,
      "chapter": 9,
      "sourceIndex": 37,
      "verse": 37,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.37",
      "original": "स्वनिगममपहाय मत्प्रतिज्ञां\nऋतमधि कर्तुमवप्लुतो रथस्थः ।\nधृतरथ चरणोऽभ्ययात् चलद्‍गुः\nहरिरिव हन्तुमिभं गतोत्तरीयः"
    },
    {
      "id": "bhagavatam-1-9-38",
      "sequence": 359,
      "chapter": 9,
      "sourceIndex": 38,
      "verse": 38,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.38",
      "original": "शितविशिखहतो विशीर्णदंशः\nक्षतजपरिप्लुत आततायिनो मे ।\nप्रसभं अभिससार मद्वधार्थं\nस भवतु मे भगवान् गतिर्मुकुन्दः"
    },
    {
      "id": "bhagavatam-1-9-39",
      "sequence": 360,
      "chapter": 9,
      "sourceIndex": 39,
      "verse": 39,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.39",
      "original": "विजयरथकुटुम्ब आत्ततोत्रे\nधृतहयरश्मिनि तत् श्रियेक्षणीये ।\nभगवति रतिरस्तु मे मुमूर्षोः\nयमिह निरीक्ष्य हता गताः स्वरूपम्"
    },
    {
      "id": "bhagavatam-1-9-40",
      "sequence": 361,
      "chapter": 9,
      "sourceIndex": 40,
      "verse": 40,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.40",
      "original": "ललित गति विलास वल्गुहास\nप्रणय निरीक्षण कल्पितोरुमानाः ।\nकृतमनुकृतवत्य उन्मदान्धाः\nप्रकृतिमगन् किल यस्य गोपवध्वः"
    },
    {
      "id": "bhagavatam-1-9-41",
      "sequence": 362,
      "chapter": 9,
      "sourceIndex": 41,
      "verse": 41,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.41",
      "original": "मुनिगण नृपवर्यसङ्कुलेऽन्तः\nसदसि युधिष्ठिर राजसूय एषाम् ।\nअर्हणं उपपेद ईक्षणीयो\nमम दृशिगोचर एष आविरात्मा"
    },
    {
      "id": "bhagavatam-1-9-42",
      "sequence": 363,
      "chapter": 9,
      "sourceIndex": 42,
      "verse": 42,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.42",
      "original": "तमिममहमजं शरीरभाजां\nहृदि हृदि धिष्ठितमात्म कल्पितानाम् ।\nप्रतिदृशमिव नैकधार्कमेकं\nसमधिगतोऽस्मि विधूत भेदमोहः"
    },
    {
      "id": "bhagavatam-1-9-43",
      "sequence": 364,
      "chapter": 9,
      "sourceIndex": 43,
      "verse": 43,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.43",
      "original": "सूत उवाच ।\nकृष्ण एवं भगवति मनोवाक् दृष्टिवृत्तिभिः ।\nआत्मनि आत्मानमावेश्य सोऽन्तःश्वास उपारमत्",
      "meter": "अनुष्टुप्"
    },
    {
      "id": "bhagavatam-1-9-44",
      "sequence": 365,
      "chapter": 9,
      "sourceIndex": 44,
      "verse": 44,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.44",
      "original": "सम्पद्यमानमाज्ञाय भीष्मं ब्रह्मणि निष्कले ।\nसर्वे बभूवुस्ते तूष्णीं वयांसीव दिनात्यये"
    },
    {
      "id": "bhagavatam-1-9-45",
      "sequence": 366,
      "chapter": 9,
      "sourceIndex": 45,
      "verse": 45,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.45",
      "original": "तत्र दुन्दुभयो नेदुः देवमानव वादिताः ।\nशशंसुः साधवो राज्ञां खात्पेतुः पुष्पवृष्टयः"
    },
    {
      "id": "bhagavatam-1-9-46",
      "sequence": 367,
      "chapter": 9,
      "sourceIndex": 46,
      "verse": 46,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.46",
      "original": "तस्य निर्हरणादीनि सम्परेतस्य भार्गव ।\nयुधिष्ठिरः कारयित्वा मुहूर्तं दुःखितोऽभवत्"
    },
    {
      "id": "bhagavatam-1-9-47",
      "sequence": 368,
      "chapter": 9,
      "sourceIndex": 47,
      "verse": 47,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.47",
      "original": "तुष्टुवुर्मुनयो हृष्टाः कृष्णं तत् गुह्यनामभिः ।\nततस्ते कृष्णहृदयाः स्वाश्रमान्प्रययुः पुनः"
    },
    {
      "id": "bhagavatam-1-9-48",
      "sequence": 369,
      "chapter": 9,
      "sourceIndex": 48,
      "verse": 48,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.48",
      "original": "ततो युधिष्ठिरो गत्वा सहकृष्णो गजाह्वयम् ।\nपितरं सान्त्वयामास गान्धारीं च तपस्विनीम्"
    },
    {
      "id": "bhagavatam-1-9-49",
      "sequence": 370,
      "chapter": 9,
      "sourceIndex": 49,
      "verse": 49,
      "section": "Skandha 1, Chapter 09",
      "label": "1.9.49",
      "original": "पित्रा चानुमतो राजा वासुदेवानुमोदितः ।\nचकार राज्यं धर्मेण पितृपैतामहं विभुः"
    }
  ]
}
