{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.swapnilsahoo.com/schemas/ramcharitmanas-word-study-shard.v1.json",
  "title": "Ramcharitmanas word-study shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kanda", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "ramcharitmanas-word-study-shard-v1"
    },
    "kanda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "slug"],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "slug": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "sequence", "meaning", "lines"],
        "properties": {
          "entryId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1113
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line", "words"],
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "words": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "string",
                            "minLength": 1
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["original", "meaning"],
                        "properties": {
                          "original": {
                            "type": "string",
                            "minLength": 1
                          },
                          "meaning": {
                            "type": "string",
                            "minLength": 1
                          },
                          "language": {
                            "enum": ["awa", "sa"]
                          },
                          "lemma": {
                            "type": "string",
                            "minLength": 1
                          },
                          "grammar": {
                            "type": "string",
                            "minLength": 1
                          },
                          "confidence": {
                            "enum": ["high", "medium", "low"]
                          },
                          "alternatives": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "sourceRef": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reviewStatus": {
                            "enum": ["editorial-under-review", "source-compared"]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
