    },
    {
      "entryId": "ramcharitmanas-opening-bala-kanda-004",
      "sequence": 4,
      "meaning": "I revere the lord of poets and the lord of monkeys—Vālmīki and Hanumān—whose insight is wholly pure and who roam the sacred forest formed by the host of Sītā and Rāma's virtues.",
      "sourceRef": "Belvedere Press 1925 facsimile, scan page 53",
      "sourceUrl": "https://archive.org/details/in.ernet.dli.2015.342236/page/n52/mode/1up",
      "note": "Original close English rendering from the pinned Devanagari witness; editorial work awaiting independent review.",
      "lines": [
        {
          "line": 1,
          "words": [
            [
              "सीतारामगुणग्रामपुण्यारण्यविहारिणौ",
              "the two who roam the sacred forest of the host of Sītā and Rāma's virtues"
            ]
          ]
        },
        {
          "line": 2,
          "words": [
            [
              "वन्दे",
              "I revere"
            ],
            [
              "विशुद्धविज्ञानौ",
              "the two of wholly pure insight"
            ],
            [
              "कवीश्वरकपीश्वरौ",
              "the lord of poets and the lord of monkeys"
            ]
          ]
        }
      ]
    },
    {
      "entryId": "ramcharitmanas-opening-bala-kanda-005",
      "sequence": 5,
      "meaning": "I bow to Sītā, Rāma's beloved, who brings about creation, continuance and dissolution, removes affliction, and brings every highest good.",
      "sourceRef": "Belvedere Press 1925 facsimile, scan page 53",
      "sourceUrl": "https://archive.org/details/in.ernet.dli.2015.342236/page/n52/mode/1up",
      "note": "Original close English rendering from the pinned Devanagari witness; editorial work awaiting independent review.",
      "lines": [
        {
          "line": 1,
          "words": [
            [
              "उद्भवस्थितिसंहारकारिणीं",
              "her who brings about creation, continuance and dissolution"
            ],
            [
              "क्लेशहारिणीम्",
              "her who removes affliction"
            ]
          ]
        },
        {
          "line": 2,
          "words": [
