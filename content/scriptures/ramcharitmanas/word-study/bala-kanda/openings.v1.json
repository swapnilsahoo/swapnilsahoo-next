    },
    {
      "entryId": "ramcharitmanas-opening-bala-kanda-002",
      "sequence": 2,
      "meaning": "I revere Bhavānī and Śaṅkara, embodiments of faith and trust; without those two, even the accomplished do not behold the Lord dwelling within their own hearts.",
      "sourceRef": "Belvedere Press 1925 facsimile, scan page 52",
      "sourceUrl": "https://archive.org/details/in.ernet.dli.2015.342236/page/n51/mode/1up",
      "note": "Original close English rendering from the pinned Devanagari witness; editorial work awaiting independent review.",
      "lines": [
        {
          "line": 1,
          "words": [
            [
              "भवानीशङ्करौ",
              "Bhavānī and Śaṅkara"
            ],
            [
              "वन्दे",
              "I revere"
            ],
            [
              "श्रद्धाविश्वासरूपिणौ",
              "the two who embody faith and trust"
            ]
