  "entries": [
    {
      "entryId": "ramcharitmanas-opening-bala-kanda-001",
      "sequence": 1,
      "meaning": "I revere Vāṇī and Vināyaka, the two makers of phonemes and their gathered meanings, of aesthetic sentiments and even of metres, and of all auspicious beginnings.",
      "sourceRef": "Belvedere Press 1925 facsimile, scan page 52",
      "sourceUrl": "https://archive.org/details/in.ernet.dli.2015.342236/page/n51/mode/1up",
      "note": "Original close English rendering from the pinned Devanagari witness; editorial work awaiting independent review.",
      "lines": [
        {
          "line": 1,
          "words": [
            [
              "वर्णानामर्थसंघानां",
              "of phonemes and their gathered meanings"
            ],
            [
              "रसानां",
              "of aesthetic sentiments"
            ],
            [
              "छन्दसामपि",
              "and even of metres"
            ]
          ]
        },
        {
          "line": 2,
          "words": [
