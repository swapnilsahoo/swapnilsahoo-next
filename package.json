{
  "name": "swapnilsahoo-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-media-provenance.mjs && node scripts/check-teaching-lessons.mjs && node scripts/check-one-year-course.mjs && node scripts/check-scripture-corpora.mjs && node scripts/check-guesstimates.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:media": "node scripts/check-media-provenance.mjs",
    "check:lessons": "node scripts/check-teaching-lessons.mjs",
    "check:course": "node scripts/check-one-year-course.mjs",
    "lab:setup": "node --conditions=react-server --import tsx scripts/learning-lab.mts init",
    "lab:admin": "node --conditions=react-server --import tsx scripts/learning-lab.mts admin",
    "lab:demo": "node --conditions=react-server --import tsx scripts/learning-lab.mts demo",
    "lab:backup": "node --conditions=react-server --import tsx scripts/learning-lab.mts backup",
    "lab:purge": "node --conditions=react-server --import tsx scripts/learning-lab.mts purge",
    "lab:restore": "node --conditions=react-server --import tsx scripts/learning-lab.mts restore",
    "lab:test": "node --conditions=react-server --import tsx scripts/test-learning-lab.mts",
    "lab:test:backup": "node --conditions=react-server --import tsx scripts/test-learning-lab-backup.mts",
    "lab:test:browser": "node --import tsx scripts/test-learning-lab-browser.mjs",
    "lab:test:workspace": "node scripts/test-learning-lab-workspace.mjs",
    "lab:test:availability": "node --conditions=react-server --import tsx scripts/test-learning-lab-availability.mts",
    "lab:test:pilot-details": "node --conditions=react-server --import tsx scripts/test-learning-lab-pilot-details.mts",
    "lab:test:free-courses": "node --import tsx scripts/test-learning-lab-free-courses.mjs",
    "lab:test:unconfigured": "node scripts/test-learning-lab-unconfigured.mjs",
    "lab:preview": "node scripts/learning-lab-preview.mjs",
    "check:scriptures": "node scripts/check-scripture-corpora.mjs",
    "check:scriptures:partial": "node scripts/check-scripture-corpora.mjs --allow-partial-manas",
    "scaffold:manas-word-study": "node scripts/scaffold-ramcharitmanas-word-study.mjs",
    "manifest:manas-word-study": "node scripts/build-ramcharitmanas-word-study-manifest.mjs",
    "test:smoke": "playwright test release-smoke.spec.mjs --reporter=line --workers=1",
    "check": "eslint && tsc --noEmit && node scripts/check-media-provenance.mjs && node scripts/check-teaching-lessons.mjs && node scripts/check-one-year-course.mjs && node scripts/check-scripture-corpora.mjs && node scripts/check-guesstimates.mjs",
    "check:guesstimates": "node scripts/check-guesstimates.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@indic-transliteration/sanscript": "1.3.3",
    "@libsql/client": "0.18.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "1.55.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
